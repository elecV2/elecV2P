<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
  <title>OpenCode.efh By elecV2</title>
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/vue@3/dist/vue.global.prod.js"></script>
  <style>
    :root {
      --bk: #0d1117; --bk2: #161b22; --bk3: #1c2128;
      --fc: #e6edf3; --fc2: #7d8590; --fc3: #484f58;
      --ac: #58a6ff; --ok: #3fb950; --del: #f85149;
      --bd: #30363d; --code-bk: #0d1117;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font: 14px/1.6 -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--bk); color: var(--fc); height: 100vh;
      display: flex; flex-direction: column;
    }
    #app { flex: 1; display: flex; flex-direction: column; min-height: 0; }
    .header {
      display: flex; align-items: center; gap: 10px; padding: 10px 16px; position: relative;
      background: var(--bk2); border-bottom: 1px solid var(--bd); flex-shrink: 0;
    }
    .header h1 { font-size: 16px; color: var(--ac); white-space: nowrap; cursor: pointer; }
    .header h1:hover { opacity: .8; }
    .header .spacer { flex: 1; }
    .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); display: inline-block; }
    .dot.run { background: var(--ac); animation: pulse 1s infinite; }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.3} }
    .header button {
      padding: 4px 10px; border-radius: 6px; border: 1px solid var(--bd);
      background: var(--bk3); color: var(--fc2); font-size: 12px; cursor: pointer;
    }
    .header button:hover { color: var(--fc); border-color: var(--fc3); }
    .header .dropdown-trigger { font-size: 12px; color: var(--fc2); cursor: pointer; position: relative; white-space: nowrap; }
    .header .dropdown-trigger b { color: var(--ok); }
    .header .dropdown-trigger:hover b { text-decoration: underline; }
    .header .dropdown-trigger .arr { font-size: 8px; margin-left: 2px; }
    .header .dropdown-trigger + .dropdown-trigger { margin-left: 24px; }
    .header .ver { font-size: 10px; color: var(--fc3); margin-left: 4px; white-space: nowrap; }
    .ctx {
      display: inline-flex; align-items: center; gap: 6px;
      margin-right: 12px; font-size: 11px; color: var(--fc2); white-space: nowrap;
      cursor: default; border: 1px solid var(--bd); border-radius: 8px; padding: 2px 8px;
      background: var(--bk3);
    }
    .ctx-bar { width: 56px; height: 5px; border-radius: 3px; background: var(--bd); overflow: hidden; }
    .ctx-bar i { display: block; height: 100%; background: var(--ac); border-radius: 3px; }
    .ctx-bar.warn i { background: #e3b341; }
    .ctx-bar.danger i { background: var(--del); }
    .ctx-num { font-family: 'Cascadia Code', Consolas, monospace; }
    .header .load { position: absolute; left: 50%; transform: translateX(-50%); font-size: 22px; color: var(--ac); letter-spacing: 4px; animation: loadPulse 1.2s ease-in-out infinite; }
    @keyframes loadPulse { 0%,100% { opacity: .25; } 50% { opacity: 1; } }
    #modelDropdown { left: auto; right: 0; }
    .dropdown {
      position: absolute; top: 100%; left: 0; margin-top: 4px;
      background: var(--bk2); border: 1px solid var(--bd); border-radius: 8px;
      min-width: 260px; max-height: 350px; overflow-y: auto; z-index: 200;
      box-shadow: 0 8px 24px rgba(0,0,0,.4); display: none;
    }
    .dropdown.show { display: block; }
    .dropdown .d-item {
      padding: 7px 12px; cursor: pointer; border-bottom: 1px solid var(--bd);
      transition: background .15s;
    }
    .dropdown .d-item:last-child { border-bottom: none; }
    .dropdown .d-item:hover { background: var(--bk3); }
    .dropdown .d-item.active { background: var(--bk3); border-left: 3px solid var(--ac); }
    .dropdown .d-item .d-title { font-size: 13px; color: var(--fc); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .dropdown .d-item .d-sub { font-size: 10px; color: var(--fc3); }
    .dropdown .d-empty { padding: 20px; text-align: center; color: var(--fc3); font-size: 12px; }
    .dropdown .d-more { padding: 8px 12px; text-align: center; font-size: 12px; color: var(--ac); cursor: pointer; border-top: 1px solid var(--bd); }
    .dropdown .d-more:hover { background: var(--bk3); }
    .messages { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 12px; }
    .welcome { color: var(--fc2); text-align: center; margin: auto; font-size: 15px; line-height: 2; }
    .welcome b { color: var(--ac); }
    .msg-loading {
      color: var(--fc2); text-align: center; margin: auto; font-size: 14px;
      display: flex; flex-direction: column; align-items: center; gap: 10px;
    }
    .msg-loading .spin {
      width: 26px; height: 26px; border: 3px solid var(--bd);
      border-top-color: var(--ac); border-radius: 50%;
      animation: installSpin .8s linear infinite;
    }
    .msg { max-width: 85%; padding: 10px 14px; border-radius: 10px; line-height: 1.7; word-break: break-word; font-size: 14px; }
    .msg.user { align-self: flex-end; background: var(--ac); color: #000; border-bottom-right-radius: 2px; }
    .msg.assistant { align-self: flex-start; background: var(--bk2); border: 1px solid var(--bd); border-bottom-left-radius: 2px; }
    .msg.error { align-self: flex-start; background: #2d1215; border: 1px solid #5b2a2e; color: var(--del); }
    .msg .meta { font-size: 11px; color: var(--fc3); margin-top: 8px; border-top: 1px solid var(--bd); padding-top: 6px; }
    .msg.user .meta { color: rgba(0,0,0,.4); }
    .msg.assistant p { margin: .4em 0; }
    .msg.assistant p:first-child { margin-top: 0; }
    .msg.assistant p:last-child { margin-bottom: 0; }
    .msg.assistant ul, .msg.assistant ol { padding-left: 1.5em; margin: .4em 0; }
    .msg.assistant blockquote { border-left: 3px solid var(--bd); padding-left: 10px; color: var(--fc2); margin: .5em 0; }
    .msg.assistant h1, .msg.assistant h2, .msg.assistant h3, .msg.assistant h4 { margin: .6em 0 .3em; line-height: 1.3; }
    .msg.assistant h1 { font-size: 1.3em; } .msg.assistant h2 { font-size: 1.15em; } .msg.assistant h3 { font-size: 1.05em; }
    .msg.assistant table { border-collapse: collapse; margin: .5em 0; width: 100%; }
    .msg.assistant th, .msg.assistant td { border: 1px solid var(--bd); padding: 4px 8px; font-size: 13px; }
    .msg.assistant th { background: var(--bk3); }
    .msg.assistant a { color: var(--ac); text-decoration: none; }
    .msg.assistant a:hover { text-decoration: underline; }
    .msg.assistant hr { border: none; border-top: 1px solid var(--bd); margin: .6em 0; }
    .msg.assistant img { max-width: 100%; border-radius: 6px; }
    .msg.assistant code { font-family: 'Cascadia Code','Fira Code','Consolas',monospace; font-size: 13px; }
    .msg.assistant :not(pre) > code { background: var(--bk3); padding: 1px 5px; border-radius: 4px; }
    .msg.assistant pre {
      background: var(--code-bk); padding: 12px; border-radius: 6px; overflow-x: auto;
      margin: .5em 0; border: 1px solid var(--bd); position: relative;
    }
    .msg.assistant pre code { background: none; padding: 0; font-size: 13px; line-height: 1.5; }
    .msg.assistant .code-lang {
      position: absolute; top: 4px; right: 8px; font-size: 11px; color: var(--fc3);
      pointer-events: none; text-transform: uppercase;
    }
    .msg .ref {
      font-size: 12px; color: var(--fc); border-left: 2px solid var(--ac);
      padding: 2px 0 2px 10px; margin: 3px 0;
      font-family: 'Cascadia Code','Fira Code','Consolas','Courier New',monospace;
      line-height: 1.6; background: rgba(255,255,255,.04);
    }
    .msg .ref.tool { border-left-color: #f0b; }
    .msg .ref.cmd { border-left-color: #0c8; }
    .msg .ref.info { border-left-color: #4af; }
    .msg .ref.edit { border-left-color: #f80; }
    .msg .ref.act { border-left-color: #fd0; }
    .msg .ref.reasoning { border-left-color: #a78bfa; font-style: italic; }
    .msg .ref.question { border-left-color: #fa0; white-space: pre-wrap; }
    .msg .ref.permission { border-left-color: #e94; white-space: pre-wrap; }
    .msg .ref.answer { border-left-color: #0c8; white-space: pre-wrap; }
    .msg .tool-out {
      font-size: 12px; color: var(--fc2); white-space: pre-wrap; word-break: break-all;
      font-family: 'Cascadia Code','Fira Code','Consolas','Courier New',monospace;
      background: rgba(255,255,255,.03); border: 1px solid var(--bd); border-radius: 6px;
      padding: 6px 10px; margin: 4px 0; line-height: 1.5; max-height: 260px; overflow-y: auto;
    }
    .msg .stream-text { white-space: pre-wrap; word-break: break-word; line-height: 1.7; }
    .cursor { display: inline-block; width: 7px; height: 16px; background: var(--ac); animation: blink .7s infinite; vertical-align: text-bottom; margin-left: 2px; }
    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }
    .reasoning { margin-bottom: 8px; }
    .reasoning summary {
      font-size: 12px; color: var(--fc2); cursor: pointer; user-select: none;
      padding: 2px 0; list-style: none; display: flex; align-items: center; gap: 4px;
    }
    .reasoning[open] summary { padding-bottom: 4px; }
    .reasoning summary::before { content: '> '; color: var(--fc3); font-family: monospace; }
    .reasoning[open] summary::before { content: 'v '; }
    .reasoning-body {
      font-size: 12px; color: var(--fc2); background: var(--bk3);
      padding: 8px 10px; border-radius: 6px; margin-top: 4px; line-height: 1.5;
      white-space: pre-wrap; font-family: 'Cascadia Code','Fira Code','Consolas',monospace;
      max-height: 300px; overflow-y: auto;
    }
    .overlay {
      position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 99;
      opacity: 0; pointer-events: none; transition: opacity .25s;
    }
    .overlay.show { opacity: 1; pointer-events: auto; }
    .session-panel {
      position: fixed; left: -320px; top: 0; bottom: 0; width: 300px;
      background: var(--bk2); border-right: 1px solid var(--bd);
      transition: left .25s; z-index: 100; display: flex; flex-direction: column;
    }
    .session-panel.open { left: 0; }
    .session-panel-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 12px 16px; border-bottom: 1px solid var(--bd); flex-shrink: 0;
    }
    .session-panel-header span { font-weight: bold; color: var(--ac); font-size: 15px; }
    .session-panel-header button {
      background: none; border: none; color: var(--fc2); cursor: pointer;
      font-size: 18px; padding: 2px 6px; border-radius: 4px;
    }
    .session-panel-header button:hover { background: var(--bk3); color: var(--fc); }
    .session-list { flex: 1; overflow-y: auto; padding: 8px; }
    .session-item {
      padding: 10px 12px; border-radius: 8px; cursor: pointer; margin-bottom: 4px;
      border: 1px solid transparent; transition: all .15s; position: relative;
    }
    .session-item:hover { background: var(--bk3); border-color: var(--bd); }
    .session-item.active { background: var(--bk3); border-color: var(--ac); }
    .session-item .s-time { font-size: 11px; color: var(--fc3); }
    .session-item .s-prompt { font-size: 13px; color: var(--fc); margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .session-item .s-preview { font-size: 12px; color: var(--fc2); margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .session-item .s-del {
      position: absolute; top: 8px; right: 8px; font-size: 11px; color: var(--fc3);
      cursor: pointer; opacity: 0; padding: 2px 6px; border-radius: 4px; transition: all .15s;
    }
    .session-item:hover .s-del { opacity: 1; }
    .session-item .s-del:hover { background: var(--del); color: #fff; }
    .session-empty {
      text-align: center; color: var(--fc3); padding: 40px 20px; font-size: 13px;
    }
    .section-label {
      font-size: 11px; color: var(--fc3); padding: 4px 12px 2px; margin-top: 4px;
    }
    .input-bar {
      display: flex; gap: 8px; padding: 12px 16px;
      background: var(--bk2); border-top: 1px solid var(--bd); flex-shrink: 0;
    }
    .input-bar textarea {
      flex: 1; padding: 10px 14px; border-radius: 8px; border: 1px solid var(--bd);
      background: var(--bk3); color: var(--fc); font-family: inherit; font-size: 14px;
      resize: none; outline: none; min-height: 42px; max-height: 160px;
    }
    .input-bar textarea::placeholder { color: var(--fc3); }
    .input-bar textarea:focus { border-color: var(--ac); }
    .input-bar button {
      padding: 0 18px; border: none; border-radius: 8px;
      background: var(--ac); color: #000; font-weight: bold; font-size: 14px;
      cursor: pointer; flex-shrink: 0;
    }
    .input-bar button:disabled { opacity: .4; cursor: not-allowed; }
    .cmd-wrap { position: relative; flex-shrink: 0; }
    .cmd-dropdown {
      position: absolute; left: 16px; right: 16px; bottom: calc(100% + 4px);
      background: var(--bk2); border: 1px solid var(--bd); border-radius: 10px;
      box-shadow: 0 6px 24px rgba(0,0,0,.35); max-height: 220px; overflow-y: auto; z-index: 50;
    }
    .cmd-item {
      display: flex; align-items: baseline; gap: 8px; padding: 8px 12px; cursor: pointer;
    }
    .cmd-item + .cmd-item { border-top: 1px solid var(--bd); }
    .cmd-item.active, .cmd-item:hover { background: var(--bk3); }
    .cmd-item .name { color: var(--ac); font-weight: bold; font-family: monospace; flex-shrink: 0; }
    .cmd-item .desc { color: var(--fc2); font-size: 12px; word-break: break-all; }
    .install-overlay {
      position: fixed; inset: 0; z-index: 9999;
      background: var(--bk); display: flex; align-items: center; justify-content: center;
      flex-direction: column; gap: 16px;
    }
    .install-overlay .title { font-size: 18px; color: var(--fc); }
    .install-overlay .sub { font-size: 12px; color: var(--fc2); max-width: 80%; word-break: break-all; }
    .install-overlay .spin {
      width: 32px; height: 32px; border: 3px solid var(--bd);
      border-top-color: var(--ac); border-radius: 50%;
      animation: installSpin .8s linear infinite;
    }
    .install-overlay .err { color: var(--del); font-size: 14px; max-width: 80%; word-break: break-all; }
    .install-overlay button {
      padding: 8px 20px; border: 1px solid var(--bd); border-radius: 6px;
      background: var(--bk3); color: var(--fc); font-size: 13px; cursor: pointer;
    }
    .install-overlay button:hover { background: var(--bk2); }
    @keyframes installSpin { to { transform: rotate(360deg) } }
    .notify {
      position: fixed; bottom: 68px; left: 50%; transform: translateX(-50%);
      padding: 6px 14px; border-radius: 6px; font-size: 12px; z-index: 9998;
      background: var(--del); color: #fff; opacity: 0; transition: opacity .25s;
      pointer-events: none; white-space: nowrap;
    }
    .notify.show { opacity: 1; }
    .todo-panel {
      flex-shrink: 0; max-height: 140px; overflow-y: auto;
      background: var(--bk2); border-top: 1px solid var(--bd);
      padding: 8px 16px; font-size: 12px; color: var(--fc2);
    }
    .todo-panel .todo-head { font-size: 11px; color: var(--fc3); margin-bottom: 4px; }
    .todo-item { padding: 2px 0; }
    .todo-item .td { color: var(--fc3); margin-right: 6px; }
    .todo-item .do { color: var(--ac); margin-right: 6px; }
    .todo-item .done { text-decoration: line-through; color: var(--fc3); }
    .stream-par.err-text { color: var(--del); }
    .stream-par.err-text pre, .stream-par.err-text code { color: var(--del); }
    .msg .meta.ok { color: var(--ok); }
    .msg .meta.err { color: var(--del); }
    .question-panel {
      flex-shrink: 0; background: var(--bk2); border-top: 1px solid var(--bd);
      padding: 10px 16px; max-height: 45%; overflow-y: auto;
    }
    .question-panel .q-item { margin-bottom: 12px; }
    .question-panel .q-header { font-size: 11px; color: var(--ac); text-transform: uppercase; letter-spacing: .5px; margin-bottom: 2px; }
    .question-panel .q-text { font-size: 14px; color: var(--fc); margin: 2px 0 8px; }
    .q-opt {
      display: flex; align-items: center; gap: 8px; padding: 8px 10px;
      border: 1px solid var(--bd); border-radius: 8px; cursor: pointer;
      margin-bottom: 6px; background: var(--bk3); transition: all .15s;
    }
    .q-opt:hover { border-color: var(--ac); }
    .q-opt.sel { border-color: var(--ac); background: rgba(88,166,255,.12); }
    .q-opt .q-check {
      width: 16px; height: 16px; border-radius: 4px; border: 1px solid var(--fc3);
      flex-shrink: 0; display: flex; align-items: center; justify-content: center;
      font-size: 11px; color: #000;
    }
    .q-opt.sel .q-check { background: var(--ac); border-color: var(--ac); }
    .q-opt .q-label { font-weight: bold; color: var(--fc); }
    .q-opt .q-desc { color: var(--fc2); font-size: 12px; }
    .q-custom { display: flex; gap: 8px; margin: 6px 0; }
    .q-custom input {
      flex: 1; padding: 8px 10px; border-radius: 6px; border: 1px solid var(--bd);
      background: var(--bk3); color: var(--fc); font-size: 13px; outline: none;
    }
    .q-custom input:focus { border-color: var(--ac); }
    .q-actions { display: flex; gap: 8px; margin-top: 8px; }
    .q-actions button {
      padding: 8px 18px; border-radius: 8px; cursor: pointer; font-size: 13px;
    }
    .q-submit { background: var(--ac); color: #000; font-weight: bold; border: 1px solid var(--ac); }
    .q-submit:disabled { opacity: .5; cursor: not-allowed; }
    .q-reject { background: var(--bk3); color: var(--fc2); border: 1px solid var(--bd); }
    .q-reject:hover { color: var(--fc); border-color: var(--fc3); }
    .permission-panel {
      flex-shrink: 0; background: var(--bk2); border-top: 1px solid var(--bd);
      padding: 12px 16px; max-height: 45%; overflow-y: auto;
    }
    .permission-panel .p-header {
      font-size: 11px; color: var(--ac); text-transform: uppercase; letter-spacing: .5px; margin-bottom: 2px;
    }
    .permission-panel .p-action { font-size: 14px; font-weight: bold; color: var(--fc); margin: 2px 0 8px; word-break: break-all; }
    .permission-panel .p-res {
      display: flex; align-items: flex-start; gap: 8px; padding: 7px 10px;
      border: 1px solid var(--bd); border-radius: 8px; margin-bottom: 5px;
      background: var(--bk3); font-size: 12px; color: var(--fc2); word-break: break-all;
    }
    .permission-panel .p-res::before { content: '▸'; color: var(--ac); flex-shrink: 0; }
    .p-actions { display: flex; gap: 8px; margin-top: 10px; }
    .p-actions button { padding: 8px 12px; border-radius: 8px; cursor: pointer; font-size: 13px; flex: 1; }
    .p-actions button:disabled { opacity: .5; cursor: not-allowed; }
    .p-once { background: var(--ac); color: #000; font-weight: bold; border: 1px solid var(--ac); }
    .p-always { background: var(--bk3); color: var(--fc); border: 1px solid var(--fc3); }
    .p-always:hover { border-color: var(--ac); color: var(--ac); }
    .p-reject { background: var(--bk3); color: var(--del); border: 1px solid var(--del); }
    .p-reject:hover { background: rgba(248,81,73,.1); }
  </style>
</head>
<body>

<div id="app">
  <div class="install-overlay" v-if="installOverlay">
    <div class="spin" v-if="!installErr"></div>
    <div class="title" v-if="!installErr">Installing opencode...</div>
    <div class="sub" v-if="!installErr">{{ installProgress }}</div>
    <div class="err" v-if="installErr">{{ installErr }}</div>
    <button v-if="installErr" @click="location.reload()">Retry</button>
  </div>

  <div class="notify" :class="{show: notifyShow}">{{ notifyMsg }}</div>

  <div class="overlay" :class="{show: sessionPanelOpen}" @click="sessionPanelOpen=false"></div>

  <div class="session-panel" :class="{open: sessionPanelOpen}">
    <div class="session-panel-header">
      <span>Session History</span>
      <button @click="sessionPanelOpen=false">x</button>
    </div>
    <div class="session-list">
      <template v-if="pinnedSessions.length">
        <div class="section-label">PINNED</div>
        <div v-for="s in pinnedSessions" :key="'p'+s.id" class="session-item"
             :class="{active: s.id===sessionId}" :style="{opacity: deleting[s.id] ? .4 : 1}" @click="selectSession(s.id)">
          <span class="s-del" @click.stop="deleteLocalSession(s.id)" title="Delete">x</span>
          <div class="s-time">{{ fmtTime(s.timestamp) }}</div>
          <div class="s-prompt">{{ (s.prompt||'').substring(0,50) }}</div>
          <div class="s-preview">{{ (s.preview||'').substring(0,60) }}</div>
        </div>
      </template>
      <template v-if="sessions.length">
        <div class="section-label">Opencode</div>
        <div v-for="s in sessions" :key="'o'+s.id" class="session-item"
             :class="{active: s.id===sessionId}" :style="{opacity: deleting[s.id] ? .4 : 1}" @click="selectSession(s.id)">
          <span class="s-del" @click.stop="deleteOCSession(s.id)" title="Delete">x</span>
          <div class="s-time">{{ fmtTime(s.updated||s.created) }}</div>
          <div class="s-prompt">{{ (s.title||'').substring(0,50) }}</div>
          <div class="s-preview" style="font-size:11px;color:var(--fc3)">{{ s.id }}</div>
        </div>
      </template>
      <div v-if="!pinnedSessions.length && !sessions.length" class="session-empty">No sessions yet.<br>Send a message to start one.</div>
    </div>
  </div>

  <div class="header">
    <h1 @click="sessionPanelOpen=true" title="Open sessions">OpenCode</h1>
    <span class="dot" :class="{run: busy}"></span>
    <span class="load" v-if="loading">&#8226; &#8226; &#8226;</span>
    <span class="ver">{{ ocVersion }}</span>
    <span class="dropdown-trigger" @click.stop="toggleDropdown('session')" title="Click to select session">
      <b>{{ sessionLabel }}</b> <span class="arr">&#9660;</span>
      <div class="dropdown" :class="{show: dropdown==='session'}" @click.stop>
        <template v-if="sessionDropdownList.length">
          <div v-for="s in sessionDropdownList" :key="s.id" class="d-item" :class="{active: s.id===sessionId}" @click="selectSession(s.id)">
            <div class="d-title">{{ sessionTitle(s).substring(0,50) }}</div>
            <div class="d-sub">{{ s.id.slice(0,16) }}...</div>
          </div>
          <div class="d-more" @click="viewAll">View all {{ totalSessions }} sessions &rarr;</div>
        </template>
        <div v-else class="d-empty">No sessions yet</div>
      </div>
    </span>
    <span class="dropdown-trigger" @click.stop="toggleDropdown('model')" title="Click to select model">
      <span>{{ currentModel || 'auto' }}</span> <span class="arr">&#9660;</span>
      <div class="dropdown" id="modelDropdown" :class="{show: dropdown==='model'}" @click.stop>
        <div class="d-item" :class="{active: !currentModel}" @click="selectModel('')">
          <div class="d-title">auto</div><div class="d-sub">default model</div>
        </div>
        <div v-for="m in cleanModels" :key="m" class="d-item" :class="{active: m===currentModel}" @click="selectModel(m)">
          <div class="d-title">{{ m }}</div>
        </div>
      </div>
    </span>
    <div class="spacer"></div>
    <span class="ctx" v-if="ctxLimit" :title="ctxUsed + ' / ' + ctxLimit + ' tokens'">
      <span class="ctx-bar" :class="{ warn: ctxPct >= 80 && ctxPct < 95, danger: ctxPct >= 95 }"><i :style="ctxStyle"></i></span>
      <span class="ctx-num">{{ ctxLabel }} · {{ ctxPct }}%</span>
    </span>
    <button @click="compactChat()">compact</button>
  </div>

  <div class="messages" ref="messagesEl">
    <div class="msg-loading" v-if="switching"><span class="spin"></span> Loading session...</div>
    <template v-else>
    <div class="welcome" v-if="!messages.length"><b>OpenCode AI Chat</b><br>Streaming via SSE<br>Click title to view sessions</div>
    <div v-for="(m, mi) in messages" :key="mi" :class="['msg', m.role]">
      <template v-if="m.role === 'user'">{{ m.content }}</template>
      <template v-else>
        <div v-for="(p, pi) in m.parts" :key="pi">
          <div v-if="p.t === 'ref'" :class="['ref', p.cls || refClass(p.c)]">{{ p.c }}</div>
          <pre v-else-if="p.t === 'out'" class="tool-out">{{ p.c }}</pre>
          <template v-else-if="p.t === 'text'">
            <div v-for="(v, vi) in mdViews(p, m.streaming)" :key="vi" class="stream-par" :class="p.cls || ''">
              <pre v-if="v.plain" class="stream-text">{{ v.text }}</pre>
              <div v-else v-html="v.html"></div>
            </div>
          </template>
        </div>
        <span class="cursor" v-if="m.streaming"></span>
        <div class="meta" :class="m.errored ? 'err' : 'ok'" v-if="m.meta">{{ m.meta }}</div>
      </template>
    </div>
    </template>
  </div>

  <div class="todo-panel" v-if="todos.length">
    <div class="todo-head">TODO</div>
    <div v-for="(t, ti) in todos" :key="ti" class="todo-item">
      <span class="td">{{ t.status==='completed' ? '✓' : t.status==='in_progress' ? '◐' : '○' }}</span>
      <span :class="{done: t.status==='completed'}">{{ t.content }}</span>
    </div>
  </div>

  <div class="question-panel" v-if="question">
    <div v-for="(q, qi) in question.questions" :key="qi" class="q-item">
      <div class="q-header">{{ q.header || 'Question' }}</div>
      <div class="q-text">{{ q.question }}</div>
      <div v-for="(opt, oi) in q.options" :key="oi" class="q-opt"
           :class="{sel: qSel[qi] && qSel[qi].indexOf(opt.label) >= 0}" @click="qToggle(qi, opt.label)">
        <span class="q-check">{{ qSel[qi] && qSel[qi].indexOf(opt.label) >= 0 ? '✓' : '' }}</span>
        <span class="q-label">{{ opt.label }}</span>
        <span class="q-desc">{{ opt.description }}</span>
      </div>
      <div class="q-custom" v-if="q.custom !== false">
        <input type="text" v-model="qCustom[qi]" placeholder="Type a custom answer..." @keydown.enter.prevent="qSubmit">
      </div>
    </div>
    <div class="q-actions">
      <button class="q-submit" @click="qSubmit" :disabled="qSubmitting">Submit</button>
      <button class="q-reject" @click="qReject">Dismiss</button>
    </div>
  </div>

  <div class="permission-panel" v-if="permission">
    <div class="p-header">Permission required</div>
    <div class="p-action">{{ permission.action }}</div>
    <div v-for="(r, ri) in permission.resources" :key="ri" class="p-res">{{ r }}</div>
    <div class="p-actions">
      <button class="p-once" @click="permissionReply('once')" :disabled="permissionSubmitting">Allow once</button>
      <button class="p-always" @click="permissionReply('always')" :disabled="permissionSubmitting">Always allow</button>
      <button class="p-reject" @click="permissionReply('reject')" :disabled="permissionSubmitting">Reject</button>
    </div>
  </div>

  <div class="cmd-wrap">
    <div class="cmd-dropdown" v-if="cmdOpen && cmdFiltered.length">
      <div class="cmd-item" v-for="(c, ci) in cmdFiltered" :key="c.name" :class="{active: ci === cmdIdx}" @mousedown.prevent="pickCmd(c)">
        <span class="name">/{{ c.name }}</span>
        <span class="desc">{{ c.description }}</span>
      </div>
    </div>
    <div class="input-bar">
      <textarea ref="inputEl" rows="1" placeholder="Type a message... (Enter to send, Ctrl+Enter for newline)" v-model="inputText" @input="onInput" @keydown="onKey"></textarea>
      <button v-if="busy" @click="stop()">Stop</button>
      <button @click="send()" :disabled="busy">Send</button>
    </div>
  </div>
</div>

<script>
  let _inited = false
  const installId = Date.now() + '-' + Math.random().toString(36).slice(2, 8)
  let notifyTimer = null
  const blockCache = new Map()
  const BLOCK_CACHE_MAX = 400
  const STREAM_PARSE_MAX = 4000

  const app = Vue.createApp({
    data() {
      return {
        busy: false, sessionId: '', sessions: [], models: [], currentModel: '', pinnedSessions: [],
        deleting: {}, messages: [], inputText: '', todos: [], runId: '',
        commands: [], cmdOpen: false, cmdIdx: -1,
        histList: [], histIdx: -1, histDraft: '',
        sessionPanelOpen: false, dropdown: '',
        notifyMsg: '', notifyShow: false, loading: false,
        ocVersion: '', installOverlay: true, installErr: '', installProgress: 'This may take a minute',
        ctxUsed: 0, ctxLimit: 0, ctxPct: 0, ctxModel: '',
        question: null, qSel: [], qCustom: [], qSubmitting: false, qEl: null,
        permission: null, permissionSubmitting: false,
        sseMain: null, mainReady: false, sseHandlers: {}, switching: false,
        _lastRunSession: ''
      }
    },
    computed: {
      sessionLabel() {
        const s = this.sessions.find(function(x) { return x.id === this.sessionId }, this) || this.pinnedSessions.find(function(x) { return x.id === this.sessionId }, this)
        if (s) return (this.sessionTitle(s) || '').substring(0, 25)
        return this.sessionId ? this.sessionId.slice(0, 10) + '...' : 'No session'
      },
      sessionDropdownList() {
        return this.pinnedSessions.length ? this.pinnedSessions.slice(0, 5) : this.sessions.slice(0, 10)
      },
      totalSessions() {
        return this.pinnedSessions.length + this.sessions.length
      },
      cleanModels() {
        const self = this
        const out = []
        this.models.forEach((m) => { const c = m.replace(/\r/g, ''); if (out.indexOf(c) < 0) out.push(c) })
        return out
      },
      cmdFiltered() {
        if (!this.cmdOpen) return []
        const q = this.inputText.replace(/^\s*\//, '').toLowerCase()
        const out = this.commands.filter((c) => {
          return !q || c.name.toLowerCase().indexOf(q) === 0 || c.description.toLowerCase().indexOf(q) >= 0
        })
        return out.slice(0, 8)
      },
      ctxLabel() {
        if (!this.ctxLimit) return ''
        return this.fmtK(this.ctxUsed) + ' / ' + this.fmtK(this.ctxLimit)
      },
      ctxStyle() {
        return { width: Math.min(100, this.ctxPct) + '%' }
      }
    },
    methods: {
      esc(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;') },
      fmtTime(ts) { if (!ts) return ''; try { return new Date(ts).toLocaleString() } catch(e) { return '' } },
      fmtK(n) {
        n = Number(n) || 0
        if (n >= 1000) return (n / 1000).toFixed(1) + 'k'
        return String(n)
      },
      sessionTitle(s) { return s.title || s.prompt || s.id },
      renderMd(t) {
        if (!t) return ''
        let html = marked.parse(t, { gfm: true, breaks: false, headerIds: false, mangle: false })
        html = html.replace(/<pre><code class="language-(\w+)">/g, '<pre><span class="code-lang">$1</span><code>')
        html = html.replace(/<pre><code class="">/g, '<pre><code>')
        html = html.replace(/<a href=/g, '<a target="_blank" href=')
        return html
      },
      mdBlocks(t) {
        if (!t) return []
        const lines = String(t).replace(/\r\n/g, '\n').split('\n')
        const blocks = []
        let cur = []
        let inFence = false
        let fenceChar = ''
        const flush = () => {
          if (cur.length && cur.join('\n').trim() !== '') blocks.push(cur.join('\n'))
          cur = []
        }
        for (let i = 0; i < lines.length; i++) {
          const line = lines[i]
          if (!inFence) {
            const fm = /^\s*(`{3,}|~{3,})\s*[a-zA-Z0-9_-]*\s*$/.exec(line)
            if (fm) {
              flush()
              cur = [line]
              inFence = true
              fenceChar = fm[1]
              continue
            }
          } else if (line.replace(/\s+$/, '').indexOf(fenceChar) >= 0) {
            cur.push(line)
            inFence = false
            flush()
            continue
          }
          cur.push(line)
          if (!inFence && line.trim() === '') flush()
        }
        flush()
        return blocks
      },
      isOpenFence(blk) {
        const lines = String(blk).split('\n')
        let fenceChar = ''
        for (let i = 0; i < lines.length; i++) {
          const line = lines[i]
          if (!fenceChar) {
            const fm = /^\s*(`{3,}|~{3,})\s*[a-zA-Z0-9_-]*\s*$/.exec(line)
            if (fm) fenceChar = fm[1]
          } else if (line.replace(/\s+$/, '').indexOf(fenceChar) >= 0) {
            fenceChar = ''
          }
        }
        return !!fenceChar
      },
      cachedMd(blk) {
        if (blockCache.has(blk)) return blockCache.get(blk)
        const html = this.renderMd(blk)
        blockCache.set(blk, html)
        if (blockCache.size > BLOCK_CACHE_MAX) {
          const firstKey = blockCache.keys().next().value
          if (firstKey) blockCache.delete(firstKey)
        }
        return html
      },
      mdViews(p, streaming) {
        if (!p || p.t !== 'text') return []
        const blocks = this.mdBlocks(p.c)
        const views = []
        for (let i = 0; i < blocks.length; i++) {
          const blk = blocks[i]
          let plain = false
          if (streaming && i === blocks.length - 1 && (this.isOpenFence(blk) || blk.length > STREAM_PARSE_MAX)) {
            plain = true
          }
          views.push({ text: blk, html: plain ? null : this.cachedMd(blk), plain: plain })
        }
        return views
      },
      refClass(c) {
        let rc = 'ref'
        if (/^>\s*build/.test(c)) rc += ' info'
        else if (/^\$\s/.test(c)) rc += ' cmd'
        else if (/^←/.test(c)) rc += ' edit'
        else if (/^[◈]/.test(c)) rc += ' tool'
        else rc += ' act'
        return rc
      },
      toggleDropdown(which) {
        this.dropdown = this.dropdown === which ? '' : which
      },
      viewAll() {
        this.dropdown = ''
        this.sessionPanelOpen = true
        this.loadSessions()
      },
      showNotify(msg) {
        this.notifyMsg = msg
        this.notifyShow = true
        clearTimeout(notifyTimer)
        notifyTimer = setTimeout(() => { this.notifyShow = false }, 6000)
      },
      loadSessions() {
        const self = this
        this.loading = true
        return Promise.all([
          this.fetchFend('sessions', {}, 10000).catch((e) => { self.showNotify('sessions: ' + e.message); return { pinned: [] } }),
          this.fetchFend('models', {}, 15000).catch((e) => { self.showNotify('models: ' + e.message); return { models: [] } })
        ]).then((results) => {
          self.models = (results[1] && results[1].models) || []
          self.pinnedSessions = (results[0] && results[0].pinned) || []
          return self.fetchFend('opencode_sessions', {}, 8000).catch((e) => { self.showNotify('opencode sessions: ' + e.message); return { sessions: [] } })
        }).then((oc) => {
          if (oc && oc.sessions) self.sessions = oc.sessions
        }).finally(() => { self.loading = false })
      },
      fetchFend(key, data, timeout) {
        return fetch('', {
          method: 'post',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({key: key, data: data, timeout: timeout || 60000})
        }).then((r) => { return r.json() })
      },
      selectModel(m) {
        this.currentModel = (m || '').replace(/\r/g, '')
        localStorage.setItem('aichat_oc_last_model', this.currentModel)
        this.dropdown = ''
        this.refreshCtx()
      },
      selectSession(id) {
        const prev = this.sessionId
        this.sessionId = id
        localStorage.setItem('aichat_oc_last_session', id)
        this.dropdown = ''
        this.loadSessions()
        this.syncCtx(id)
        if (!(this.busy && id === prev)) this.loadSessionMessages(id)
      },
      loadSessionMessages(id) {
        const self = this
        this.messages = []
        this.switching = true
        return this.fetchFend('session_messages', { id: id }, 15000).then((data) => {
          self.switching = false
          if (data && Array.isArray(data.messages)) {
            self.messages = data.messages
            self.scrollBottom()
          }
        }).catch(() => { self.switching = false })
      },
      deleteLocalSession(id) {
        if (this.deleting[id]) return
        const self = this
        this.deleting[id] = true
        this.fetchFend('delete_session', { id: id }, 10000).then(() => {
          if (self.sessionId === id) self.sessionId = ''
          self.loadSessions()
          self.showNotify('Session deleted')
        }).catch((e) => {
          self.showNotify('Delete failed: ' + e.message)
        }).then(() => { delete self.deleting[id] })
      },
      deleteOCSession(id) {
        if (this.deleting[id]) return
        const self = this
        this.deleting[id] = true
        this.fetchFend('opencode_delete_session', { id: id }, 10000).then((data) => {
          if (data.ok) {
            if (self.sessionId === id) self.sessionId = ''
            self.loadSessions()
            self.showNotify('Session deleted')
          } else {
            self.showNotify('Delete failed: ' + (data.error || 'unknown'))
          }
        }).catch((e) => {
          self.showNotify('Delete failed: ' + e.message)
        }).then(() => { delete self.deleting[id] })
      },
      autosize() {
        const el = this.$refs.inputEl
        if (!el) return
        el.style.height = 'auto'
        el.style.height = Math.min(el.scrollHeight, 160) + 'px'
      },
      onInput() {
        this.autosize()
        const q = this.inputText.replace(/^\s*/, '')
        if (q.charAt(0) === '/') {
          this.cmdOpen = true
          this.cmdIdx = 0
        } else {
          this.cmdOpen = false
        }
      },
      pickCmd(c) {
        this.inputText = '/' + c.name + ' '
        this.cmdOpen = false
        this.cmdIdx = -1
        this.autosize()
        const el = this.$refs.inputEl
        if (el) el.focus()
      },
      loadCommands() {
        const self = this
        this.fetchFend('commands', {}, 8000).then((data) => {
          if (data && data.ok && Array.isArray(data.commands)) self.commands = data.commands
        }).catch(() => {})
      },
      loadHistory() {
        try {
          let arr = JSON.parse(localStorage.getItem('aichat_oc_history') || '[]')
          if (Array.isArray(arr)) this.histList = arr
        } catch(e) {}
        this.histIdx = -1
        this.histDraft = ''
      },
      saveHistory(text) {
        const t = String(text || '').trim()
        if (!t) return
        let arr = this.histList.filter((x) => { return x !== t })
        arr.push(t)
        if (arr.length > 50) arr = arr.slice(arr.length - 50)
        this.histList = arr
        this.histIdx = -1
        this.histDraft = ''
        try { localStorage.setItem('aichat_oc_history', JSON.stringify(arr)) } catch(e) {}
      },
      histNav(dir) {
        const self = this
        const list = this.histList
        if (!list.length) return
        const el = this.$refs.inputEl
        if (this.histIdx === -1) this.histDraft = this.inputText
        if (dir < 0) {
          this.histIdx = this.histIdx === -1 ? list.length - 1 : this.histIdx - 1
        } else {
          this.histIdx = this.histIdx === -1 ? -1 : this.histIdx + 1
          if (this.histIdx >= list.length) this.histIdx = -1
        }
        this.inputText = this.histIdx >= 0 ? list[this.histIdx] : this.histDraft
        this.cmdOpen = false
        this.$nextTick(() => {
          self.autosize()
          if (el) {
            el.focus()
            el.setSelectionRange(el.value.length, el.value.length)
          }
        })
      },
      onKey(e) {
        if (this.cmdOpen && this.cmdFiltered.length) {
          if (e.key === 'ArrowDown') {
            e.preventDefault()
            this.cmdIdx = (this.cmdIdx + 1) % this.cmdFiltered.length
            return
          }
          if (e.key === 'ArrowUp') {
            e.preventDefault()
            this.cmdIdx = (this.cmdIdx - 1 + this.cmdFiltered.length) % this.cmdFiltered.length
            return
          }
          if (e.key === 'Tab') {
            e.preventDefault()
            this.pickCmd(this.cmdFiltered[this.cmdIdx >= 0 ? this.cmdIdx : 0])
            return
          }
          if (e.key === 'Enter' && !(e.ctrlKey || e.metaKey)) {
            e.preventDefault()
            this.pickCmd(this.cmdFiltered[this.cmdIdx >= 0 ? this.cmdIdx : 0])
            this.send()
            return
          }
          if (e.key === 'Escape') {
            e.preventDefault()
            this.cmdOpen = false
            this.cmdIdx = -1
            return
          }
        }
        if (e.key === 'ArrowUp' && !this.cmdOpen) {
          e.preventDefault()
          this.histNav(-1)
          return
        }
        if (e.key === 'ArrowDown' && !this.cmdOpen) {
          e.preventDefault()
          this.histNav(1)
          return
        }
        if (e.key === 'Enter') {
          if (e.ctrlKey || e.metaKey) {
            e.preventDefault()
            this.insertNewline()
          } else {
            e.preventDefault()
            this.send()
          }
        }
      },
      insertNewline() {
        const el = this.$refs.inputEl
        if (!el) return
        const start = el.selectionStart
        const end = el.selectionEnd
        this.inputText = this.inputText.slice(0, start) + '\n' + this.inputText.slice(end)
        this.autosize()
        const self = this
        this.$nextTick(() => {
          el.focus()
          el.setSelectionRange(start + 1, start + 1)
        })
      },
      scrollBottom() {
        const self = this
        this.$nextTick(() => {
          const el = self.$refs.messagesEl
          if (el) el.scrollTop = el.scrollHeight
        })
      },
      ensureMainSse() {
        const self = this
        return new Promise((resolve) => {
          if (self.mainReady) return resolve(true)
          let done = false
          const finish = (v) => { if (done) return; done = true; resolve(v) }
          const check = setInterval(() => { if (self.mainReady) { clearInterval(check); finish(true) } }, 100)
          setTimeout(() => { clearInterval(check); finish(true) }, 8000)
        })
      },
      async send() {
        if (this.busy) return
        const self = this
        let prompt = this.inputText.trim()
        if (!prompt) return
        if (prompt.length > 1200) {
          prompt = prompt.slice(0, 1200)
          this.showNotify('Message exceeds 1200 chars, truncated')
        }
        this.cmdOpen = false
        this.cmdIdx = -1
        if (/^\/new\s*$/.test(prompt)) {
          this.inputText = ''
          this.$nextTick(() => { self.autosize() })
          this.clearChat()
          return
        }
        this.saveHistory(prompt)
        this.inputText = ''
        this.$nextTick(() => { self.autosize() })
        this.busy = true
        this.messages.push({ role: 'user', content: prompt })
        const el = Vue.reactive({ role: 'assistant', parts: [], streaming: true })
        this.messages.push(el)
        this.scrollBottom()
        // wait until the SSE channel is registered before starting the run,
        // otherwise the backend's $ws.sse stream is dropped (shows only after refresh)
        await self.ensureMainSse()
        const startTime = Date.now()
        const runId = Date.now() + '-' + Math.random().toString(36).slice(2, 8)
        this.runId = runId
        this.todos = []
        if (this.currentModel) this.ctxModel = this.currentModel

        let textBuf = ''
        let textFlush = null
        const flushText = () => {
          if (textFlush) { clearTimeout(textFlush); textFlush = null }
          if (!textBuf) return
          const last = el.parts[el.parts.length - 1]
          if (last && last.t === 'text') {
            last.c += textBuf
          } else {
            el.parts.push({ t: 'text', c: textBuf })
          }
          textBuf = ''
        }

        const onMsg = (data) => {
          try {
            if (data.type === 'init') {
              if (data.content && el.initShown !== data.content) {
                flushText()
                el.parts.push({ t: 'ref', c: data.content, cls: 'info' })
                el.initShown = data.content
              }
              return
            }
            if (data.type === 'ref') {
              flushText()
              el.parts.push({ t: 'ref', c: data.content, cls: data.cls || '' })
            }
            if (data.type === 'out') {
              flushText()
              const lastOut = el.parts[el.parts.length - 1]
              if (lastOut && lastOut.t === 'out') lastOut.c += data.content
              else el.parts.push({ t: 'out', c: data.content })
            }
            if (data.type === 'text') {
              textBuf += data.content
              if (!textFlush) textFlush = setTimeout(flushText, 50)
            }
            if (data.type === 'todo') {
              self.todos = data.data || []
            }
            if (data.type === 'ctx') {
              self.ctxUsed = data.used || 0
              if (data.limit > 0) self.ctxLimit = data.limit
              if (data.pct !== undefined && data.pct !== null) self.ctxPct = data.pct
              else if (self.ctxLimit) self.ctxPct = Math.round((self.ctxUsed || 0) / self.ctxLimit * 1000) / 10
              if (data.model) self.ctxModel = data.model
              try {
                if (self.ctxLimit) localStorage.setItem('aichat_oc_ctx_limit', String(self.ctxLimit))
                if (self.ctxModel) localStorage.setItem('aichat_oc_ctx_model', self.ctxModel)
              } catch(e) {}
            }
            if (data.type === 'session') {
              self.sessionId = data.id || ''
              self._lastRunSession = self.sessionId || self._lastRunSession
              try {
                if (self.sessionId) localStorage.setItem('aichat_oc_last_session', self.sessionId)
              } catch(e) {}
            }
            if (data.type === 'question') {
              self.question = data.data || null
              self.qSel = []
              self.qCustom = []
              if (self.question && self.question.questions) {
                for (let i = 0; i < self.question.questions.length; i++) {
                  self.qSel.push([])
                  self.qCustom.push('')
                }
              }
              flushText()
              self.qEl = el
              const qs = (self.question && self.question.questions) || []
              for (let i = 0; i < qs.length; i++) {
                const q = qs[i]
                let line = '❓ ' + (q.header || 'Question') + ': ' + q.question
                if (Array.isArray(q.options)) {
                  line += '\n' + q.options.map((o) => '   · ' + o.label).join('\n')
                }
                el.parts.push({ t: 'ref', c: line, cls: 'question' })
              }
              self.scrollBottom()
              return
            }
            if (data.type === 'question_done') {
              if (self.question && data.data && self.question.requestID === data.data.requestID) {
                self.qEl = null
                self.question = null
                self.qSel = []
                self.qCustom = []
              }
              return
            }
            if (data.type === 'permission') {
              self.permission = data.data || null
              flushText()
              if (self.permission) {
                const p = self.permission
                let line = '🔒 permission · ' + (p.action || 'request')
                if (Array.isArray(p.resources) && p.resources.length) {
                  line += '\n' + p.resources.map((r) => '   · ' + r).join('\n')
                }
                el.parts.push({ t: 'ref', c: line, cls: 'permission' })
              }
              self.scrollBottom()
              return
            }
            if (data.type === 'permission_done') {
              if (self.permission && data.data && self.permission.requestID === data.data.requestID) {
                const p = self.permission
                const label = data.data.reply === 'always' ? 'always allow' : data.data.reply === 'reject' ? 'reject' : 'allow once'
                el.parts.push({ t: 'ref', c: '✔ permission ' + (p.action || 'request') + ': ' + label, cls: 'answer' })
                self.permission = null
              }
              return
            }
            if (data.type === 'done') {
              flushText()
              if (data.content) el.parts.push({ t: 'text', c: data.content })
              el.streaming = false
              self.qEl = null
              self.question = null
              self.qSel = []
              self.qCustom = []
              self.permission = null
              delete self.sseHandlers[runId]
              if (!el.stopped) {
                let meta = Math.round((Date.now() - startTime) / 1000) + 's'
                if (data.tokens) meta += ' | ⚙ ' + data.tokens.total + ' tokens'
                if (data.steps) meta += ' | ' + data.steps + ' steps'
                if (data.model) meta += ' | ' + data.model
                if (data.timeout) {
                  meta += ' | ⚠ timed out'
                  el.errored = true
                } else {
                  meta = '✓ ' + meta
                }
                el.meta = meta
                if (data.model) self.ctxModel = data.model
                try {
                  if (data.model) localStorage.setItem('aichat_oc_ctx_model', data.model)
                } catch(e) {}
              }
              self.busy = false
              self.runId = ''
              self.todos = []
              self.loadSessions()
              // 兜底：若 sessionId 仍为空（后端 session 事件未送达），选中本次 run 实际使用的会话，
              // 而不要盲选 sessions[0]，否则会加载成另一个会话的历史。
              if (!self.sessionId && self._lastRunSession) {
                self.selectSession(self._lastRunSession)
              } else if (!self.sessionId) {
                self.loadSessions().then(() => {
                  if (self.sessions.length > 0) self.selectSession(self.sessions[0].id)
                })
              }
              self.scrollBottom()
              return
            }
            if (data.type === 'error') {
              flushText()
              el.streaming = false
              el.errored = true
              self.question = null
              self.qSel = []
              self.qCustom = []
              self.permission = null
              if (el.stopped) {
                if (data.content && data.content !== 'client disconnected') {
                  el.meta = (el.meta ? el.meta + ' | ' : '') + '⚠ ' + data.content
                }
                delete self.sseHandlers[runId]
                self.busy = false
                self.runId = ''
                self.todos = []
                self.scrollBottom()
                return
              }
              if (el.parts.length) {
                el.meta = (el.meta ? el.meta + ' | ' : '') + '⚠ ' + data.content
              } else {
                el.parts = [{ t: 'text', c: 'Error: ' + data.content, cls: 'err-text' }]
              }
              delete self.sseHandlers[runId]
              self.busy = false
              self.runId = ''
              self.todos = []
              self.scrollBottom()
              return
            }
            self.scrollBottom()
          } catch(e) {}
        }
        self.sseHandlers[runId] = onMsg

        this.fetchFend('start', { prompt: prompt, runId: runId, session: this.sessionId, model: this.currentModel }, 120000).then((data) => {
          if (!data.ok) {
            el.errored = true; el.streaming = false
            el.parts = [{ t: 'text', c: 'Error: ' + (data.error || 'failed to start'), cls: 'err-text' }]
            self.busy = false
            self.runId = ''
            self.todos = []
            delete self.sseHandlers[runId]
            self.scrollBottom()
          } else if (data.sessionId) {
            self.sessionId = data.sessionId
            try {
              if (self.sessionId) localStorage.setItem('aichat_oc_last_session', self.sessionId)
            } catch(e) {}
          }
        }).catch((e) => {
          flushText()
          if (el.parts.length) {
            el.streaming = false
            el.meta = 'Connection closed'
          } else {
            el.errored = true; el.streaming = false
            el.parts = [{ t: 'text', c: 'Error: ' + e.message, cls: 'err-text' }]
          }
          self.busy = false
          self.runId = ''
          self.todos = []
          delete self.sseHandlers[runId]
          self.scrollBottom()
        })
      },
      stop() {
        const self = this
        const runId = this.runId
        const sessionId = this.sessionId
        const last = this.messages[this.messages.length - 1]
        if (last && last.role === 'assistant' && last.streaming) {
          last.streaming = false
          last.stopped = true
          last.errored = true
          last.meta = (last.meta ? last.meta + ' | ' : '') + '⏹ stopped'
        }
        this.fetchFend('stop', { runId: runId, session: sessionId }, 15000).then((data) => {
          if (!data.ok && !data.error) {
            self.showNotify('stop failed' + (data.code ? ' (' + data.code + ')' : ''))
          }
          self.busy = false
        }).catch((e) => {
          self.showNotify('stop error: ' + e.message)
          self.busy = false
        })
      },
      qToggle(qi, label) {
        if (!this.question || this.qSubmitting) return
        const q = this.question.questions[qi]
        const cur = (this.qSel[qi] || []).slice()
        const idx = cur.indexOf(label)
        if (idx >= 0) cur.splice(idx, 1)
        else cur.push(label)
        this.qSel[qi] = q.multiple ? cur : cur.slice(-1)
        this.qSel = this.qSel.slice()
      },
      qSubmit() {
        const self = this
        if (!this.question || this.qSubmitting) return
        const answers = this.question.questions.map((q, qi) => {
          const arr = (this.qSel[qi] || []).slice()
          const custom = (this.qCustom[qi] || '').trim()
          if (custom && q.custom !== false && arr.indexOf(custom) < 0) arr.push(custom)
          return arr
        })
        this.qSubmitting = true
        const qData = this.question
        this.fetchFend('question_reply', { requestID: this.question.requestID, sessionID: this.question.sessionID, answers: answers }, 15000).then((data) => {
          self.qSubmitting = false
          if (data && data.ok) {
            if (self.qEl && qData && Array.isArray(qData.questions)) {
              const lines = qData.questions.map((q, qi) => {
                const arr = (self.qSel[qi] || []).slice()
                const custom = (self.qCustom[qi] || '').trim()
                if (custom && q.custom !== false && arr.indexOf(custom) < 0) arr.push(custom)
                return '✔ ' + (q.header || 'Answer') + ': ' + (arr.length ? arr.join(', ') : '(no selection)')
              })
              self.qEl.parts.push({ t: 'ref', c: lines.join('\n'), cls: 'answer' })
            }
            self.qEl = null
            self.question = null
            self.qSel = []
            self.qCustom = []
          } else {
            self.showNotify('Reply failed: ' + ((data && data.error) || 'unknown'))
          }
        }).catch((e) => {
          self.qSubmitting = false
          self.showNotify('Reply failed: ' + e.message)
        })
      },
      qReject() {
        const self = this
        if (!this.question || this.qSubmitting) return
        this.qSubmitting = true
        this.fetchFend('question_reject', { requestID: this.question.requestID }, 15000).then((data) => {
          self.qSubmitting = false
          if (data && data.ok) {
            if (self.qEl) self.qEl.parts.push({ t: 'ref', c: '✖ question dismissed', cls: 'answer' })
            self.qEl = null
            self.question = null
            self.qSel = []
            self.qCustom = []
          } else {
            self.showNotify('Reject failed: ' + ((data && data.error) || 'unknown'))
          }
        }).catch((e) => {
          self.qSubmitting = false
          self.showNotify('Reject failed: ' + e.message)
        })
      },
      permissionReply(reply) {
        const self = this
        if (!this.permission || this.permissionSubmitting) return
        this.permissionSubmitting = true
        const p = this.permission
        this.fetchFend('permission_reply', { requestID: p.requestID, sessionID: p.sessionID, reply: reply, legacy: p.legacy }, 15000).then((data) => {
          self.permissionSubmitting = false
          if (data && data.ok) {
            const label = reply === 'always' ? 'always allow' : reply === 'reject' ? 'reject' : 'allow once'
            self.showNotify('Permission ' + label + ': ' + (p.action || 'request'))
            self.permission = null
          } else {
            self.showNotify('Permission reply failed: ' + ((data && data.error) || 'unknown'))
          }
        }).catch((e) => {
          self.permissionSubmitting = false
          self.showNotify('Permission reply failed: ' + e.message)
        })
      },
      clearChat() {
        this.messages = []
        this.sessionId = ''
        this.qEl = null
        this.question = null
        this.qSel = []
        this.qCustom = []
        this.permission = null
        this.ctxUsed = 0
        this.ctxPct = 0
        try { localStorage.removeItem('aichat_oc_last_session') } catch(e) {}
      },
      compactChat() {
        const self = this
        this.messages = []
        this.todos = []
        this.inputText = '/compact'
        this.$nextTick(() => {
          self.send()
        })
      },
      initApp() {
        if (_inited) return
        _inited = true
        this.installOverlay = false
        this.loading = true
        const self = this
        this.loadCommands()
        this.loadHistory()
        this.loadSessions().then(() => {
          self.loading = false
          const savedModel = localStorage.getItem('aichat_oc_last_model')
          if (savedModel) self.currentModel = savedModel.replace(/\r/g, '')
          const savedSession = localStorage.getItem('aichat_oc_last_session')
          if (savedSession && savedSession !== self.sessionId && savedSession !== '') {
            for (let i = 0; i < self.sessions.length; i++) {
              if (self.sessions[i].id === savedSession) { self.selectSession(savedSession); break }
            }
          }
          self.refreshCtx()
        })
      },
      refreshCtx() {
        const self = this
        this.fetchFend('ctxinfo', { model: this.currentModel }, 10000).then((data) => {
          if (data && data.limit) {
            self.ctxLimit = data.limit
            if (data.model) self.ctxModel = data.model
          } else {
            const saved = localStorage.getItem('aichat_oc_ctx_limit')
            if (saved) self.ctxLimit = Number(saved)
            const savedModel = localStorage.getItem('aichat_oc_ctx_model')
            if (savedModel && !self.ctxModel) self.ctxModel = savedModel
          }
          if (self.sessionId) self.syncCtx(self.sessionId)
        }).catch(() => {})
      },
      syncCtx(sessionId) {
        if (!sessionId) return
        const self = this
        this.fetchFend('session_ctx', { id: sessionId, model: this.currentModel || this.ctxModel }, 12000).then((data) => {
          if (!data) return
          if (data.limit) self.ctxLimit = data.limit
          if (!self.ctxLimit) return
          self.ctxUsed = data.used || 0
          self.ctxPct = Math.round((self.ctxUsed || 0) / self.ctxLimit * 1000) / 10
          try { localStorage.setItem('aichat_oc_ctx_limit', String(self.ctxLimit)) } catch(e) {}
        }).catch(() => {})
      },
    },
    mounted() {
      const self = this
      document.addEventListener('click', () => { self.dropdown = '' })

      const mainEs = new EventSource('/sse/elecV2P/opencode-main')
      self.sseMain = mainEs
      mainEs.onmessage = (e) => {
        try {
          const d = JSON.parse(e.data)
          if (d.runId && self.sseHandlers[d.runId]) {
            self.sseHandlers[d.runId](d)
            return
          }
          if (d.type === 'init') {
            self.mainReady = true
            return
          }
        } catch(e) {}
      }
      mainEs.onerror = () => {}

      const installEs = new EventSource('/sse/elecV2P/' + installId)
      installEs.onmessage = (e) => {
        try {
          const d = JSON.parse(e.data)
          if (d.type === 'progress') self.installProgress = d.content
          if (d.type === 'done') {
            installEs.close()
            if (d.version) self.ocVersion = d.version
            self.initApp()
          }
          if (d.type === 'error') {
            installEs.close()
            self.installErr = d.content
          }
        } catch(e) {}
      }
      this.fetchFend('ensure_opencode', { installId: installId }, 120000).then((data) => {
        if (data && data.ok && !data.installing) {
          installEs.close()
          if (data.version) self.ocVersion = data.version
          self.initApp()
        } else if (data && !data.ok && data.error) {
          installEs.close()
          self.installErr = data.error
        }
      }).catch(() => {})
    }
  })

  app.mount('#app')
</script>

<script favend>
const { spawn, exec } = require('child_process')

const OC_HOST = 'http://localhost:14096'
const OC_BIN = 'opencode'

const stripAnsi = (s) => { return String(s).replace(/\u001b\[[0-9;]*[a-zA-Z]/g, '').replace(/\r/g, '') }
const isAlive = (pid) => { try { process.kill(Number(pid), 0); return true } catch(e) { return false } }

const SECRET_MASK = '***'
const SECRET_RE = /((?:api[_-]?key|access_token|auth[_-]?token|api_token|client_secret|session_id|sessionid|secret|password|passwd|token))(["']?)(\s*)([:=])(\s*)(?:"([^"]*)"|'([^']*)'|([^\s,;{}]+))/gi
const maskSecrets = (s) => {
  if (!s) return s
  return String(s)
    .replace(SECRET_RE, (m, key, qk, ws1, sep, ws2, dq, sq, plain) => {
      return key + qk + ws1 + sep + ws2 + (dq !== undefined ? '"' + SECRET_MASK + '"' : sq !== undefined ? "'" + SECRET_MASK + "'" : SECRET_MASK)
    })
    .replace(/(Bearer\s+)[A-Za-z0-9._~+\/=:-]+/gi, '$1' + SECRET_MASK)
    .replace(/\b(?:sk-[A-Za-z0-9_-]{6,}|sign[a-z0-9_.-]{8,}|eyJ[A-Za-z0-9_-]{10,})\b/gi, SECRET_MASK)
    .replace(/([a-z][a-z0-9+.-]*:\/\/)[^\/\s:@]*:([^@\s]+)@/gi, '$1' + SECRET_MASK + ':' + SECRET_MASK + '@')
}

const toolArg = (inp) => {
  const i = inp || {}
  let arg = i.command || i.filePath || i.path || i.url || i.pattern || i.query || ''
  if (i.filePath) {
    const off = Number(i.offset)
    const lim = Number(i.limit)
    if (!isNaN(off) && !isNaN(lim) && lim > 0) arg += ' · L' + off + '-' + (off + lim - 1)
    else if (!isNaN(lim) && lim > 0) arg += ' · ' + lim + ' lines'
    else if (!isNaN(off) && off > 0) arg += ' · from L' + off
  }
  if (typeof i.old_string === 'string' || typeof i.new_string === 'string') {
    const oldLines = typeof i.old_string === 'string' && i.old_string ? i.old_string.split('\n').length : 0
    const newLines = typeof i.new_string === 'string' && i.new_string ? i.new_string.split('\n').length : 0
    arg += ' · -' + oldLines + '/+' + newLines
  }
  if (arg.length > 200) arg = arg.slice(0, 200) + ' …'
  return arg
}

const IS_WIN = process.platform === 'win32'
const IS_PAAS = !!process.env.PAAS
const DEVNULL = IS_WIN ? 'nul' : '/dev/null'
let serverProc = null
const redirCmd = (cmd) => { return cmd + ' 2>' + DEVNULL }
const sleep = (ms) => { return new Promise((resolve) => { setTimeout(resolve, ms) }) }

const execAsync = (cmd, timeout) => {
  return new Promise((resolve, reject) => {
    exec(cmd, { timeout: timeout || 15000, windowsHide: true, encoding: 'utf-8', maxBuffer: 5 * 1024 * 1024 }, (error, stdout, stderr) => {
      if (error) reject(error)
      else resolve({ stdout: stdout || '', stderr: stderr || '' })
    })
  })
}

const httpGet = (path, port, timeout) => {
  return new Promise((resolve) => {
    const httpMod = require('http')
    const req = httpMod.get({ host: '127.0.0.1', port: port || 14096, path: path }, (res) => {
      let buf = ''
      res.on('data', (c) => { buf += c })
      res.on('end', () => { resolve({ status: res.statusCode, body: buf }) })
    })
    req.on('error', () => { resolve({ status: 0, body: '' }) })
    req.setTimeout(timeout || 8000, () => { req.destroy(); resolve({ status: 0, body: '' }) })
  })
}

let serverReadyAt = 0
let serverReadyOk = false
const serverReady = (force) => {
  const now = Date.now()
  if (!force && now - serverReadyAt < 5000) return Promise.resolve(serverReadyOk)
  return httpGet('/', 14096, 3000).then((r) => {
    serverReadyOk = r.status === 200
    serverReadyAt = Date.now()
    return serverReadyOk
  }).catch(() => {
    serverReadyOk = false
    serverReadyAt = Date.now()
    return false
  })
}

const emitOut = (lastStore, callId, out, sendFn) => {
  if (!out) return
  const prev = lastStore[callId]
  if (prev && prev.raw === out) return
  const masked = maskSecrets(out)
  let delta = ''
  if (prev && prev.masked && masked.indexOf(prev.masked) === 0) {
    delta = masked.slice(prev.masked.length)
  } else if (prev) {
    delta = '\n' + masked
  } else {
    delta = masked
  }
  if (delta) sendFn(delta)
  lastStore[callId] = { raw: out, masked: masked }
}

const toolOut = (out) => {
  if (out == null) return ''
  if (typeof out === 'string') return out
  if (Array.isArray(out)) {
    let buf = ''
    for (const o of out) {
      if (o == null) continue
      const seg = typeof o === 'string' ? o : (o.text != null ? (typeof o.text === 'string' ? o.text : JSON.stringify(o.text)) : null)
      if (seg == null) continue
      if (buf) buf += '\n'
      buf += seg
    }
    return buf
  }
  if (out.text != null) return typeof out.text === 'string' ? out.text : JSON.stringify(out.text)
  try { return JSON.stringify(out) } catch (e) { return String(out) }
}

const ensureServer = async () => {
  let pid = ''
  try {
    pid = $store.get('opencode_server_pid')
    if (pid && isAlive(pid) && (await serverReady())) return true
  } catch(e) {}
  if (await serverReady()) {
    try {
      const r = await execAsync(IS_WIN ? 'netstat -ano | findstr :14096' : 'lsof -t -iTCP:14096', 5000)
      const found = r.stdout
      const fpid = String(found).trim().split(/\s+/).pop()
      if (fpid && fpid !== pid) $store.set('opencode_server_pid', fpid)
    } catch(e) {}
    return true
  }
  try {
    const shell = process.env.COMSPEC || process.env.SHELL || (IS_WIN ? 'cmd.exe' : '/bin/sh')
    const shellArgs = IS_WIN ? ['/d', '/s', '/c', OC_BIN + ' serve --port 14096'] : ['-c', OC_BIN + ' serve --port 14096']
    const env = Object.assign({}, process.env, { NODE_OPTIONS: '--no-warnings' })
    const proc = spawn(shell, shellArgs, { detached: !IS_PAAS, stdio: 'ignore', windowsHide: true, env: env })
    serverProc = proc
    proc.on('exit', (code, signal) => {
      console.log('[opencode] server exited', code, signal)
      if (serverProc === proc) serverProc = null
      try { $store.set('opencode_server_pid', '') } catch(e) {}
    })
    if (IS_PAAS) proc.unref()
    $store.set('opencode_server_pid', String(proc.pid))
    const deadline = Date.now() + 15000
    while (Date.now() < deadline) {
      if (await serverReady(true)) return true
      await sleep(1000)
    }
    return false
  } catch(e) {
    return false
  }
}

const shutdownServer = () => {
  if (serverProc && !serverProc.killed) {
    try { serverProc.kill('SIGTERM') } catch(e) {}
  }
}
try {
  if (!process.__oc_shutdown_added) {
    process.__oc_shutdown_added = true
    process.on('SIGTERM', shutdownServer)
    process.on('SIGINT', shutdownServer)
    process.on('exit', shutdownServer)
  }
} catch(e) {}

const runProcs = {}

const parseModel = (modelStr) => {
  let pid = 'opencode', mid = ''
  if (modelStr) {
    const sl = modelStr.indexOf('/')
    if (sl > 0) { pid = modelStr.slice(0, sl); mid = modelStr.slice(sl + 1) }
    else mid = modelStr
  }
  return { pid: pid, mid: mid }
}

const ctxLimitMem = {}
const getCtxLimit = (modelStr) => {
  return new Promise((resolve) => {
    const pm = parseModel(modelStr)
    if (!pm.mid) return resolve(0)
    const memKey = pm.pid + '/' + pm.mid
    if (ctxLimitMem[memKey] > 0) return resolve(ctxLimitMem[memKey])
    const cacheKey = 'aichat_ctx_limit_' + pm.pid + '_' + pm.mid
    try {
      const cached = Number($store.get(cacheKey))
      if (cached > 0) { ctxLimitMem[memKey] = cached; return resolve(cached) }
    } catch(e) {}
    const httpMod = require('http')
    const req = httpMod.get({ host: '127.0.0.1', port: 14096, path: '/provider' }, (res) => {
      let buf = ''
      res.on('data', (c) => { buf += c })
      res.on('end', () => {
        try {
          const all = JSON.parse(buf).all || []
          for (let i = 0; i < all.length; i++) {
            const prov = all[i]
            if (prov.id === pm.pid && prov.models && prov.models[pm.mid] && prov.models[pm.mid].limit && prov.models[pm.mid].limit.context) {
              const limit = prov.models[pm.mid].limit.context
              ctxLimitMem[memKey] = limit
              try { $store.set(cacheKey, String(limit)) } catch(e2) {}
              return resolve(limit)
            }
          }
        } catch(e) {}
        resolve(0)
      })
    })
    req.on('error', () => { resolve(0) })
    req.setTimeout(8000, () => { req.destroy(); resolve(0) })
  })
}

$fend('ctxinfo', (data) => {
  const modelStr = data && data.model ? data.model : ''
  const pm = parseModel(modelStr)
  return getCtxLimit(modelStr).then((limit) => {
    return { model: pm.mid || '', limit: limit }
  })
})

const getSessionUsage = (sessionId) => {
  return new Promise((resolve) => {
    if (!sessionId) return resolve(0)
    const httpMod = require('http')
    let used = 0
    let usedTime = -1
    let offset = 0
    const LIMIT = 100
    const MAXPAGE = 20
    const fetchPage = () => {
      const req = httpMod.get({ host: '127.0.0.1', port: 14096, path: '/session/' + encodeURIComponent(sessionId) + '/message?limit=' + LIMIT + '&offset=' + offset }, (res) => {
        let buf = ''
        res.on('data', (c) => { buf += c })
        res.on('end', () => {
          let msgs
          try { msgs = JSON.parse(buf) } catch(e) { return resolve(used) }
          if (!Array.isArray(msgs) || !msgs.length) return resolve(used)
          for (let i = 0; i < msgs.length; i++) {
            const t = msgs[i].info && msgs[i].info.tokens ? msgs[i].info.tokens.total : 0
            const tm = msgs[i].time || msgs[i].created_at || 0
            if (tm >= usedTime && t > 0) { usedTime = tm; used = t }
          }
          if (msgs.length < LIMIT || offset >= MAXPAGE * LIMIT) return resolve(used)
          offset += msgs.length
          fetchPage()
        })
      })
      req.on('error', () => resolve(used))
      req.setTimeout(10000, () => { req.destroy(); resolve(used) })
    }
    fetchPage()
  })
}

$fend('session_ctx', (data) => {
  const id = data && data.id
  const modelStr = (data && data.model || '').replace(/\r/g, '')
  return getSessionUsage(id).then((used) => {
    return getCtxLimit(modelStr).then((limit) => {
      return { used: used, limit: limit }
    })
  })
})

const fetchSessionMessages = (sessionId) => {
  return new Promise((resolve) => {
    if (!sessionId) return resolve([])
    const httpMod = require('http')
    const req = httpMod.get({ host: '127.0.0.1', port: 14096, path: '/session/' + encodeURIComponent(sessionId) + '/message?limit=500' }, (res) => {
      let buf = ''
      res.on('data', (c) => { buf += c })
      res.on('end', () => {
        let msgs
        try { msgs = JSON.parse(buf) } catch(e) { return resolve([]) }
        if (!Array.isArray(msgs)) return resolve([])
        resolve(msgs)
      })
    })
    req.on('error', () => resolve([]))
    req.setTimeout(10000, () => { req.destroy(); resolve([]) })
  })
}

const msgTime = (m) => {
  const info = m && m.info || {}
  const t = info.time || {}
  return Number(t.created) || Number(m && (m.created_at || m.time)) || 0
}

const convSessionMessages = (msgs) => {
  const out = []
  let cur = null
  let curTokens = 0
  let curModel = ''
  let curErrored = false
  const finalize = () => {
    if (!cur) return
    let meta = curErrored ? '⚠ ' : '✓ '
    const bits = []
    if (curModel) bits.push(curModel)
    if (curTokens) bits.push('⚙ ' + curTokens + ' tokens')
    meta += bits.join(' | ')
    cur.meta = meta.trim() || '✓'
    cur.errored = curErrored
    cur.streaming = false
    cur = null
    curTokens = 0
    curModel = ''
    curErrored = false
  }
  for (let i = 0; i < msgs.length; i++) {
    const info = msgs[i].info || {}
    const role = info.role || 'assistant'
    const srcParts = msgs[i].parts || []
    if (role === 'user') {
      finalize()
      let text = ''
      for (let j = 0; j < srcParts.length; j++) {
        if (srcParts[j].type === 'text') text += (srcParts[j].text || '')
      }
      if (text.trim()) out.push({ role: 'user', content: text })
      continue
    }
    const parts = []
    for (let j = 0; j < srcParts.length; j++) {
      const p = srcParts[j]
      if (p.type === 'text' && p.text) {
        parts.push({ t: 'text', c: p.text })
      } else if (p.type === 'file') {
        parts.push({ t: 'ref', c: '▸ file ' + ((p.file && p.file.path) || ''), cls: 'info' })
      } else if (p.type === 'tool') {
        const st = p.state || {}
        const inp = st.input || {}
        const arg = toolArg(inp)
        const out2 = st.output || (st.metadata && st.metadata.output) || ''
        const toolName = p.tool || 'tool'
        const status = st.status || ''
        if (status === 'error') {
          parts.push({ t: 'ref', c: '✗ ' + toolName + (arg ? ' · ' + maskSecrets(arg) : ''), cls: 'tool' })
        } else if (status === 'completed') {
          parts.push({ t: 'ref', c: '◈ ' + toolName + (arg ? ' · ' + maskSecrets(arg) : ''), cls: 'tool' })
        }
        if (out2) parts.push({ t: 'out', c: maskSecrets(out2) })
      }
    }
    if (info.error) {
      parts.push({ t: 'text', c: 'Error: ' + ((info.error.message || info.error.name) || 'opencode error'), cls: 'err-text' })
    }
    if (!parts.length) continue
    if (!cur) {
      cur = { role: 'assistant', parts: [] }
      out.push(cur)
    }
    for (let k = 0; k < parts.length; k++) cur.parts.push(parts[k])
    if (info.error) curErrored = true
    if (info.tokens && info.tokens.total) curTokens = info.tokens.total
    if (info.modelID) curModel = (info.providerID || 'opencode') + '/' + info.modelID
  }
  finalize()
  return out
}

$fend('session_messages', (data) => {
  const id = data && data.id
  return ensureServer().then((ready) => {
    if (!ready) return { messages: [] }
    return fetchSessionMessages(id).then((msgs) => {
      msgs.sort((a, b) => msgTime(a) - msgTime(b))
      return { messages: convSessionMessages(msgs) }
    })
  }).catch(() => {
    return { messages: [] }
  })
})

const runWatchdogs = {}
const sseChat = (runId, obj) => {
  if (obj && obj.type !== 'done' && obj.type !== 'error') {
    const rw = runWatchdogs[runId]
    if (rw && typeof rw.kick === 'function') rw.kick()
  }
  $ws.sse('opencode-main', JSON.stringify(Object.assign({ runId: runId }, obj)))
}

const runCliMode = (data, runId) => {
  const prompt = data.prompt
  const sessionId = data.session || ''
  const modelStr = (data.model || '').replace(/\r/g, '')

  const args = ['run', '--format', 'json']
  if (sessionId) args.push('--session', sessionId)
  if (modelStr) args.push('--model', modelStr)
  args.push(prompt)

  let streamEnded = false
  let stepCount = 0
  let tokens = null
  let model = modelStr || null
  let knownSession = !!sessionId
  let seenSessionSent = false
  const seenTools = {}
  const lastToolOut = {}
  const runningTools = {}
  let toolSeq = 0
  const reasoningSeen = {}
  const reasoningKey = (id) => { return id || '_' }
  const reasonStart = (id) => {
    const k = reasoningKey(id)
    if (reasoningSeen[k] !== 'start' && reasoningSeen[k] !== 'done') {
      reasoningSeen[k] = 'start'
      sendRef('✱ reasoning', 'reasoning')
    }
  }
  const reasonDone = (id) => {
    const k = reasoningKey(id)
    if (reasoningSeen[k] !== 'done') {
      reasoningSeen[k] = 'done'
      sendRef('✓ reasoning done', 'reasoning')
    }
  }
  let watchdog = null
  let aliveTimer = null
  let toolHeartbeat = null
  const kickWatchdog = () => {
    if (watchdog) clearTimeout(watchdog)
    watchdog = setTimeout(() => {
      finish({ content: '', model: model, tokens: tokens, timeout: true })
    }, 600000)
  }

  const send = (type, payload) => {
    if (type !== 'done' && type !== 'error') kickWatchdog()
    sseChat(runId, Object.assign({ type: type }, payload || {}))
  }
  const sendRef = (line, cls) => {
    send('ref', { content: line, cls: cls || '' })
  }
  const pushCtx = (used, limit) => {
    send('ctx', {
      used: used || 0, limit: limit || 0,
      pct: limit ? Math.round((used || 0) / limit * 1000) / 10 : null,
      model: model
    })
  }
  const emitCtx = (used) => {
    if (!used) return
    getCtxLimit(model).then((limit) => { pushCtx(used, limit) }).catch(() => { pushCtx(used, 0) })
  }
  const finish = (payload) => {
    if (streamEnded) return
    streamEnded = true
    if (watchdog) clearTimeout(watchdog)
    if (aliveTimer) clearInterval(aliveTimer)
    if (toolHeartbeat) clearInterval(toolHeartbeat)
    try { proc.kill() } catch(e) {}
    send('done', Object.assign({ steps: stepCount }, payload || {}))
  }
  const fail = (msg) => {
    if (streamEnded) return
    streamEnded = true
    if (watchdog) clearTimeout(watchdog)
    if (aliveTimer) clearInterval(aliveTimer)
    if (toolHeartbeat) clearInterval(toolHeartbeat)
    try { proc.kill() } catch(e) {}
    send('error', { content: msg })
  }

  const handleEvent = (ev) => {
    const sid = ev.sessionID
    if (sid && !seenSessionSent) {
      seenSessionSent = true
      if (!knownSession) send('session', { id: sid })
    }
    const t = ev.type
    const part = ev.part || {}
    if (t === 'step_start') { stepCount++; return }
    if (t === 'step_finish') {
      if (part.tokens && part.tokens.total) {
        tokens = part.tokens
        emitCtx(part.tokens.total)
      }
      return
    }
    if (t === 'text') {
      if (part.text) send('text', { content: part.text })
      return
    }
    if (t === 'reasoning') { if (part.time && part.time.end) reasonDone(part.id); else reasonStart(part.id); return }
    if (t === 'file') { sendRef('▸ file ' + ((part.file && part.file.path) || ''), 'info'); return }
    if (t === 'tool_use') {
      const st = part.state || {}
      const inp = st.input || {}
      const arg = toolArg(inp)
      const callId = part.callID || part.id || (part.tool || 'tool') + '#' + (++toolSeq)
      const out = toolOut(st.output || (st.metadata && st.metadata.output))
      if (part.tool === 'question') {
        if (!seenTools[callId] && (st.status === 'pending' || st.status === 'running')) {
          seenTools[callId] = true
          sendRef('◈ question asked', 'tool')
        }
        return
      }
      if (st.status === 'pending' || st.status === 'running') {
        if (!seenTools[callId] && arg) {
          seenTools[callId] = true
          sendRef('◈ ' + (part.tool || 'tool') + ' · ' + maskSecrets(arg), 'tool')
        } else if (!seenTools[callId] && st.status === 'running') {
          seenTools[callId] = true
          sendRef('◈ ' + (part.tool || 'tool'), 'tool')
        }
        if (!runningTools[callId]) runningTools[callId] = { tool: part.tool || 'tool', arg: arg, started: Date.now() }
        if (out) runningTools[callId].lastOutput = out
        runningTools[callId].lastUpdate = Date.now()
        if (out) emitOut(lastToolOut, callId, out, (d) => { send('out', { content: d }) })
      } else if (st.status === 'completed') {
        delete runningTools[callId]
        if (!seenTools[callId]) {
          seenTools[callId] = true
          sendRef('◈ ' + (part.tool || 'tool') + (arg ? ' · ' + maskSecrets(arg) : ''), 'tool')
        }
        sendRef('✓ ' + (part.tool || 'tool') + ' done', 'tool')
        if (out) emitOut(lastToolOut, callId, out, (d) => { send('out', { content: d }) })
      } else if (st.status === 'error') {
        delete runningTools[callId]
        sendRef('✗ ' + (part.tool || 'tool') + ' failed', 'tool')
        if (out) emitOut(lastToolOut, callId, out, (d) => { send('out', { content: d }) })
      }
      return
    }
    if (t === 'todo') {
      send('todo', { data: part.todos || ev.todos || [] })
      return
    }
    if (t === 'error' || t === 'session_error') {
      const errObj = ev.error || part || {}
      const errMsg = (typeof errObj === 'string' ? errObj : (errObj.message || errObj.name || 'opencode error'))
      fail(String(errMsg).split('\n')[0])
      return
    }
  }

  const proc = spawn(OC_BIN, args, { env: Object.assign({}, process.env, { NODE_OPTIONS: '--no-warnings' }), windowsHide: true, shell: IS_WIN, stdio: ['ignore', 'pipe', 'pipe'] })
  runProcs[runId] = proc

  let buf = ''
  proc.stdout.setEncoding('utf8')
  proc.stdout.on('data', (chunk) => {
    buf += chunk
    let nl
    while ((nl = buf.indexOf('\n')) >= 0) {
      const line = buf.slice(0, nl)
      buf = buf.slice(nl + 1)
      if (!line.trim()) continue
      let ev
      try { ev = JSON.parse(line.trim()) } catch(e) { continue }
      try { handleEvent(ev) } catch(e) {}
    }
  })
  proc.stderr.on('data', (chunk) => {
    const t = stripAnsi(chunk.toString()).trim()
    if (t) console.log('[opencode run]', t)
  })

  toolHeartbeat = setInterval(() => {
    if (streamEnded) { clearInterval(toolHeartbeat); return }
    const now = Date.now()
    for (const id in runningTools) {
      const tool = runningTools[id]
      if (now - tool.lastUpdate > 10000) {
        sendRef('◈ ' + tool.tool + ' running (' + Math.floor((now - tool.started) / 1000) + 's)', 'tool')
        tool.lastUpdate = now
      }
      if (tool.lastOutput) emitOut(lastToolOut, id, tool.lastOutput, (d) => { send('out', { content: d }) })
    }
  }, 15000)

  proc.on('error', (e) => { fail(e.message || String(e)) })
  proc.on('close', (code) => {
    try { delete runProcs[runId] } catch(e) {}
    if (streamEnded) return
    if (code !== 0) fail('opencode exited with code ' + code)
    else finish({ content: '', model: model, tokens: tokens })
  })

  kickWatchdog()
  aliveTimer = setInterval(() => {
    try {
      if (typeof $ws.sseExists !== 'function' || $ws.sseExists('opencode-main')) return
      clearInterval(aliveTimer)
      aliveTimer = null
      try { proc.kill() } catch(e) {}
      fail('client disconnected')
    } catch(e) {}
  }, 15000)

  return { ok: true, runId: runId }
}

$fend('start', async (data) => {
  if (!data || !data.prompt) return { error: 'prompt is required' }
  const runId = data.runId || Date.now() + '-' + Math.random().toString(36).slice(2, 8)
  if (!(await ensureServer())) return runCliMode(data, runId)
  const prompt = data.prompt
  const httpMod = require('http')

  const api = (method, path, body) => {
    return new Promise((resolve, reject) => {
      const payload = body ? JSON.stringify(body) : ''
      const opts = {
        host: '127.0.0.1', port: 14096, path: path, method: method,
        headers: body ? { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(payload) } : {}
      }
      const req = httpMod.request(opts, (res) => {
        let buf = ''
        res.on('data', (c) => { buf += c })
        res.on('end', () => { resolve({ status: res.statusCode, body: buf }) })
      })
      req.on('error', reject)
      if (body) req.write(payload)
      req.end()
    })
  }

  const streamRun = (sessionId) => {
    ;(async () => {
    // 让前端立即拿到本次 run 使用的 sessionId。
    // 否则前端 sessionId 一直为空，done 后会误判为"首次对话"而 selectSession(sessions[0])，
    // 把刚流式生成的回复清空并加载成另一个会话的历史，表现为"看不到输出/切换会话错乱"。
    try { sseChat(runId, { type: 'session', id: sessionId }) } catch(e) {}
    try {
      let ctxLimit = 0
      getCtxLimit(data.model).then((l) => { if (l) ctxLimit = l }).catch(() => {})

      let streamEnded = false
      let model = null
      let modelShown = false
      let stepCount = 0
      const seenTools = {}
      const lastToolOut = {}
      const runningTools = {}
      let toolSeq = 0
      const reasoningSeen = {}
      const reasoningKey = (id) => { return id || '_' }
      const reasonStart = (id) => {
        const k = reasoningKey(id)
        if (reasoningSeen[k] !== 'start' && reasoningSeen[k] !== 'done') {
          reasoningSeen[k] = 'start'
          sendRef('✱ reasoning', 'reasoning')
        }
      }
      const reasonDone = (id) => {
        const k = reasoningKey(id)
        if (reasoningSeen[k] !== 'done') {
          reasoningSeen[k] = 'done'
          sendRef('✓ reasoning done', 'reasoning')
        }
      }
      let tokens = null
      let watchdog = null
      runWatchdogs[runId] = {
        kick: () => {
          if (watchdog) clearTimeout(watchdog)
          watchdog = setTimeout(() => {
            finish({ content: '', model: model, tokens: tokens, timeout: true })
          }, 600000)
        }
      }
      let aliveTimer = null
      let toolHeartbeat = null

      const pushCtx = (used, limit) => {
        sseChat(runId, {
          type: 'ctx', used: used || 0, limit: limit || 0,
          pct: limit ? Math.round((used || 0) / limit * 1000) / 10 : null,
          model: model
        })
      }

      const emitCtx = (used) => {
        if (!used) return
        if (ctxLimit) return pushCtx(used, ctxLimit)
        if (model) {
          getCtxLimit(model).then((limit) => {
            if (limit) ctxLimit = limit
            pushCtx(used, ctxLimit)
          })
          return
        }
        pushCtx(used, 0)
      }

      const es = httpMod.get({
        host: '127.0.0.1', port: 14096, path: '/event',
        headers: { 'Accept': 'text/event-stream' }
      }, (res) => {
        let buf = ''
        res.setEncoding('utf8')
        res.on('data', (chunk) => {
          buf += chunk
          let idx
          while ((idx = buf.indexOf('\n\n')) >= 0) {
            const frame = buf.slice(0, idx)
            buf = buf.slice(idx + 2)
            const match = frame.match(/^data:\s*(.+)$/m)
            if (!match) continue
            let ev
            try { ev = JSON.parse(match[1].trim()) } catch(e) { continue }
            try { handleEvent(ev) } catch(e) {}
          }
        })
        const streamClosed = () => {
          if (streamEnded) return
          finish({ content: '', model: model, tokens: tokens })
        }
        res.on('end', streamClosed)
        res.on('close', streamClosed)
      })
      toolHeartbeat = setInterval(() => {
        if (streamEnded) {
          clearInterval(toolHeartbeat)
          return
        }
        const now = Date.now()
        for (const id in runningTools) {
          const tool = runningTools[id]
          if (now - tool.lastUpdate > 10000) {
            const elapsed = Math.floor((now - tool.started) / 1000)
            sendRef('◈ ' + tool.tool + ' running (' + elapsed + 's)', 'tool')
            tool.lastUpdate = now
          }
if (tool.lastOutput) emitOut(lastToolOut, id, tool.lastOutput, (d) => { sseChat(runId, { type: 'out', content: d }) })
    }
  }, 15000)
      const sendRef = (line, cls) => {
        sseChat(runId, { type: 'ref', content: line, cls: cls || '' })
      }

      const finish = (payload) => {
        if (streamEnded) return
        streamEnded = true
        delete runWatchdogs[runId]
        if (watchdog) clearTimeout(watchdog)
        if (aliveTimer) clearInterval(aliveTimer)
        if (toolHeartbeat) clearInterval(toolHeartbeat)
        try { es.destroy() } catch(e) {}
        sseChat(runId, Object.assign({ type: 'done', steps: stepCount }, payload || {}))
      }

      const fail = (msg) => {
        if (streamEnded) return
        streamEnded = true
        delete runWatchdogs[runId]
        if (watchdog) clearTimeout(watchdog)
        if (aliveTimer) clearInterval(aliveTimer)
        if (toolHeartbeat) clearInterval(toolHeartbeat)
        try { es.destroy() } catch(e) {}
        sseChat(runId, { type: 'error', content: msg })
      }

      es.on('error', (e) => {
        fail('SSE error: ' + e.message)
      })

      const handleEvent = (ev) => {
        const p = ev.properties || {}
        if (ev.type === 'question.asked') {
          const qsid = p.sessionID
          if (qsid && sessionId && qsid !== sessionId) return
          sseChat(runId, { type: 'question', data: { requestID: p.id, sessionID: p.sessionID, questions: p.questions || [], tool: p.tool || null } })
          return
        }
        if (ev.type === 'question.replied' || ev.type === 'question.rejected') {
          if (p.sessionID && sessionId && p.sessionID !== sessionId) return
          sseChat(runId, { type: 'question_done', data: { requestID: p.requestID } })
          return
        }
        if (ev.type === 'permission.v2.asked' || ev.type === 'permission.asked') {
          const pd = ev.data || ev.properties || {}
          const permId = pd.id || pd.requestID
          if (pd.sessionID && sessionId && pd.sessionID !== sessionId) return
          if (permId) {
            const res = pd.resources || pd.patterns || []
            const resList = Array.isArray(res) ? res.map(String) : [String(res)]
            sendRef('🔒 permission · ' + (pd.action || pd.permission || 'request') + (resList.length ? ' · ' + resList.join(', ') : ''), 'permission')
            sseChat(runId, { type: 'permission', data: { requestID: permId, sessionID: pd.sessionID, action: pd.action || pd.permission || '', resources: resList, metadata: pd.metadata || null, source: pd.source || null, legacy: ev.type === 'permission.asked' } })
          }
          return
        }
        if (ev.type === 'permission.v2.replied' || ev.type === 'permission.replied') {
          const pd = ev.data || ev.properties || {}
          if (pd.sessionID && sessionId && pd.sessionID !== sessionId) return
          sseChat(runId, { type: 'permission_done', data: { requestID: pd.requestID || pd.id, reply: pd.reply || '' } })
          return
        }
        if (ev.type === 'message.part.delta') {
          if (p.field === 'text' && p.delta) {
            sseChat(runId, { type: 'text', content: p.delta })
          } else if (p.field === 'reasoning' && p.delta) {
            reasonStart(p.partID)
          }
          return
        }
        if (ev.type === 'message.part.updated') {
          const part = p.part || {}
          const sid2 = part.sessionID || p.sessionID || ev.sessionID
          if (sid2 && sid2 !== sessionId) return
          if (part.type === 'step-start') {
            stepCount++
            return
          }
          if (part.type === 'step-finish') {
            if (part.tokens && part.tokens.total) emitCtx(part.tokens.total)
            return
          }
          if (part.type === 'reasoning') {
            if (part.time && part.time.end) reasonDone(part.id)
            else reasonStart(part.id)
            return
          }
          if (part.type === 'file') {
            sendRef('▸ file ' + ((part.file && part.file.path) || ''), 'info')
            return
          }
          if (part.type === 'tool') {
            const st = part.state || {}
            const inp = st.input || {}
            const arg = toolArg(inp)
            const callId = part.callID || part.id || (part.tool || 'tool') + '#' + (++toolSeq)
            const out = toolOut(st.output || (st.metadata && st.metadata.output))
            if (part.tool === 'question') {
              if (!seenTools[callId] && (st.status === 'pending' || st.status === 'running')) {
                seenTools[callId] = true
                sendRef('◈ question asked', 'tool')
              }
              return
            }
            if (st.status === 'pending' || st.status === 'running') {
              if (!seenTools[callId] && arg) {
                seenTools[callId] = true
                sendRef('◈ ' + (part.tool || 'tool') + ' · ' + maskSecrets(arg), 'tool')
              } else if (!seenTools[callId] && st.status === 'running') {
                seenTools[callId] = true
                sendRef('◈ ' + (part.tool || 'tool'), 'tool')
              }
              if (!runningTools[callId]) runningTools[callId] = { tool: part.tool || 'tool', arg: arg, started: Date.now() }
              if (out) runningTools[callId].lastOutput = out
              runningTools[callId].lastUpdate = Date.now()
              if (out) emitOut(lastToolOut, callId, out, (d) => { sseChat(runId, { type: 'out', content: d }) })
            } else if (st.status === 'completed') {
              delete runningTools[callId]
              if (!seenTools[callId]) {
                seenTools[callId] = true
                sendRef('◈ ' + (part.tool || 'tool') + (arg ? ' · ' + maskSecrets(arg) : ''), 'tool')
              }
              sendRef('✓ ' + (part.tool || 'tool') + ' done', 'tool')
              if (out) emitOut(lastToolOut, callId, out, (d) => { sseChat(runId, { type: 'out', content: d }) })
            } else if (st.status === 'error') {
              delete runningTools[callId]
              sendRef('✗ ' + (part.tool || 'tool') + ' failed', 'tool')
              if (out) emitOut(lastToolOut, callId, out, (d) => { sseChat(runId, { type: 'out', content: d }) })
            }
            return
          }
        }
        if (ev.type === 'message.updated') {
          const info = p.info || {}
          if (info.role === 'assistant' && info.error) {
            fail((info.error.name ? info.error.name + ': ' : '') + (info.error.message || 'opencode error'))
          }
          if (info.model && info.model.modelID) {
            model = info.model.providerID + '/' + info.model.modelID
            if (!modelShown) {
              modelShown = true
              sendRef('> build · ' + model, 'info')
              if (!ctxLimit) {
                getCtxLimit(model).then((limit) => {
                  if (limit) ctxLimit = limit
                  pushCtx(0, ctxLimit)
                })
              }
            }
          }
          return
        }
        if (ev.type === 'session.status') {
          let status = p.status
          if (typeof status === 'object' && status) status = status.type
          if (status === 'idle') {
            finish({ content: '', model: model, tokens: tokens })
          } else if (status === 'retry') {
            sendRef('↻ retrying…', 'info')
          }
          return
        }
        if (ev.type === 'session.idle') {
          finish({ content: '', model: model, tokens: tokens })
          return
        }
        if (ev.type === 'session.error') {
          const errObj = p.error || {}
          const errMsg = errObj.message || (errObj.name ? errObj.name : '') || 'session error'
          const errCode = errObj.code ? ' (' + errObj.code + ')' : ''
          let errDetail = errObj.detail || errObj.stack || ''
          if (errDetail) errDetail = String(errDetail).split('\n')[0]
          fail((errMsg + errCode + (errDetail ? ': ' + errDetail : '')).trim())
          return
        }
        if (ev.type === 'session.compacted') {
          sendRef('↻ context compacted', 'info')
          return
        }
        if (ev.type === 'todo.updated') {
          sseChat(runId, { type: 'todo', data: p.todos || [] })
          return
        }
        if (ev.type === 'session.next.tool.success') {
          const op = p.outputPaths
          if (op && op.length) sendRef('↧ wrote ' + op.join(', '), 'tool')
          return
        }
        if (ev.type === 'session.next.step.ended') {
          if (p.tokens) {
            tokens = p.tokens
            if (p.tokens.total) emitCtx(p.tokens.total)
          }
          return
        }
      }

      if (/^\//.test(prompt)) {
        runWatchdogs[runId].kick()
        const cmdLine = prompt.trim().slice(1)
        const cmdSpace = cmdLine.indexOf(' ')
        const cmdName = (cmdSpace >= 0 ? cmdLine.slice(0, cmdSpace) : cmdLine).toLowerCase()
        const cmdArgs = cmdSpace >= 0 ? cmdLine.slice(cmdSpace + 1).trim() : ''
        try {
          if (cmdName === 'compact' || cmdName === 'summarize') {
            let sumBody = { providerID: 'opencode', modelID: 'deepseek-v4-flash-free' }
            if (data.model) {
              const mm = data.model.replace(/\r/g, '')
              const ms = mm.indexOf('/')
              if (ms > 0) sumBody = { providerID: mm.slice(0, ms), modelID: mm.slice(ms + 1) }
            }
            const sum = await api('POST', '/session/' + sessionId + '/summarize', sumBody)
            if (sum.status !== 200) {
              fail('compact failed: ' + sum.body.slice(0, 120))
            } else {
              sendRef('✂ context compacted', 'info')
              finish({ content: '', model: model, tokens: tokens })
            }
          } else if (cmdName === 'undo' || cmdName === 'redo') {
            const msgs = await api('GET', '/session/' + sessionId + '/message?limit=2')
            let arr = []
            try { arr = JSON.parse(msgs.body) } catch(e) {}
            let target = null
            for (let mi = arr.length - 1; mi >= 0; mi--) {
              const minf = arr[mi].info || {}
              if (minf.role === 'user') { target = minf.id; break }
            }
            if (!target) {
              fail('no message to ' + cmdName)
            } else {
              const rev = await api('POST', '/session/' + sessionId + '/' + (cmdName === 'undo' ? 'revert' : 'unrevert'), { messageID: target })
              if (rev.status !== 200) {
                fail(cmdName + ' failed: ' + rev.body.slice(0, 120))
              } else {
                sendRef(cmdName + ' ' + target.slice(0, 8), 'info')
                finish({ content: '', model: model, tokens: tokens })
              }
            }
          } else {
            api('POST', '/session/' + sessionId + '/command', { command: cmdName, arguments: cmdArgs, agent: 'build' }).then((r) => {
              if (streamEnded) return
              if (r.status >= 400) fail('/' + cmdName + ' failed: ' + r.body.slice(0, 120))
            }).catch((e) => {
              if (!streamEnded) fail('/' + cmdName + ' error: ' + e.message)
            })
          }
        } catch(e) {
          fail(e.message || String(e))
        }
        return
      }

      const body = { parts: [{ type: 'text', text: prompt }] }
      if (data.model) {
        const m = data.model.replace(/\r/g, '')
        const slash = m.indexOf('/')
        if (slash > 0) body.model = { providerID: m.slice(0, slash), modelID: m.slice(slash + 1) }
      }
      const sent = await api('POST', '/session/' + sessionId + '/prompt_async', body)
      if (sent.status === 404) {
        fail('session not found: ' + sessionId)
        return
      }
      runWatchdogs[runId].kick()
      aliveTimer = setInterval(() => {
        try {
          if (typeof $ws.sseExists !== 'function' || $ws.sseExists('opencode-main')) return
          clearInterval(aliveTimer)
          aliveTimer = null
          const ab = httpMod.request({
            host: '127.0.0.1', port: 14096,
            path: '/session/' + encodeURIComponent(sessionId) + '/abort',
            method: 'POST'
          }, (r) => {
            r.resume()
            r.on('end', () => { fail('client disconnected') })
          })
          ab.on('error', () => { fail('client disconnected') })
          ab.end()
        } catch(e) {}
      }, 15000)
    } catch(e) {
      fail(e.message || String(e))
    }
    })()
  }

  return (async () => {
    let sessionId = data.session || ''
    try {
      const title = String(prompt || '').replace(/\s+/g, ' ').trim().slice(0, 60)
      if (!sessionId) {
        const created = await api('POST', '/session', { title: title })
        if (created.status !== 200) throw new Error('create session failed: ' + created.body.slice(0, 120))
        sessionId = JSON.parse(created.body).id
      } else if (title) {
        api('GET', '/session/' + sessionId).then((got) => {
          let cur = ''
          try { cur = (JSON.parse(got.body) || {}).title || '' } catch(e) {}
          if (!cur) api('PATCH', '/session/' + sessionId, { title: title })
        }).catch(() => {})
      }
      // 新建/改标题后会话列表变化，立即失效缓存让下拉列表尽快显示新 title
      try { $store.set('aichat_oc_sessions_cache', '') } catch(e) {}
      try { $store.set('aichat_oc_sessions_time', '0') } catch(e) {}
      streamRun(sessionId)
      return { ok: true, runId: runId, sessionId: sessionId }
    } catch(e) {
      return { ok: false, error: e.message || String(e) }
    }
  })()
})

$fend('commands', async (data) => {
  const out = [
    { name: 'compact', description: 'compact the current conversation (via summarize)' },
    { name: 'new', description: 'start a new session' },
    { name: 'undo', description: 'undo last message' },
    { name: 'redo', description: 'redo last undone message' }
  ]
  try {
    const r = await httpGet('/command')
    let list = []
    try { list = JSON.parse(r.body) } catch(e) {}
    if (Array.isArray(list)) {
      for (let i = list.length - 1; i >= 0; i--) {
        out.unshift({ name: list[i].name || '', description: list[i].description || '' })
      }
    }
  } catch(e) {}
  return { ok: true, commands: out }
})

$fend('stop', async (data) => {
  if (!data) return { ok: false }
  const runId = data.runId
  const sessionId = data.session || ''
  const rp = runProcs[runId]
  if (rp) {
    try {
      if (IS_WIN) await execAsync('taskkill /PID ' + rp.pid + ' /T /F', 5000)
      else rp.kill('SIGTERM')
    } catch(e) {
      try { rp.kill() } catch(e2) {}
    }
    try { delete runProcs[runId] } catch(e) {}
    return { ok: true, mode: 'run' }
  }
  try {
    if (!sessionId) return { ok: false, error: 'no active session' }
    const httpMod = require('http')
    return new Promise((resolve, reject) => {
      const req = httpMod.request({
        host: '127.0.0.1', port: 14096,
        path: '/session/' + encodeURIComponent(sessionId) + '/abort',
        method: 'POST'
      }, (res) => {
        res.resume()
        res.on('end', () => { resolve({ ok: res.statusCode === 200, code: res.statusCode }) })
      })
      req.on('error', (e) => { reject(e) })
      req.end()
    })
  } catch(e) {
    return { ok: false, error: e.message }
  }
})

$fend('ensure_opencode', async (data) => {
  const runId = data && data.installId
  try {
    const v = await execAsync(redirCmd(OC_BIN + ' --version'), 10000)
    const version = v.stdout.trim()
    console.log('[ensure_opencode] version:', version)
    if (version) {
      if (runId) $ws.sse(runId, JSON.stringify({ type: 'done', version: version }))
      return { ok: true, installing: false, version: version }
    }
  } catch(e) {}
  if (!runId) return { error: 'no installId' }
  try {
    const freeMem = require('os').freemem()
    const freeMB = Math.round(freeMem / 1024 / 1024)
    if (freeMem < 1024 * 1024 * 1024) {
      const msg = '当前可用内存 ' + freeMB + 'M，内存过小，opencode 无法使用'
      console.log('[ensure_opencode] memory too low:', freeMB + 'M')
      $ws.sse(runId, JSON.stringify({ type: 'error', content: msg }))
      return { ok: false, error: msg }
    }
    const proc = spawn(process.platform === 'win32' ? process.env.COMSPEC : 'sh',
      process.platform === 'win32' ? ['/d', '/s', '/c', 'npm install -g opencode-ai@latest 2>&1'] : ['-c', 'npm install -g opencode-ai@latest 2>&1'],
      { timeout: 120000, windowsHide: true, stdio: ['ignore', 'pipe', 'pipe'] })
    const sendProgress = (text) => {
      const lines = stripAnsi(text.toString()).split('\n').filter(Boolean)
      for (let i = 0; i < lines.length; i++) {
        console.log('[npm install]', lines[i].trim())
        $ws.sse(runId, JSON.stringify({ type: 'progress', content: lines[i].trim() }))
      }
    }
    proc.stdout.on('data', sendProgress)
    proc.stderr.on('data', sendProgress)
    proc.on('close', async (code) => {
      try {
        if (code === 0) {
          const ver = await execAsync(redirCmd(OC_BIN + ' --version'), 10000)
          const version = ver.stdout.trim() || 'unknown'
          console.log('[npm install] done, version:', version)
          $ws.sse(runId, JSON.stringify({ type: 'done', version: version }))
        } else {
          $ws.sse(runId, JSON.stringify({ type: 'error', content: 'npm install failed (code ' + code + ')' }))
        }
      } catch(e) {
        $ws.sse(runId, JSON.stringify({ type: 'error', content: e.message }))
      }
    })
    proc.on('error', (e) => {
      $ws.sse(runId, JSON.stringify({ type: 'error', content: e.message }))
    })
    return { ok: true, installing: true }
  } catch(e) {
    $ws.sse(runId, JSON.stringify({ type: 'error', content: e.message }))
    return { ok: true, installing: true }
  }
})

$fend('models', async () => {
  const now = Date.now()
  let cached, cachedTime
  try { cached = JSON.parse($store.get('aichat_models_cache') || 'null') } catch(e) {}
  try { cachedTime = Number($store.get('aichat_models_time') || 0) } catch(e) {}
  if (cached && now - cachedTime < 60000) return { models: cached, cached: true }
  if (cached) {
    try {
      const r = await execAsync(redirCmd(OC_BIN + ' models'), 10000)
      const raw = r.stdout
      console.log('[models cached-refresh] raw:', raw.trim())
      if (raw && raw.trim()) {
        const list = raw.trim().split('\n').filter(Boolean).map((s) => { return s.trim() })
        $store.set('aichat_models_cache', JSON.stringify(list))
        $store.set('aichat_models_time', String(Date.now()))
        return { models: list }
      }
    } catch(e) {}
    return { models: cached }
  }
  try {
    const r = await execAsync(redirCmd(OC_BIN + ' models'), 10000)
    const raw = r.stdout
    console.log('[models] raw:', raw.trim())
    if (!raw || !raw.trim()) return { models: [] }
    const list = raw.trim().split('\n').filter(Boolean).map((s) => { return s.trim() })
    $store.set('aichat_models_cache', JSON.stringify(list))
    $store.set('aichat_models_time', String(now))
    return { models: list }
  } catch(e) {
    return { models: cached || [] }
  }
})

$fend('sessions', () => {
  try {
    const raw = $store.get('aichat_sessions') || '[]'
    const local = JSON.parse(raw)
    const raw2 = $store.get('aichat_pinned_sessions') || '[]'
    const pinned = JSON.parse(raw2)
    return { sessions: local, pinned: pinned }
  } catch(e) {
    return { sessions: [], pinned: [] }
  }
})

$fend('delete_session', (data) => {
  if (!data || !data.id) return { ok: false }
  try {
    const raw = $store.get('aichat_sessions') || '[]'
    let list = JSON.parse(raw)
    list = list.filter((s) => { return s.id !== data.id })
    $store.set('aichat_sessions', JSON.stringify(list))
    return { ok: true }
  } catch(e) {
    return { ok: false, error: e.message }
  }
})

$fend('opencode_sessions', async () => {
  const now = Date.now()
  let cached, cachedTime
  try { cached = JSON.parse($store.get('aichat_oc_sessions_cache') || 'null') } catch(e) {}
  try { cachedTime = Number($store.get('aichat_oc_sessions_time') || 0) } catch(e) {}

  // 用 opencode 服务器的 GET /session 获取会话列表（与聊天同一批会话），
  // 不要用 CLI `opencode session list` —— 它的 cwd 作用域(script/Shell)和服务器目录不一致，列表对不上。
  if (cached && now - cachedTime < 15000) return { sessions: cached, cached: true }
  const sessions = await httpGet('/session', 14096, 8000).then((r) => {
    if (r.status !== 200 || !r.body || !r.body.trim()) return null
    try {
      const list = JSON.parse(r.body)
      if (!Array.isArray(list)) return null
      // 兼容服务器格式：updated/created 在 s.time 里，补齐到顶层供前端 fmtTime 使用
      list.forEach((s) => {
        if (s.time) {
          if (!s.updated && s.time.updated) s.updated = s.time.updated
          if (!s.created && s.time.created) s.created = s.time.created
        }
      })
      return list
    } catch(e) { return null }
  })
  if (sessions) {
    $store.set('aichat_oc_sessions_cache', JSON.stringify(sessions))
    $store.set('aichat_oc_sessions_time', String(Date.now()))
    return { sessions: sessions }
  }
  if (cached) return { sessions: cached }
  return { sessions: [] }
})

$fend('opencode_delete_session', async (data) => {
  if (!data || !data.id) return { ok: false }
  try {
    await execAsync(redirCmd(OC_BIN + ' session delete ' + data.id), 10000)
    try { $store.set('aichat_oc_sessions_cache', '') } catch(e2) {}
    try { $store.set('aichat_oc_sessions_time', '0') } catch(e2) {}
    return { ok: true }
  } catch(e) {
    return { ok: false, error: e.message }
  }
})

const ocPost = (path, body) => {
  return new Promise((resolve, reject) => {
    const httpMod = require('http')
    const payload = body ? JSON.stringify(body) : ''
    const req = httpMod.request({
      host: '127.0.0.1', port: 14096, path: path, method: 'POST',
      headers: body ? { 'Content-Type': 'application/json', 'Content-Length': Buffer.byteLength(payload) } : {}
    }, (res) => {
      let buf = ''
      res.on('data', (c) => { buf += c })
      res.on('end', () => { resolve({ status: res.statusCode, body: buf }) })
    })
    req.on('error', reject)
    req.setTimeout(8000, () => { req.destroy(); reject(new Error('timeout')) })
    if (body) req.write(payload)
    req.end()
  })
}

$fend('question_reply', async (data) => {
  if (!data || !data.requestID || !Array.isArray(data.answers)) return { ok: false, error: 'invalid params' }
  try {
    const r = await ocPost('/question/' + encodeURIComponent(data.requestID) + '/reply', { answers: data.answers })
    if (r.status !== 200) return { ok: false, error: r.body.slice(0, 200) }
    return { ok: true }
  } catch(e) {
    return { ok: false, error: e.message }
  }
})

$fend('question_reject', async (data) => {
  if (!data || !data.requestID) return { ok: false, error: 'invalid params' }
  try {
    const r = await ocPost('/question/' + encodeURIComponent(data.requestID) + '/reject')
    if (r.status !== 200) return { ok: false, error: r.body.slice(0, 200) }
    return { ok: true }
  } catch(e) {
    return { ok: false, error: e.message }
  }
})

$fend('permission_reply', async (data) => {
  if (!data || !data.requestID) return { ok: false, error: 'invalid params' }
  const reply = ['once', 'always', 'reject'].indexOf(data.reply) >= 0 ? data.reply : ''
  if (!reply) return { ok: false, error: 'invalid reply' }
  try {
    const path = data.legacy
      ? '/permission/' + encodeURIComponent(data.requestID) + '/reply'
      : '/api/session/' + encodeURIComponent(data.sessionID || '') + '/permission/' + encodeURIComponent(data.requestID) + '/reply'
    const r = await ocPost(path, { reply: reply, message: data.message || '' })
    if (r.status !== 200) return { ok: false, error: r.body.slice(0, 200) }
    return { ok: true }
  } catch(e) {
    return { ok: false, error: e.message }
  }
})
</script>

</body>
</html>

