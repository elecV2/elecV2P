<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
  <title>Pi.efh By elecV2</title>
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/vue@3/dist/vue.global.prod.js"></script>
  <style>
    :root {
      --bk: #0d1117; --bk2: #161b22; --bk3: #1c2128;
      --fc: #e6edf3; --fc2: #7d8590; --fc3: #484f58;
      --ac: #58a6ff; --ok: #3fb950; --del: #f85149;
      --bd: #30363d; --code-bk: #0d1117;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font: 14px/1.6 -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background: var(--bk); color: var(--fc); height: 100vh;
      display: flex; flex-direction: column; overflow: hidden;
    }
    #app { flex: 1; display: flex; flex-direction: column; min-height: 0; }
    .header {
      display: flex; align-items: center; gap: 12px; padding: 12px 22px; position: relative;
      background: transparent; border-bottom: 1px solid var(--bd); flex-shrink: 0;
      flex-wrap: nowrap;
      min-width: 0;
    }
    .header h1 { font-size: 16px; color: var(--ac); white-space: nowrap; cursor: pointer; flex-shrink: 0; }
    .header h1:hover { opacity: .8; }
    .header .spacer { flex: 1; min-width: 0; }
    .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--ok); display: inline-block; }
    .dot.run { background: var(--ac); animation: pulse 1s infinite; }
    @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:.3} }
    .header button {
      padding: 5px 12px; border-radius: 7px; border: 1px solid var(--bd);
      background: var(--bk3); color: var(--fc2); font-size: 12px; cursor: pointer;
    }
    .header button:hover { color: var(--fc); border-color: var(--fc3); }
    .header .provider-btn {
      display: inline-flex; align-items: center; gap: 6px;
      border-color: rgba(88,166,255,.45); background: rgba(88,166,255,.08);
      color: var(--ac); font-weight: 600;
    }
    .header .provider-btn:hover { border-color: var(--ac); background: rgba(88,166,255,.16); color: #79b8ff; }
    .header .provider-btn .pc-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--ok); flex-shrink: 0; }
    .header .provider-btn .pc-dot.none { background: var(--fc3); }
    .header .dropdown-trigger { font-size: 12px; color: var(--fc2); cursor: pointer; position: relative; white-space: nowrap; }
    .header .dropdown-trigger b { color: var(--ok); }
    .header .dropdown-trigger:hover b { text-decoration: underline; }
    .header .dropdown-trigger .arr { font-size: 8px; margin-left: 2px; }
    .header .dropdown-trigger + .dropdown-trigger { margin-left: 24px; }
    .header .ver { font-size: 10px; color: var(--fc3); margin-left: 4px; white-space: nowrap; }
    .ctx {
      display: inline-flex; align-items: center; gap: 6px;
      margin-right: 12px; font-size: 11px; color: var(--fc2); white-space: nowrap;
      cursor: default; border: 1px solid var(--bd); border-radius: 8px; padding: 2px 8px;
      background: transparent;
    }
    .ctx-bar { width: 56px; height: 5px; border-radius: 3px; background: var(--bd); overflow: hidden; }
    .ctx-bar i { display: block; height: 100%; background: var(--ac); border-radius: 3px; }
    .ctx-bar.warn i { background: #e3b341; }
    .ctx-bar.danger i { background: var(--del); }
    .ctx-num { font-family: 'Cascadia Code', Consolas, monospace; }
    .header .compact-btn {
      display: inline-flex; align-items: center; gap: 5px;
      padding: 4px 10px; border-radius: 7px; font-size: 12px;
      border: 1px solid var(--bd); background: transparent;
      color: var(--fc2); cursor: pointer; white-space: nowrap; flex-shrink: 0;
      transition: all .15s;
    }
    .header .compact-btn:hover:not(:disabled) {
      border-color: var(--fc3); background: transparent; color: var(--fc);
    }
    .header .compact-btn:disabled { opacity: .55; cursor: not-allowed; }
    /* 当 token 使用比例 >= 60% 时才用绿色高亮，低于 60% 保持默认灰色 */
    .header .compact-btn.highlight-green {
      border-color: rgba(63,185,80,.4); background: rgba(63,185,80,.08);
      color: var(--ok);
    }
    .header .compact-btn.highlight-green:hover:not(:disabled) {
      border-color: var(--ok); background: rgba(63,185,80,.18); color: #56d364;
    }
    .header .compact-btn.busy { border-color: var(--ac); background: rgba(88,166,255,.10); color: var(--ac); }
    .header .theme-btn {
      display: inline-flex; align-items: center; justify-content: center;
      padding: 4px 16px; margin-left: 18px; border-radius: 7px; font-size: 12px;
      border: 1px solid var(--bd); background: transparent;
      color: var(--fc); cursor: pointer; white-space: nowrap; flex-shrink: 0;
      transition: all .15s;
    }
    .header .theme-btn:hover {
      border-color: var(--fc3); background: transparent; color: var(--fc);
    }
    .header .theme-btn .theme-icon {
      font-size: 11px;
    }
    .header .load { position: absolute; left: 50%; transform: translateX(-50%); font-size: 22px; color: var(--ac); letter-spacing: 4px; animation: loadPulse 1.2s ease-in-out infinite; pointer-events: none; }
    @keyframes loadPulse { 0%,100% { opacity: .25; } 50% { opacity: 1; } }
    /* 移动端适配：强制 header 不换行，内容收缩到一行，dropdown 完整显示在 header 下方 */
    @media (max-width: 640px) {
      .header { flex-wrap: nowrap !important; gap: 3px; padding: 6px 8px; }
      .header h1 { font-size: 12px; flex-shrink: 0; }
      .header .ver { display: none; }
      .header .dot { width: 5px; height: 5px; flex-shrink: 0; }
      .header .provider-btn { padding: 2px 5px; font-size: 10px; gap: 3px; flex-shrink: 1; min-width: 0; max-width: 65px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .header .provider-btn .pc-dot { width: 4px; height: 4px; flex-shrink: 0; }
      .header .dropdown-trigger { font-size: 10px; flex-shrink: 1; min-width: 0; max-width: 60px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .header .dropdown-trigger b { font-weight: 500; }
      .header .dropdown-trigger + .dropdown-trigger { margin-left: 4px; }
      .header .dropdown-trigger .arr { font-size: 7px; margin-left: 1px; }
      .header .theme-btn { margin-left: 3px; padding: 2px 6px; flex-shrink: 0; }
      .header .theme-btn .theme-icon { font-size: 10px; }
      .header .spacer { flex: 1 1 0; min-width: 0; }
      .ctx { margin-right: 0; padding: 1px 4px; flex-shrink: 0; }
      .ctx-bar { display: none; }
      .ctx-num { font-size: 9px; }
      .header .compact-btn { padding: 2px 6px; font-size: 10px; flex-shrink: 0; }
    }
    .dropdown {
      position: absolute; top: 100%; left: 0; margin-top: 4px;
      background: var(--bk2); background: color-mix(in srgb, var(--bk2) 32%, transparent);
      border: 1px solid var(--bd); border-radius: 8px;
      min-width: 260px; max-height: 350px; overflow-y: hidden; z-index: 200; display: none; flex-direction: column;
      box-shadow: 0 8px 24px rgba(0,0,0,.4); display: none;
      backdrop-filter: blur(8px) saturate(1.3); -webkit-backdrop-filter: blur(8px) saturate(1.3);
    }
    /* 移动端：dropdown 改用 fixed 定位，完全脱离 header 布局影响 */
    @media (max-width: 640px) {
      .dropdown { position: fixed; top: 50px; left: 8px; right: 8px; min-width: 0; width: auto; max-height: min(500px, 70vh); overflow-y: auto; }
    }
    .dropdown.show { display: flex; }
    .dropdown .d-item {
      padding: 7px 12px; cursor: pointer; border-bottom: 1px solid var(--bd);
      transition: background .15s;
    }
    .dropdown .d-item:last-child { border-bottom: none; }
    .dropdown .d-item:hover { background: var(--bk3); background: color-mix(in srgb, var(--bk3) 55%, transparent); }
    .dropdown .d-item.active, .dropdown .d-item.nav { background: var(--bk3); background: color-mix(in srgb, var(--bk3) 55%, transparent); border-left: 3px solid var(--ac); }
    .dropdown .d-item .d-title { font-size: 13px; color: var(--fc); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .dropdown .d-item .d-sub { font-size: 10px; color: var(--fc3); }
    .dropdown .d-empty { padding: 20px; text-align: center; color: var(--fc3); font-size: 12px; }
    .dropdown .d-more { padding: 8px 12px; text-align: center; font-size: 12px; color: var(--ac); cursor: pointer; border-top: 1px solid var(--bd); }
    .dropdown .d-more:hover { background: var(--bk3); background: color-mix(in srgb, var(--bk3) 55%, transparent); }
    .dropdown .d-foot { position: relative; padding: 7px 12px; text-align: center; font-size: 11px; color: var(--fc3); border-top: 1px solid var(--bd); background: transparent; }
    .dropdown .d-list { overflow-y: auto; flex: 1; min-height: 0; }
    .messages { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 12px; min-height: 0; }
    .welcome { color: var(--fc2); text-align: center; margin: auto; font-size: 15px; line-height: 1.9; max-width: 560px; width: 100%; padding: 16px; }
    .welcome b { color: var(--ac); }
    .welcome .w-sub { font-size: 12px; color: var(--fc3); }
    .welcome .w-head {
      font-size: 11px; color: var(--fc3); text-transform: uppercase; letter-spacing: 1.5px;
      margin: 18px 0 10px;
    }
    .w-tips { display: flex; flex-direction: column; gap: 7px; text-align: left; }
    .w-tip {
      display: flex; align-items: baseline; gap: 9px;
      border: 1px solid var(--bd); border-radius: 9px; padding: 8px 12px;
      background: transparent; cursor: pointer; transition: all .15s; line-height: 1.55;
    }
    .w-tip:hover { border-color: var(--ac); background: rgba(88,166,255,.07); }
    .w-tip .t-icon { color: var(--ac); font-size: 13px; flex-shrink: 0; }
    .w-tip .t-text { font-size: 13px; color: var(--fc2); word-break: break-word; }
    .w-tip .t-text b { color: var(--fc); font-weight: 600; margin-right: 2px; }
    .msg-loading {
      color: var(--fc2); text-align: center; margin: auto; font-size: 14px;
      display: flex; flex-direction: column; align-items: center; gap: 10px;
    }
    .msg-loading .spin {
      width: 26px; height: 26px; border: 3px solid var(--bd);
      border-top-color: var(--ac); border-radius: 50%;
      animation: installSpin .8s linear infinite;
    }
    .compact-msg { animation: compactPulse 1.5s ease-in-out infinite; }
    @keyframes compactPulse { 0%,100% { opacity: 1; } 50% { opacity: 0.5; } }
    .msg { max-width: 85%; padding: 10px 14px; border-radius: 10px; line-height: 1.7; word-break: break-word; font-size: 14px; }
    .msg.user { align-self: flex-end; background: var(--ac); color: #000; border-bottom-right-radius: 2px; }
    .msg.assistant { align-self: flex-start; background: transparent; border: 1px solid var(--bd); border-bottom-left-radius: 2px; }
    .msg.error { align-self: flex-start; background: #2d1215; border: 1px solid #5b2a2e; color: var(--del); }
    .msg .meta { font-size: 11px; color: var(--fc3); margin-top: 8px; border-top: 1px solid var(--bd); padding-top: 6px; }
    .msg.user .meta { color: rgba(0,0,0,.4); }
    .msg.assistant p { margin: .4em 0; }
    .msg.assistant p:first-child { margin-top: 0; }
    .msg.assistant p:last-child { margin-bottom: 0; }
    .msg.assistant ul, .msg.assistant ol { padding-left: 1.5em; margin: .4em 0; }
    .msg.assistant blockquote { border-left: 3px solid var(--bd); padding-left: 10px; color: var(--fc2); margin: .5em 0; }
    .msg.assistant h1, .msg.assistant h2, .msg.assistant h3, .msg.assistant h4 { margin: .6em 0 .3em; line-height: 1.3; }
    .msg.assistant h1 { font-size: 1.3em; } .msg.assistant h2 { font-size: 1.15em; } .msg.assistant h3 { font-size: 1.05em; }
    .msg.assistant table { border-collapse: collapse; margin: .5em 0; width: 100%; }
    .msg.assistant th, .msg.assistant td { border: 1px solid var(--bd); padding: 4px 8px; font-size: 13px; }
    .msg.assistant th { background: transparent; }
    .msg.assistant a { color: var(--ac); text-decoration: none; }
    .msg.assistant a:hover { text-decoration: underline; }
    .msg.assistant hr { border: none; border-top: 1px solid var(--bd); margin: .6em 0; }
    .msg.assistant img { max-width: 100%; border-radius: 6px; }
    .msg.assistant code { font-family: 'Cascadia Code','Fira Code','Consolas',monospace; font-size: 13px; }
    .msg.assistant :not(pre) > code { background: var(--bk3); padding: 1px 5px; border-radius: 4px; }
    .msg.assistant pre {
      background: transparent; padding: 12px; border-radius: 6px; overflow-x: auto;
      margin: .5em 0; border: 1px solid var(--bd); position: relative;
    }
    .msg.assistant pre code { background: none; padding: 0; font-size: 13px; line-height: 1.5; }
    .msg.assistant .code-lang {
      position: absolute; top: 4px; right: 8px; font-size: 11px; color: var(--fc3);
      pointer-events: none; text-transform: uppercase;
    }
    .msg .ref {
      font-size: 12px; color: var(--fc); border-left: 2px solid var(--ac);
      padding: 2px 0 2px 10px; margin: 3px 0;
      font-family: 'Cascadia Code','Fira Code','Consolas','Courier New',monospace;
      line-height: 1.6; background: rgba(255,255,255,.04);
    }
    .msg .ref.tool { border-left-color: #f0b; }
    .msg .ref.cmd { border-left-color: #0c8; }
    .msg .ref.info { border-left-color: #4af; }
    .msg .ref.retrying { animation: retryPulse 1.2s ease-in-out infinite; border-left-width: 3px; }
    @keyframes retryPulse { 0%,100%{border-left-color:#4af;background:rgba(74,175,255,.08)} 50%{border-left-color:#58a6ff;background:rgba(88,166,255,.14)} }
    .msg .ref.edit { border-left-color: #f80; }
    .msg .ref.act { border-left-color: #fd0; }
    .msg .ref.reasoning { border-left-color: #a78bfa; font-style: italic; }
    .msg .ref.question { border-left-color: #fa0; white-space: pre-wrap; }
    .msg .ref.answer { border-left-color: #0c8; white-space: pre-wrap; }
    .msg .ref .run-dot {
      display: inline-block; width: 7px; height: 7px; border-radius: 50%;
      background: var(--ac); margin-left: 8px; vertical-align: middle;
      animation: pulse 1s infinite;
    }
    .msg .ref.tool.generating { animation: toolGen 1.4s ease-in-out infinite; border-left-width: 4px; }
    @keyframes toolGen {
      0%, 100% { color: var(--fc2); border-left-color: #58a6ff; background: rgba(88,166,255,.08); }
      33% { color: #d2a8ff; border-left-color: #d2a8ff; background: rgba(210,168,255,.10); }
      66% { color: #7ee787; border-left-color: #7ee787; background: rgba(126,231,135,.10); }
    }
    .msg .tool-out {
      font-size: 12px; color: var(--fc2); white-space: pre-wrap; word-break: break-all;
      font-family: 'Cascadia Code','Fira Code','Consolas','Courier New',monospace;
      background: transparent; border: 1px solid var(--bd); border-radius: 6px;
      padding: 6px 10px; margin: 4px 0; line-height: 1.5; max-height: 260px; overflow-y: auto;
    }
    .msg .stream-text { white-space: pre-wrap; word-break: break-word; line-height: 1.7; }
    .cursor { display: inline-block; width: 7px; height: 16px; background: var(--ac); animation: blink .7s infinite; vertical-align: text-bottom; margin-left: 2px; }
    @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0} }
    .reasoning { margin-bottom: 8px; }
    .reasoning summary {
      font-size: 12px; color: var(--fc2); cursor: pointer; user-select: none;
      padding: 2px 0; list-style: none; display: flex; align-items: center; gap: 4px;
    }
    .reasoning[open] summary { padding-bottom: 4px; }
    .reasoning summary::before { content: '> '; color: var(--fc3); font-family: monospace; }
    .reasoning[open] summary::before { content: 'v '; }
    .reasoning-body {
      font-size: 12px; color: var(--fc2); background: transparent;
      padding: 8px 10px; border-radius: 6px; margin-top: 4px; line-height: 1.5;
      white-space: pre-wrap; font-family: 'Cascadia Code','Fira Code','Consolas',monospace;
      max-height: 300px; overflow-y: auto;
    }
    .overlay {
      position: fixed; inset: 0; background: rgba(0,0,0,.5); z-index: 99;
      opacity: 0; pointer-events: none; transition: opacity .25s;
    }
    .overlay.show { opacity: 1; pointer-events: auto; }
    .theme-overlay {
      position: fixed; inset: 0; z-index: 9998;
      background: rgba(13,17,23,.72); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
      display: flex; align-items: center; justify-content: center;
      flex-direction: column; gap: 16px; padding: 20px;
    }
    .theme-panel {
      width: min(480px, 94vw); max-height: 86vh; overflow-y: auto;
      background: transparent; border: 1px solid var(--bd); border-radius: 12px;
      padding: 22px; display: flex; flex-direction: column; gap: 16px;
      position: relative;
    }
    .theme-close {
      position: absolute; top: 10px; right: 12px;
      background: none; border: none; color: var(--fc2); cursor: pointer;
      font-size: 20px; line-height: 1; padding: 4px 8px; border-radius: 6px;
    }
    .theme-close:hover { background: var(--bk3); color: var(--fc); }
    .theme-title { font-size: 17px; color: var(--fc); font-weight: bold; }
    .theme-sub { font-size: 12px; color: var(--fc2); margin-bottom: 8px; }
    .theme-list {
      overflow-y: auto; flex: 1; min-height: 0;
      display: flex; flex-direction: column; gap: 8px;
    }
    .theme-item {
      padding: 12px 16px; border-radius: 8px; cursor: pointer;
      border: 1px solid var(--bd); background: var(--bk3);
      transition: all .15s;
    }
    .theme-item:hover { border-color: var(--fc3); background: transparent; }
    .theme-item.active { border-color: var(--ac); background: rgba(88,166,255,.08); }
    .theme-item.nav { border-color: var(--ac); box-shadow: 0 0 0 1px var(--ac); }
    .theme-item.nav.active { background: rgba(88,166,255,.14); }
    .theme-name { font-size: 14px; color: var(--fc); font-weight: bold; margin-bottom: 4px; }
    .theme-desc { font-size: 12px; color: var(--fc2); }
    .theme-section {
      font-size: 11px; color: var(--fc3); text-transform: uppercase; letter-spacing: 1px;
      margin: 16px 0 8px; padding: 0 8px;
    }
    .theme-foot {
      padding: 12px 16px; border-top: 1px solid var(--bd);
      font-size: 11px; color: var(--fc3); text-align: center;
    }
    .theme-foot .go-setting {
      display: inline-block; margin-top: 8px; padding: 6px 14px;
      border: 1px solid var(--bd); border-radius: 6px;
      background: transparent; color: var(--ac); font-size: 12px; cursor: pointer;
      transition: all .15s;
    }
    .theme-foot .go-setting:hover { border-color: var(--ac); background: rgba(88,166,255,.08); }
    .session-panel {
      position: fixed; left: -320px; top: 0; bottom: 0; width: 300px;
      background: var(--bk2); background: color-mix(in srgb, var(--bk2) 32%, transparent);
      border-right: 1px solid var(--bd);
      backdrop-filter: blur(8px) saturate(1.3); -webkit-backdrop-filter: blur(8px) saturate(1.3);
      transition: left .25s; z-index: 100; display: flex; flex-direction: column;
    }
    .session-panel.open { left: 0; }
    .session-panel-header {
      display: flex; align-items: center; justify-content: space-between;
      padding: 12px 16px; border-bottom: 1px solid var(--bd); flex-shrink: 0;
    }
    .session-panel-header span { font-weight: bold; color: var(--ac); font-size: 15px; }
    .session-panel-header button {
      background: none; border: none; color: var(--fc2); cursor: pointer;
      font-size: 18px; padding: 2px 6px; border-radius: 4px;
    }
    .session-panel-header button:hover { background: var(--bk3); color: var(--fc); }
    .ws-row { display: flex; gap: 6px; padding: 8px 12px; border-bottom: 1px solid var(--bd); flex-shrink: 0; }
    .ws-row input {
      flex: 1; padding: 6px 10px; border-radius: 6px; border: 1px solid var(--bd);
      background: var(--bk3); color: var(--fc); font-size: 16px; outline: none; font-family: inherit;
    }
    .ws-row input:focus { border-color: var(--ac); }
    .ws-row button {
      padding: 4px 12px; border-radius: 6px; border: 1px solid var(--bd);
      background: var(--bk3); color: var(--fc2); font-size: 12px; cursor: pointer; flex-shrink: 0;
    }
    .ws-row button:hover { color: var(--fc); border-color: var(--fc3); }
    .ws-row button:disabled { opacity: .4; cursor: not-allowed; }
    .session-list { flex: 1; overflow-y: auto; padding: 8px; outline: none; box-shadow: none; }
    /* 移除 session-list 的 focus 样式 */
    .session-list:focus,
    .session-list:focus-visible {
      outline: none;
      box-shadow: none;
      border: none;
    }
    .session-item {
      padding: 10px 12px; border-radius: 8px; cursor: pointer; margin-bottom: 4px;
      border: 1px solid transparent; transition: all .15s; position: relative;
    }
    .session-item:hover { background: var(--bk3); background: color-mix(in srgb, var(--bk3) 55%, transparent); border-color: var(--bd); }
    .session-item.active { background: var(--bk3); background: color-mix(in srgb, var(--bk3) 55%, transparent); border-color: var(--ac); }
    .session-item.nav { background: var(--bk3); background: color-mix(in srgb, var(--bk3) 55%, transparent); border-color: var(--ac); }
    /* 移除 session-item 的 focus 样式 */
    .session-item:focus,
    .session-item:focus-visible {
      outline: none;
      border-color: transparent;
      box-shadow: none;
      -webkit-tap-highlight-color: transparent;
    }
    .session-item .s-time { font-size: 11px; color: var(--fc3); }
    .session-item .s-prompt { font-size: 13px; color: var(--fc); margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .session-item .s-preview { font-size: 12px; color: var(--fc2); margin-top: 2px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .session-item .s-del {
      position: absolute; top: 8px; right: 8px; font-size: 11px; color: var(--fc3);
      cursor: pointer; opacity: 0; padding: 2px 6px; border-radius: 4px; transition: all .15s;
    }
    .session-item:hover .s-del { opacity: 1; }
    .session-item .s-del:hover { background: var(--del); color: #fff; }
    .session-empty {
      text-align: center; color: var(--fc3); padding: 40px 20px; font-size: 13px;
    }
    .section-label {
      font-size: 11px; color: var(--fc3); padding: 4px 12px 2px; margin-top: 4px;
    }
    .input-bar {
      display: flex; gap: 8px; padding: 12px 16px;
      background: transparent; border-top: 1px solid var(--bd); flex-shrink: 0;
    }
    .input-bar textarea {
      flex: 1; padding: 8px 14px; border-radius: 8px; border: 1px solid var(--bd);
      background: transparent; color: var(--fc); font-family: inherit; font-size: 16px;
      resize: none; outline: none; min-height: 40px; max-height: 160px; line-height: 1.25; overflow-y: hidden; overflow-x: hidden;
    }
    .input-bar textarea::placeholder { color: var(--fc3); }
    .input-bar textarea:focus { border-color: var(--ac); }
    .input-bar button {
      padding: 0 18px; border: none; border-radius: 8px;
      background: var(--ac); color: #000; font-weight: bold; font-size: 14px;
      cursor: pointer; flex-shrink: 0;
    }
    .input-bar button:disabled { opacity: .4; cursor: not-allowed; }
    .cmd-wrap { position: relative; flex-shrink: 0; }
    .cmd-dropdown {
      position: absolute; left: 16px; right: 16px; bottom: calc(100% + 4px);
      background: var(--bk2); background: color-mix(in srgb, var(--bk2) 32%, transparent);
      border: 1px solid var(--bd); border-radius: 10px;
      backdrop-filter: blur(8px) saturate(1.3); -webkit-backdrop-filter: blur(8px) saturate(1.3);
      box-shadow: 0 6px 24px rgba(0,0,0,.35); max-height: 220px; overflow-y: auto; z-index: 50;
    }
    .cmd-item {
      display: flex; align-items: baseline; gap: 8px; padding: 8px 12px; cursor: pointer;
    }
    .cmd-item + .cmd-item { border-top: 1px solid var(--bd); }
    .cmd-item.active, .cmd-item:hover { background: var(--bk3); background: color-mix(in srgb, var(--bk3) 55%, transparent); }
    .cmd-item .name { color: var(--ac); font-weight: bold; font-family: monospace; flex-shrink: 0; }
    .cmd-item .desc { color: var(--fc2); font-size: 12px; word-break: break-all; }
    .install-overlay {
      position: fixed; inset: 0; z-index: 9999;
      background: var(--bk); display: flex; align-items: center; justify-content: center;
      flex-direction: column; gap: 16px;
    }
    .install-overlay .title { font-size: 18px; color: var(--fc); }
    .install-overlay .sub { font-size: 12px; color: var(--fc2); max-width: 80%; word-break: break-all; }
    .install-overlay .cmd {
      font-family: 'Cascadia Code', Consolas, monospace; font-size: 12px; color: var(--ac);
      background: rgba(88,166,255,.08); border: 1px solid rgba(88,166,255,.35);
      border-radius: 6px; padding: 6px 10px; max-width: 80%; width: 640px;
      word-break: break-all; white-space: pre-wrap;
    }
    .install-overlay .log {
      max-width: 80%; width: 640px; max-height: 280px; overflow-y: auto;
      background: transparent; border: 1px solid var(--bd); border-radius: 6px;
      padding: 10px 12px; font-family: monospace; font-size: 11px; line-height: 1.5;
      color: var(--fc2); text-align: left; white-space: pre-wrap; word-break: break-all;
    }
    .install-overlay .spin {
      width: 32px; height: 32px; border: 3px solid var(--bd);
      border-top-color: var(--ac); border-radius: 50%;
      animation: installSpin .8s linear infinite;
    }
    .install-overlay .err { color: var(--del); font-size: 14px; max-width: 80%; word-break: break-all; }
    .install-overlay button {
      padding: 8px 20px; border: 1px solid var(--bd); border-radius: 6px;
      background: var(--bk3); color: var(--fc); font-size: 13px; cursor: pointer;
    }
    .install-overlay button:hover { background: transparent; }
    @keyframes installSpin { to { transform: rotate(360deg) } }
    .provider-overlay {
      position: fixed; inset: 0; z-index: 9997;
      background: rgba(13,17,23,.72); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px);
      display: flex; align-items: center; justify-content: center;
      flex-direction: column; gap: 16px; padding: 20px;
    }
    .provider-panel {
      width: min(560px, 94vw); max-height: 86vh; overflow-y: auto;
      background: transparent; border: 1px solid var(--bd); border-radius: 12px;
      padding: 22px; display: flex; flex-direction: column; gap: 10px;
      position: relative;
    }
    .provider-panel .pp-close {
      position: absolute; top: 10px; right: 12px;
      background: none; border: none; color: var(--fc2); cursor: pointer;
      font-size: 20px; line-height: 1; padding: 4px 8px; border-radius: 6px;
    }
    .provider-panel .pp-close:hover { background: var(--bk3); color: var(--fc); }
    .provider-panel .pp-title { font-size: 17px; color: var(--fc); font-weight: bold; }
    .provider-panel .pp-sub { font-size: 12px; color: var(--fc2); margin-bottom: 6px; }
    .provider-card {
      display: flex; align-items: center; gap: 10px; padding: 10px 12px;
      border: 1px solid var(--bd); border-radius: 10px; background: var(--bk3);
      transition: border-color .15s;
    }
    .provider-card:hover { border-color: var(--fc3); }
    .provider-card.active { border-color: var(--ac); background: rgba(88,166,255,.08); }
    .provider-card .pc-info { flex: 1; min-width: 0; cursor: pointer; }
    .provider-card .pc-info:hover .pc-name { color: var(--ac); }
    .provider-card .pc-name { font-size: 14px; color: var(--fc); font-weight: bold; }
    .provider-card .pc-desc { font-size: 11px; color: var(--fc2); word-break: break-all; }
    .provider-card .pc-key {
      flex: 1; max-width: 190px; padding: 6px 9px; border-radius: 6px;
      border: 1px solid var(--bd); background: var(--bk); color: var(--fc);
      font-size: 16px; outline: none;
    }
    .provider-card .pc-key:focus { border-color: var(--ac); }
    .provider-card .pc-btn {
      height: 30px; padding: 0 14px; display: inline-flex; align-items: center; justify-content: center;
      border: 1px solid var(--ac); border-radius: 6px;
      background: transparent; color: var(--ac); font-size: 12px; cursor: pointer; white-space: nowrap;
    }
    .provider-card .pc-btn:hover { background: rgba(88,166,255,.12); }
    .provider-card .pc-btn.used { border-color: var(--ok); color: var(--ok); }
    .provider-card .pc-btn:disabled { opacity: .5; cursor: not-allowed; }
    .provider-card .pc-del {
      height: 30px; padding: 0 10px; display: inline-flex; align-items: center; justify-content: center;
      border: 1px solid var(--bd); border-radius: 6px;
      background: transparent; color: var(--fc3); font-size: 15px; line-height: 1; cursor: pointer;
      white-space: nowrap; margin-left: 4px;
    }
    .provider-card .pc-del:hover { border-color: var(--del); color: var(--del); background: rgba(248,81,73,.10); }
    .provider-card .pc-del:disabled { opacity: .5; cursor: not-allowed; }
    .provider-card .pc-omni-status { font-size: 11px; color: var(--fc2); white-space: nowrap; }
    .provider-add {
      margin-top: 6px; padding: 10px 12px; border: 1px dashed var(--bd); border-radius: 10px;
      background: transparent; color: var(--ac); font-size: 13px; cursor: pointer;
    }
    .provider-add:hover { border-color: var(--ac); background: rgba(88,166,255,.08); }
    .custom-overlay {
      position: fixed; inset: 0; z-index: 9997;
      background: rgba(0,0,0,.6); display: flex; align-items: center; justify-content: center;
    }
    .custom-panel {
      width: min(520px, 94vw); max-height: 86vh; overflow-y: auto;
      background: var(--bk2); border: 1px solid var(--bd); border-radius: 12px;
      padding: 22px; display: flex; flex-direction: column; gap: 12px;
    }
    .custom-panel .cp-title { font-size: 16px; color: var(--fc); font-weight: bold; }
    .custom-panel .cp-sub { font-size: 12px; color: var(--fc2); }
    .cp-field { display: flex; flex-direction: column; gap: 5px; }
    .cp-field label { font-size: 12px; color: var(--fc2); }
    .cp-field input, .cp-field select {
      padding: 8px 10px; border-radius: 6px; border: 1px solid var(--bd);
      background: var(--bk3); color: var(--fc); font-size: 16px; outline: none;
    }
    .cp-field input:focus, .cp-field select:focus { border-color: var(--ac); }
    .cp-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 4px; }
    .cp-actions button {
      padding: 8px 18px; border-radius: 6px; cursor: pointer; font-size: 13px;
    }
    .cp-save { background: var(--ac); color: #000; font-weight: bold; border: 1px solid var(--ac); }
    .cp-save:disabled { opacity: .5; cursor: not-allowed; }
    .cp-cancel { background: var(--bk3); color: var(--fc2); border: 1px solid var(--bd); }
    .cp-fetch {
      padding: 3px 10px; border-radius: 6px; cursor: pointer; font-size: 11px;
      background: var(--bk3); color: var(--ac); border: 1px solid var(--bd);
      white-space: nowrap;
    }
    .cp-fetch:hover:not(:disabled) { border-color: var(--ac); background: rgba(88,166,255,.08); }
    .cp-fetch:disabled { opacity: .5; cursor: not-allowed; }
    .notify {
      position: fixed; bottom: 68px; left: 50%; transform: translateX(-50%);
      padding: 6px 14px; border-radius: 6px; font-size: 12px; z-index: 9998;
      background: var(--del); color: #fff; opacity: 0; transition: opacity .25s;
      pointer-events: none; white-space: nowrap;
    }
    .notify.success { background: var(--ok); }
    .notify.show { opacity: 1; }
    .todo-panel {
      flex-shrink: 0; max-height: 140px; overflow-y: auto;
      background: transparent; border-top: 1px solid var(--bd);
      padding: 8px 16px; font-size: 12px; color: var(--fc2);
    }
    .todo-panel .todo-head { font-size: 11px; color: var(--fc3); margin-bottom: 4px; }
    .todo-item { padding: 2px 0; }
    .todo-item .td { color: var(--fc3); margin-right: 6px; }
    .todo-item .do { color: var(--ac); margin-right: 6px; }
    .todo-item .done { text-decoration: line-through; color: var(--fc3); }
    .stream-par.err-text { color: var(--del); }
    .stream-par.err-text pre, .stream-par.err-text code { color: var(--del); }
    .msg .meta.ok { color: var(--ok); }
    .msg .meta.err { color: var(--del); }
    .question-panel {
      flex-shrink: 0; background: transparent; border-top: 1px solid var(--bd);
      padding: 10px 16px; max-height: 45%; overflow-y: auto;
    }
    .question-panel .q-item { margin-bottom: 12px; }
    .question-panel .q-header { font-size: 11px; color: var(--ac); text-transform: uppercase; letter-spacing: .5px; margin-bottom: 2px; }
    .question-panel .q-text { font-size: 14px; color: var(--fc); margin: 2px 0 8px; }
    .q-opt {
      display: flex; align-items: center; gap: 8px; padding: 8px 10px;
      border: 1px solid var(--bd); border-radius: 8px; cursor: pointer;
      margin-bottom: 6px; background: var(--bk3); transition: all .15s;
    }
    .q-opt:hover { border-color: var(--ac); }
    .q-opt.sel { border-color: var(--ac); background: rgba(88,166,255,.12); }
    .q-opt .q-check {
      width: 16px; height: 16px; border-radius: 4px; border: 1px solid var(--fc3);
      flex-shrink: 0; display: flex; align-items: center; justify-content: center;
      font-size: 11px; color: #000;
    }
    .q-opt.sel .q-check { background: var(--ac); border-color: var(--ac); }
    .q-opt .q-label { font-weight: bold; color: var(--fc); }
    .q-opt .q-desc { color: var(--fc2); font-size: 12px; }
    .q-custom { display: flex; gap: 8px; margin: 6px 0; }
    .q-custom input {
      flex: 1; padding: 8px 10px; border-radius: 6px; border: 1px solid var(--bd);
      background: var(--bk3); color: var(--fc); font-size: 16px; outline: none;
    }
    .q-custom input:focus { border-color: var(--ac); }
    .q-actions { display: flex; gap: 8px; margin-top: 8px; }
    .q-actions button {
      padding: 8px 18px; border-radius: 8px; cursor: pointer; font-size: 13px;
    }
    .q-submit { background: var(--ac); color: #000; font-weight: bold; border: 1px solid var(--ac); }
    .q-submit:disabled { opacity: .5; cursor: not-allowed; }
    .q-reject { background: var(--bk3); color: var(--fc2); border: 1px solid var(--bd); }
    .q-reject:hover { color: var(--fc); border-color: var(--fc3); }
  </style>
</head>
<body>

<div id="app">
  <div class="install-overlay" v-if="installOverlay">
    <div class="spin" v-if="!installErr"></div>
    <div class="title">{{ installErr ? 'Install pi failed' : 'Installing pi...' }}</div>
    <div class="cmd" v-if="installCmd">$ {{ installCmd }}</div>
    <div class="log" ref="installLog">
      <div v-for="(l, li) in installLog" :key="li">{{ l }}</div>
      <span v-if="!installLog.length" style="color:var(--fc3)">{{ installProgress }}</span>
    </div>
    <div class="err" v-if="installErr">{{ installErr }}</div>
    <button v-if="installErr" @click="retryInstall" :disabled="installBusy">{{ installBusy ? 'Retrying...' : 'Retry' }}</button>
  </div>

  <div class="install-overlay" v-if="omniOverlay">
    <div class="spin" v-if="!omniErr"></div>
    <div class="title">{{ omniErr ? 'OmniRoute failed' : 'Starting OmniRoute...' }}</div>
    <div class="cmd" v-if="omniCmd">$ {{ omniCmd }}</div>
    <div class="log" ref="omniLog">
      <div v-for="(l, li) in omniLog" :key="li">{{ l }}</div>
      <span v-if="!omniLog.length" style="color:var(--fc3)">{{ omniProgress }}</span>
    </div>
    <div class="err" v-if="omniErr">{{ omniErr }}</div>
    <div v-if="omniErr" style="display:flex;gap:10px;">
      <button @click="retryOmni" :disabled="omniBusy">{{ omniBusy ? 'Retrying...' : 'Retry' }}</button>
      <button @click="omniToProviders" :disabled="omniBusy">Choose another provider</button>
    </div>
  </div>

  <div class="provider-overlay" v-if="!installOverlay && !omniOverlay && providerOverlay">
    <div class="provider-panel">
      <button class="pp-close" @click="providerOverlay=false" title="Close">×</button>
      <div class="pp-title">Choose model provider</div>
      <div class="pp-sub">Enter an API key for the provider, or start use OmniRoute. Selection is saved for next time.</div>
      <div class="provider-card" v-for="p in providerList" :key="p.name" :class="{active: p.current}">
        <div class="pc-info" @click="editProvider(p)" title="Edit provider settings">
          <div class="pc-name">{{ p.name }}</div>
          <div class="pc-desc">{{ p.baseUrl }}</div>
        </div>
        <input class="pc-key" v-model="providerKeys[p.name]" :placeholder="p.keySet ? 'key saved · re-enter to change' : 'API key'" type="password">
        <button class="pc-btn" :class="{used: p.current}" :disabled="providerBusy" @click="useProvider(p.name)">{{ p.current ? 'current' : 'use' }}</button>
        <button class="pc-del" :disabled="providerBusy || p.current" :title="p.current ? 'Cannot delete the current provider' : 'Delete provider'" @click="deleteProvider(p.name)">×</button>
      </div>
      <div class="provider-card" :class="{active: omniCurrent}">
        <div class="pc-info">
          <div class="pc-name">OmniRoute</div>
          <div class="pc-desc">{{ omniStatus }}</div>
        </div>
        <button class="pc-btn" :class="{used: omniCurrent}" :disabled="providerBusy" @click="useOmniRoute">{{ omniCurrent ? 'current' : 'enable' }}</button>
      </div>
      <button class="provider-add" @click="openCustomProvider" :disabled="providerBusy">＋ custom provider</button>
    </div>
  </div>

  <div class="custom-overlay" v-if="customOpen">
    <div class="custom-panel">
      <div class="cp-title">{{ customEditing ? 'Edit provider' : 'Add custom provider' }}</div>
      <div class="cp-sub">For OpenAI-compatible endpoints (gateway proxies, etc.). Fields follow pi models.json config.</div>
      <div class="cp-field">
        <label>Name (provider id)</label>
        <input v-model="customForm.name" placeholder="e.g. myprovider" spellcheck="false" :readonly="customEditing" :style="{opacity: customEditing ? .6 : 1}">
      </div>
      <div class="cp-field">
        <label>Base URL</label>
        <input v-model="customForm.baseUrl" placeholder="e.g. https://api.openai.com/v1" spellcheck="false">
      </div>
      <div class="cp-field">
        <label>API key</label>
        <input v-model="customForm.apiKey" :placeholder="customEditing ? 'leave empty to keep current key' : 'API key (required)'" type="password">
      </div>
      <div class="cp-field">
        <label>API type</label>
        <select v-model="customForm.api">
          <option value="openai-completions">openai-completions (most compatible)</option>
          <option value="openai-responses">openai-responses</option>
          <option value="anthropic-messages">anthropic-messages</option>
          <option value="google-generative-ai">google-generative-ai</option>
        </select>
      </div>
      <div class="cp-field">
        <label style="display:flex;align-items:center;justify-content:space-between;gap:8px;">
          <span>Model ids (comma separated)</span>
          <button type="button" class="cp-fetch" :disabled="customFetchBusy || !(customForm.baseUrl || '').trim()" title="Fetch model list from the provider API" @click="fetchCustomModels">{{ customFetchBusy ? 'fetching…' : '↻ fetch from API' }}</button>
        </label>
        <input v-model="customForm.models" placeholder="click fetch to auto-discover, or type e.g. gpt-4o-mini, gpt-4o" spellcheck="false">
      </div>
      <div class="cp-actions">
        <button class="cp-cancel" @click="closeCustomProvider">cancel</button>
        <button class="cp-save" :disabled="customBusy" @click="saveCustomProvider">save & use</button>
      </div>
    </div>
  </div>

  <div class="notify" :class="[{show: notifyShow}, notifyType === 'success' ? 'success' : 'error']">{{ notifyMsg }}</div>

  <div class="overlay" :class="{show: sessionPanelOpen}" @click="sessionPanelOpen=false"></div>

  <div class="theme-overlay" v-if="themeSelectorOpen" @click.self="themeSelectorOpen=false" @keydown="onThemeKey">
    <div class="theme-panel" tabindex="-1" ref="themePanelEl">
      <button class="theme-close" @click="themeSelectorOpen=false" title="Close">×</button>
      <div class="theme-title">选择主题</div>
      <div class="theme-sub">选择 elecV2P 的主题来同步应用到 Pi 界面</div>
      <div class="theme-list" ref="themeListEl">
        <div class="theme-item" :class="{active: !currentTheme, nav: themeNavIdx === 0}" @click="selectTheme(null)" @mouseenter="themeNavIdx = 0">
          <div class="theme-name">默认主题</div>
          <div class="theme-desc">Pi 的原始深色主题</div>
        </div>
        <div v-if="elecV2PTheme && elecV2PTheme.simple" class="theme-item" :class="{active: currentTheme === elecV2PTheme.simple, nav: themeNavIdx === 1}" @click="selectTheme(elecV2PTheme.simple)" @mouseenter="themeNavIdx = 1">
          <div class="theme-name">当前 elecV2P 主题</div>
          <div class="theme-desc">同步 elecV2P 当前使用的主题</div>
        </div>
        <div v-if="elecV2PTheme && elecV2PTheme.list" class="theme-section">预设主题</div>
        <div v-for="(theme, idx) in (elecV2PTheme && elecV2PTheme.list ? elecV2PTheme.list : [])" :key="idx" class="theme-item" :class="{active: currentTheme === theme, nav: (elecV2PTheme && elecV2PTheme.simple ? 2 : 1) + idx === themeNavIdx}" @click="selectTheme(theme)" @mouseenter="themeNavIdx = (elecV2PTheme && elecV2PTheme.simple ? 2 : 1) + idx">
          <div class="theme-name">{{ theme.name }}</div>
          <div class="theme-desc">主色调: {{ theme.mainbk || '未设置' }} · 文字色: {{ theme.maincl || '未设置' }}</div>
        </div>
      </div>
      <div class="theme-foot">
        <div class="theme-info">主题会立即应用到 Pi 界面</div>
        <button class="go-setting" @click="goThemeSetting">前往主题设置页面 →</button>
      </div>
    </div>
  </div>

  <div class="session-panel" :class="{open: sessionPanelOpen}">
    <div class="session-panel-header">
      <span>Session History</span>
      <button @click="sessionPanelOpen=false">x</button>
    </div>
    <div class="ws-row">
      <input v-model="workspace" placeholder="pi workspace (project dir) — agent reads/writes files here" @keydown.enter.prevent="setWorkspace" spellcheck="false">
      <button @click="setWorkspace" :disabled="wsBusy">set</button>
    </div>
    <div class="session-list" @keydown="onSessionPanelKey" ref="sessionListEl">
      <template v-if="pinnedSessions.length">
        <div class="section-label">PINNED</div>
        <div v-for="(s, i) in pinnedSessions" :key="'p'+s.id" class="session-item"
             :class="{active: s.id===sessionId, nav: s.id===sessionFlatList()[sessionNavIdx]?.id}" :style="{opacity: deleting[s.id] ? .4 : 1}"
             @click="selectSession(s.id)" @mouseenter="sessionNavIdx = sessionFlatList().findIndex(x => x.id === s.id)">
          <span class="s-del" @click.stop="deleteLocalSession(s.id)" title="Delete">x</span>
          <div class="s-time">{{ fmtTime(s.timestamp) }}</div>
          <div class="s-prompt">{{ (s.prompt||'').substring(0,50) }}</div>
          <div class="s-preview">{{ (s.preview||'').substring(0,60) }}</div>
        </div>
      </template>
      <template v-if="sessions.length">
        <div class="section-label">Pi</div>
        <div v-for="(s, i) in sessions" :key="'o'+s.id" class="session-item"
             :class="{active: s.id===sessionId, nav: s.id===sessionFlatList()[sessionNavIdx]?.id}" :style="{opacity: deleting[s.id] ? .4 : 1}"
             @click="selectSession(s.id)" @mouseenter="sessionNavIdx = sessionFlatList().findIndex(x => x.id === s.id)">
          <span class="s-del" @click.stop="deleteOCSession(s.id)" title="Delete">x</span>
          <div class="s-time">{{ fmtTime(s.updated||s.created) }}</div>
          <div class="s-prompt">{{ (s.title||'').substring(0,50) }}</div>
          <div class="s-preview" style="font-size:11px;color:var(--fc3)">{{ s.id }}</div>
        </div>
      </template>
      <div v-if="!pinnedSessions.length && !sessions.length" class="session-empty">No sessions yet.<br>Send a message to start one.</div>
    </div>
  </div>

  <div class="header">
    <h1 @click="sessionPanelOpen=true" title="Open sessions">Pi</h1>
    <span class="dot" :class="{run: busy}"></span>
    <span class="load" v-if="loading">&#8226; &#8226; &#8226;</span>
    <span class="ver">{{ piVersion }}</span>
    <button class="provider-btn" @click="showProviderPicker" :title="'Switch model provider · current: ' + (currentProvider || 'none')">
      <span class="pc-dot" :class="{none: !currentProvider}"></span>{{ currentProvider || 'provider' }}
    </button>
    <span class="dropdown-trigger" @click.stop="toggleDropdown('session')" title="Click to select session">
      <b>{{ sessionLabel }}</b> <span class="arr">&#9660;</span>
      <div class="dropdown" :class="{show: dropdown==='session'}" @click.stop>
        <template v-if="sessionDropdownList.length">
          <div v-for="s in sessionDropdownList" :key="s.id" class="d-item" :class="{active: s.id===sessionId}" @click="selectSession(s.id)">
            <div class="d-title">{{ sessionTitle(s).substring(0,50) }}</div>
            <div class="d-sub">{{ s.id.slice(0,16) }}...</div>
          </div>
          <div class="d-more" @click="viewAll">View all {{ totalSessions }} sessions &rarr;</div>
        </template>
        <div v-else class="d-empty">No sessions yet</div>
      </div>
    </span>
    <span class="dropdown-trigger" @click.stop="toggleDropdown('model')" title="Click to select model">
      <span>{{ currentModel || 'auto' }}</span> <span class="arr">&#9660;</span>
      <div class="dropdown" id="modelDropdown" :class="{show: dropdown==='model'}" @click.stop>
        <div class="d-item" :class="{active: !currentModel}" @click="selectModel('')">
          <div class="d-title">auto</div><div class="d-sub">default model</div>
        </div>
        <div class="d-filter">
          <input type="text" ref="modelFilterInput" v-model="modelFilter" placeholder="Filter models..." @click.stop @input="modelFilter = $event.target.value; modelNavIdx = 0" @keydown.up.prevent="modelNav(-1)" @keydown.down.prevent="modelNav(1)" @keydown.enter.prevent="modelNavSelect()" @keydown.esc.prevent="dropdown = ''; modelNavIdx = 0; $nextTick(() => { $refs.inputEl?.focus() })" spellcheck="false" style="width:100%;padding:6px 10px;border:1px solid var(--bd);border-radius:6px;background:transparent;color:var(--fc);font-size:16px;outline:none;box-sizing:border-box;">
        </div>
        <div class="d-list">
          <div v-for="(m, mi) in filteredModels" :key="m" :class="['d-item', {active: m===currentModel, nav: mi===modelNavIdx}]" @click="selectModel(m)" @mouseenter="modelNavIdx = mi">
            <div class="d-title">{{ m }}</div>
          </div>
        </div>
        <div class="d-foot" v-if="models.length">{{ models.length }} 个可用模型</div>
      </div>
    </span>
    <button class="theme-btn" @click.stop="showThemeSelector" :title="'Sync with elecV2P theme · current: ' + (currentTheme ? currentTheme.name || 'custom' : 'default')">
      <span class="theme-icon">🎨</span>
    </button>
    <div class="spacer"></div>
    <span class="ctx" v-if="ctxLimit" :title="ctxUsed + ' / ' + ctxLimit + ' tokens'">
      <span class="ctx-bar" :class="{ warn: ctxPct >= 80 && ctxPct < 95, danger: ctxPct >= 95 }"><i :style="ctxStyle"></i></span>
      <span class="ctx-num">{{ ctxLabel }} · {{ ctxPct }}%</span>
    </span>
    <button class="compact-btn" :class="{busy: compacting, 'highlight-green': ctxPct >= 60 && ctxLimit > 0}" :disabled="compacting || busy || !sessionId" @click="compactChat" :title="sessionId ? 'Manually compact this session\'s context' : 'No active session'">
      <span>{{ compacting ? ('Compacting… ' + compactElapsed + 's') : 'Compact' }}</span>
    </button>
  </div>

  <div class="messages" ref="messagesEl">
    <div class="msg-loading" v-if="switching"><span class="spin"></span> Loading session...</div>
    <template v-else>
    <div class="welcome" v-if="!messages.length">
      <b>Pi Coding Agent</b>
      <div class="w-sub">Pick a model · Set workspace from the sessions panel · Then just type to chat</div>
      <div class="w-head">典型工作流 · 点击自动填入输入框</div>
      <div class="w-tips">
        <div class="w-tip" v-for="tip in wfTips" :key="tip.name" @click="pickTip(tip.text)">
          <span class="t-icon">{{ tip.icon }}</span>
          <span class="t-text"><b>{{ tip.name }}</b>{{ tip.desc }}</span>
        </div>
      </div>
    </div>
    <div v-for="(m, mi) in messages" :key="mi" :class="['msg', m.role]">
      <template v-if="m.role === 'user'">{{ m.content }}</template>
      <template v-else>
        <div v-for="(p, pi) in m.parts" :key="pi">
          <div v-if="p.t === 'ref'" :class="['ref', p.cls || refClass(p.c), p.running ? 'generating' : '']" :style="p.cls === 'reasoning' && p.body ? 'cursor: pointer;' : ''" @click="p.cls === 'reasoning' && p.body ? (p.open = p.open === undefined ? false : !p.open) : null">{{ p.c }}<span v-if="p.running" class="run-dot"></span></div>
          <div v-if="p.t === 'ref' && p.cls === 'reasoning' && p.body && p.open !== false" class="reasoning-body" @scroll="reasoningScroll($event)">{{ p.body }}</div>
          <pre v-else-if="p.t === 'out'" class="tool-out">{{ p.c }}</pre>
          <template v-else-if="p.t === 'text'">
            <div v-for="(v, vi) in mdViews(p, m.streaming)" :key="vi" class="stream-par" :class="p.cls || ''">
              <pre v-if="v.plain" class="stream-text">{{ v.text }}</pre>
              <div v-else v-html="v.html"></div>
            </div>
          </template>
        </div>
        <span class="cursor" v-if="m.streaming"></span>
        <div class="meta" :class="m.errored ? 'err' : 'ok'" v-if="m.meta">{{ m.meta }}</div>
      </template>
    </div>
    </template>
  </div>

  <div class="todo-panel" v-if="todos.length">
    <div class="todo-head">TODO</div>
    <div v-for="(t, ti) in todos" :key="ti" class="todo-item">
      <span class="td">{{ t.status==='completed' ? '✓' : t.status==='in_progress' ? '◐' : '○' }}</span>
      <span :class="{done: t.status==='completed'}">{{ t.content }}</span>
    </div>
  </div>

  <div class="question-panel" v-if="question">
    <div v-for="(q, qi) in question.questions" :key="qi" class="q-item">
      <div class="q-header">{{ q.header || 'Question' }}</div>
      <div class="q-text">{{ q.question }}</div>
      <div v-for="(opt, oi) in q.options" :key="oi" class="q-opt"
           :class="{sel: qSel[qi] && qSel[qi].indexOf(opt.label) >= 0}" @click="qToggle(qi, opt.label)">
        <span class="q-check">{{ qSel[qi] && qSel[qi].indexOf(opt.label) >= 0 ? '✓' : '' }}</span>
        <span class="q-label">{{ opt.label }}</span>
        <span class="q-desc">{{ opt.description }}</span>
      </div>
      <div class="q-custom" v-if="q.custom !== false">
        <input type="text" v-model="qCustom[qi]" placeholder="Type a custom answer..." @keydown.enter.prevent="qSubmit">
      </div>
    </div>
    <div class="q-actions">
      <button class="q-submit" @click="qSubmit" :disabled="qSubmitting">Submit</button>
      <button class="q-reject" @click="qReject">Dismiss</button>
    </div>
  </div>

  <div class="cmd-wrap">
    <div class="cmd-dropdown" v-if="cmdOpen && cmdFiltered.length">
      <div class="cmd-item" v-for="(c, ci) in cmdFiltered" :key="c.name" :class="{active: ci === cmdIdx}" @mousedown.prevent="pickCmd(c)">
        <span class="name">/{{ c.name }}</span>
        <span class="desc">{{ c.description }}</span>
      </div>
    </div>
    <div class="input-bar">
      <textarea ref="inputEl" rows="1" placeholder="Type a message... (Enter to send, Ctrl+Enter for newline)" v-model="inputText" @input="onInput" @keydown="onKey"></textarea>
      <button v-if="busy" @click="stop()">Stop</button>
      <button @click="send()" :disabled="busy">Send</button>
    </div>
  </div>
</div>

<script>
  let _inited = false
  const installId = Date.now() + '-' + Math.random().toString(36).slice(2, 8)
  let notifyTimer = null
  const blockCache = new Map()
  const BLOCK_CACHE_MAX = 400
  const STREAM_PARSE_MAX = 4000

  const app = Vue.createApp({
    data() {
      return {
        busy: false, sessionId: '', sessions: [], models: [], currentModel: '', pinnedSessions: [],
        deleting: {}, messages: [], inputText: '', todos: [], runId: '',
        commands: [], cmdOpen: false, cmdIdx: -1,
        histList: [], histIdx: -1, histDraft: '',
        sessionPanelOpen: false, sessionNavIdx: 0, sessionNavList: [], dropdown: '',
        notifyMsg: '', notifyShow: false, notifyType: 'error', loading: false,
        piVersion: '', installOverlay: true, installErr: '', installProgress: 'This may take a minute', installLog: [], installCmd: '', installEs: null, installBusy: false,
        ctxUsed: 0, ctxLimit: 0, ctxPct: 0, ctxModel: '',
        compacting: false, compactRunId: '', compactElapsed: 0, compactTimer: null,
        question: null, qSel: [], qCustom: [], qSubmitting: false, qEl: null,
        workspace: '', wsBusy: false,
        sseMain: null, mainReady: false, sseHandlers: {}, switching: false,
        providerOverlay: false, providerList: [], providerKeys: {}, providerBusy: false,
        scrollPending: false,
        currentProvider: '', provSeq: 0,
        omniCurrent: false, omniStatus: 'checking…', omniRunning: false,
        elecV2PTheme: null, currentTheme: null, themeSelectorOpen: false, themeNavIdx: 0,
        omniOverlay: false, omniErr: '', omniProgress: 'Starting OmniRoute...', omniLog: [], omniCmd: '', omniBusy: false, omniEs: null, omniPendingModel: '',
        customOpen: false, customBusy: false, customEditing: false, customFetchBusy: false,
        customForm: { name: '', baseUrl: '', apiKey: '', api: 'openai-completions', models: '' },
        modelFilter: '', modelNavIdx: 0,
        wfTips: [
          { icon: '◈', name: '了解项目', desc: ' — 项目简介 · 功能介绍及使用场景', text: '简单介绍一下本项目（elecV2P）主要功能及使用场景，以及如何通过网络隧道远程访问本地服务' },
          { icon: '⏱', name: '定时任务', desc: ' — 写脚本 · 注册 cron 任务', text: '写一个 JS 脚本保存到 script/JSFile/，用 $feed 发送通知，并说明如何在 TASK 里把它配置成每天早上 8 点运行的定时任务' },
          { icon: '❖', name: 'EFH应用', desc: ' — Vue 前端 + favend 后端', text: '创建一个新的 .efh 应用：Vue 3 前端页面 + script favend 后端接口，实现一个简单备忘录，数据用 $store 保存' },
          { icon: '⚑', name: '排查问题', desc: ' — 贴上报错 · 定位并修复', text: '帮我分析下面这段报错的原因，定位到具体代码并给出修复方案：' },
          { icon: '⛨', name: 'MITM解密', desc: ' — 根证书安装 · HTTPS 主机解密', text: '讲解 elecV2P 的 MITM 机制和完整配置步骤：如何生成并安装根 CA 证书（rootCA），如何在 script/Lists/mitmhost.list 里添加需要解密的 HTTPS 主机，以及开启后哪些请求能被拦截修改' },
          { icon: '⚙', name: '规则配置', desc: ' — RULES/REWRITE · 重写、阻断、跳转', text: '帮我写网络请求修改规则：屏蔽某广告域名的请求，并把另一个 URL 的响应重写为本地 JS 脚本处理，保存到对应列表文件，同时说明 RULES（default.list）和 REWRITE（rewrite.list）的格式区别' }
        ]
      }
    },
    computed: {
      sessionLabel() {
        const s = this.sessions.find(function(x) { return x.id === this.sessionId }, this) || this.pinnedSessions.find(function(x) { return x.id === this.sessionId }, this)
        if (s) return (this.sessionTitle(s) || '').substring(0, 25)
        return this.sessionId ? this.sessionId.slice(0, 10) + '...' : 'No session'
      },
      sessionDropdownList() {
        return this.pinnedSessions.length ? this.pinnedSessions.slice(0, 5) : this.sessions.slice(0, 10)
      },
      totalSessions() {
        return this.pinnedSessions.length + this.sessions.length
      },
      cleanModels() {
        const self = this
        const out = []
        this.models.forEach((m) => { const c = m.replace(/\r/g, ''); if (out.indexOf(c) < 0) out.push(c) })
        return out
      },
      filteredModels() {
        const list = this.cleanModels
        if (!this.modelFilter) return list
        const q = this.modelFilter.toLowerCase()
        return list.filter((m) => m.toLowerCase().indexOf(q) >= 0)
      },
      cmdFiltered() {
        if (!this.cmdOpen) return []
        const q = this.inputText.replace(/^\s*\//, '').toLowerCase()
        const out = this.commands.filter((c) => {
          return !q || c.name.toLowerCase().indexOf(q) === 0 || c.description.toLowerCase().indexOf(q) === 0
        })
        return out.slice(0, 8)
      },
      themeItems() {
        const items = [{ label: '默认主题', desc: 'Pi 的原始深色主题', theme: null }]
        if (this.elecV2PTheme && this.elecV2PTheme.simple) {
          items.push({ label: '当前 elecV2P 主题', desc: '同步 elecV2P 当前使用的主题', theme: this.elecV2PTheme.simple })
        }
        const list = (this.elecV2PTheme && this.elecV2PTheme.list) || []
        for (const t of list) {
          items.push({ label: t.name || '未命名主题', desc: '主色调: ' + (t.mainbk || '未设置'), theme: t })
        }
        return items
      },
      ctxLabel() {
        if (!this.ctxLimit) return ''
        return this.fmtK(this.ctxUsed) + ' / ' + this.fmtK(this.ctxLimit)
      },
      ctxStyle() {
        return { width: Math.min(100, this.ctxPct) + '%' }
      }
    },
    methods: {
      esc(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;') },
      fmtTime(ts) { if (!ts) return ''; try { return new Date(ts).toLocaleString() } catch(e) { return '' } },
      fmtK(n) {
        n = Number(n) || 0
        if (n >= 1000) return (n / 1000).toFixed(1) + 'k'
        return String(n)
      },
      sessionTitle(s) { return s.title || s.prompt || s.id },
      renderMd(t) {
        if (!t) return ''
        let html = marked.parse(t, { gfm: true, breaks: false, headerIds: false, mangle: false })
        html = html.replace(/<pre><code class="language-(\w+)">/g, '<pre><span class="code-lang">$1</span><code>')
        html = html.replace(/<pre><code class="">/g, '<pre><code>')
        html = html.replace(/<a href=/g, '<a target="_blank" href=')
        return html
      },
      mdBlocks(t) {
        if (!t) return []
        const lines = String(t).replace(/\r\n/g, '\n').split('\n')
        const blocks = []
        let cur = []
        let inFence = false
        let fenceChar = ''
        const flush = () => {
          if (cur.length && cur.join('\n').trim() !== '') blocks.push(cur.join('\n'))
          cur = []
        }
        for (let i = 0; i < lines.length; i++) {
          const line = lines[i]
          if (!inFence) {
            const fm = /^\s*(`{3,}|~{3,})\s*[a-zA-Z0-9_-]*\s*$/.exec(line)
            if (fm) {
              flush()
              cur = [line]
              inFence = true
              fenceChar = fm[1]
              continue
            }
          } else if (line.replace(/\s+$/, '').indexOf(fenceChar) >= 0) {
            cur.push(line)
            inFence = false
            flush()
            continue
          }
          cur.push(line)
          if (!inFence && line.trim() === '') flush()
        }
        flush()
        return blocks
      },
      isOpenFence(blk) {
        const lines = String(blk).split('\n')
        let fenceChar = ''
        for (let i = 0; i < lines.length; i++) {
          const line = lines[i]
          if (!fenceChar) {
            const fm = /^\s*(`{3,}|~{3,})\s*[a-zA-Z0-9_-]*\s*$/.exec(line)
            if (fm) fenceChar = fm[1]
          } else if (line.replace(/\s+$/, '').indexOf(fenceChar) >= 0) {
            fenceChar = ''
          }
        }
        return !!fenceChar
      },
      cachedMd(blk) {
        if (blockCache.has(blk)) return blockCache.get(blk)
        const html = this.renderMd(blk)
        blockCache.set(blk, html)
        if (blockCache.size > BLOCK_CACHE_MAX) {
          const firstKey = blockCache.keys().next().value
          if (firstKey) blockCache.delete(firstKey)
        }
        return html
      },
      mdViews(p, streaming) {
        if (!p || p.t !== 'text') return []
        const blocks = this.mdBlocks(p.c)
        const views = []
        for (let i = 0; i < blocks.length; i++) {
          const blk = blocks[i]
          let plain = false
          if (streaming && i === blocks.length - 1 && (this.isOpenFence(blk) || blk.length > STREAM_PARSE_MAX)) {
            plain = true
          }
          views.push({ text: blk, html: plain ? null : this.cachedMd(blk), plain: plain })
        }
        return views
      },
      refClass(c) {
        let rc = 'ref'
        if (/^>\s*build/.test(c)) rc += ' info'
        else if (/^\$\s/.test(c)) rc += ' cmd'
        else if (/^←/.test(c)) rc += ' edit'
        else if (/^[◈]/.test(c)) rc += ' tool'
        else rc += ' act'
        return rc
      },
      modelNav(delta) {
        const len = this.filteredModels.length
        this.modelNavIdx = Math.max(0, Math.min(len - 1, this.modelNavIdx + delta))
        this.$nextTick(() => {
          const inp = this.$refs.modelFilterInput
          const dd = inp && inp.closest && inp.closest('.dropdown')
          if (!dd) return
          const list = dd.querySelector('.d-list')
          const item = list && list.children[this.modelNavIdx]
          if (item && item.scrollIntoView) {
            item.scrollIntoView({ block: 'nearest', inline: 'nearest' })
            if (list && item.offsetTop + item.offsetHeight > list.scrollTop + list.clientHeight) {
              list.scrollTop = item.offsetTop + item.offsetHeight - list.clientHeight
            }
          }
        })
      },
      modelNavSelect() {
        const m = this.filteredModels[this.modelNavIdx]
        if (m !== undefined) { 
          this.selectModel(m); 
          this.dropdown = ''
          this.$nextTick(() => { this.$refs.inputEl?.focus() })
        }
      },
      toggleDropdown(which) {
        const wasOpen = this.dropdown === which
        this.dropdown = this.dropdown === which ? '' : which
        if (this.dropdown === 'model') {
          this.modelNavIdx = 0
          // 打开模型列表时，自动滚动到当前使用的模型
          this.$nextTick(() => {
            this.scrollToCurrentModel()
          })
        } else if (wasOpen) {
          // 如果关闭了下拉菜单，返回焦点到输入框
          this.$nextTick(() => { this.$refs.inputEl?.focus() })
        }
      },
      showThemeSelector() {
        this.themeSelectorOpen = true
        this.themeNavIdx = 0
        // 关闭其他下拉菜单
        this.dropdown = ''
        this.$nextTick(() => {
          const el = this.$refs.themePanelEl
          if (el && el.focus) el.focus()
        })
      },
      onThemeKey(e) {
        if (!this.themeSelectorOpen) return
        const n = this.themeItems.length
        if (e.key === 'ArrowDown') {
          e.preventDefault()
          this.themeNavIdx = (this.themeNavIdx + 1) % n
          this.scrollThemeActive()
        } else if (e.key === 'ArrowUp') {
          e.preventDefault()
          this.themeNavIdx = (this.themeNavIdx - 1 + n) % n
          this.scrollThemeActive()
        } else if (e.key === 'Enter' && !(e.ctrlKey || e.metaKey)) {
          e.preventDefault()
          this.selectTheme(this.themeItems[this.themeNavIdx].theme)
        } else if (e.key === 'Tab' || e.key === 'Escape') {
          e.preventDefault()
          this.themeSelectorOpen = false
          this.themeNavIdx = 0
          this.$nextTick(() => { this.$refs.inputEl?.focus() })
        }
      },
      goThemeSetting() {
        // 在原页面/新标签页打开 elecV2P 主题设置页面（webUI 根路径 + #setting 面板），
        // 而不跳转当前 pi 标签页。
        const url = window.location.origin + '/#setting'
        let opened = false
        try {
          const p = window.parent
          // 若嵌在 iframe 中，优先在原（父）页面切换 hash，保持浏览器历史
          if (p && p !== window) {
            p.location.hash = '#setting'
            opened = true
          }
        } catch (e) {}
        if (!opened) {
          window.open(url, '_blank')
        }
      },
      selectTheme(theme) {
        this.applyTheme(theme)
        this.themeSelectorOpen = false
        // 选完主题后把焦点还给主输入框，方便继续输入
        this.$nextTick(() => { this.$refs.inputEl?.focus() })
        // 记住用户的选择，刷新后恢复（default / simple / list:index / 原始对象兜底）
        let sel
        if (!theme) {
          sel = 'default'
        } else if (this.elecV2PTheme && theme === this.elecV2PTheme.simple) {
          sel = 'simple'
        } else if (this.elecV2PTheme && this.elecV2PTheme.list) {
          const idx = this.elecV2PTheme.list.indexOf(theme)
          sel = idx >= 0 ? ('list:' + idx) : 'json'
        } else {
          sel = 'json'
        }
        try {
          if (sel === 'json') localStorage.setItem('aichat_pi_theme', JSON.stringify(theme))
          else localStorage.setItem('aichat_pi_theme', sel)
        } catch (e) {}
      },
      scrollThemeActive() {
        const listEl = this.$refs.themeListEl
        if (!listEl) return
        this.$nextTick(() => {
          const el = listEl.children[this.themeNavIdx]
          if (el && el.scrollIntoView) el.scrollIntoView({ block: 'nearest' })
        })
      },
      scrollToCurrentModel() {
        const dropdownEl = document.getElementById('modelDropdown')
        if (!dropdownEl) return
        
        const listEl = dropdownEl.querySelector('.d-list')
        if (!listEl) return
        
        // 找到当前使用的模型在列表中的位置
        const currentIndex = this.filteredModels.findIndex(model => model === this.currentModel)
        if (currentIndex >= 0) {
          const item = listEl.children[currentIndex]
          if (item && item.scrollIntoView) {
            item.scrollIntoView({ block: 'center', behavior: 'smooth' })
          }
        }
      },
      viewAll() {
        this.dropdown = ''
        this.openSessionPanel()
        // 保持焦点在输入框，因为会话面板是另一个UI元素
      },
      openSessionPanel() {
        this.sessionPanelOpen = true
        this.loadSessions().then(() => {
          this.sessionNavIdx = 0
          this.$nextTick(() => {
            this.sessionScrollNavIntoView()
            // 再下一个 tick 设置焦点，确保所有DOM更新完成
            this.$nextTick(() => {
              const el = this.$refs.sessionListEl
              if (el) {
                // 临时设置 tabindex 以接收键盘事件
                el.setAttribute('tabindex', '0')
                el.focus()
                // 在关闭时移除 tabindex
                this.$once('hook:beforeUnmount', () => {
                  el.removeAttribute('tabindex')
                })
              }
            })
          })
        })
      },
      closeSessionPanel(focusInput) {
        this.sessionPanelOpen = false
        this.$nextTick(() => {
          // 移除 tabindex
          const sessionEl = this.$refs.sessionListEl
          if (sessionEl) {
            sessionEl.removeAttribute('tabindex')
          }
          const el = this.$refs.inputEl
          if (el && el.focus) el.focus()
        })
      },
      sessionFlatList() {
        // 合并 pinned + sessions 作为键盘导航的统一列表
        return [].concat(this.pinnedSessions || []).concat(this.sessions || [])
      },
      sessionScrollNavIntoView() {
        this.$nextTick(() => {
          const list = this.$refs.sessionListEl
          if (!list) return
          const item = list.querySelectorAll('.session-item')[this.sessionNavIdx]
          if (item && item.scrollIntoView) item.scrollIntoView({ block: 'nearest' })
        })
      },
      sessionNav(delta) {
        const len = this.sessionFlatList().length
        if (!len) return
        let idx = (this.sessionNavIdx + delta + len) % len
        if (idx < 0) idx += len
        this.sessionNavIdx = idx
        this.sessionScrollNavIntoView()
      },
      sessionNavSelect() {
        const list = this.sessionFlatList()
        const item = list[this.sessionNavIdx]
        if (!item) { this.showNotify('No session selected', 'error'); return }
        this.selectSession(item.id)
        this.closeSessionPanel()
        this.showNotify('Session ' + (item.id || '').slice(0, 8) + ' loaded')
      },
      onSessionPanelKey(e) {
        if (!this.sessionPanelOpen) return
        if (e.key === 'ArrowDown') { 
          e.preventDefault(); 
          this.sessionNav(1) 
        }
        else if (e.key === 'ArrowUp') { 
          e.preventDefault(); 
          this.sessionNav(-1) 
        }
        else if (e.key === 'Enter') { 
          e.preventDefault(); 
          this.sessionNavSelect() 
        }
        else if (e.key === 'Escape') { 
          e.preventDefault(); 
          this.closeSessionPanel() 
        }
      },
      // 添加一个测试方法来验证键盘事件绑定
      testKeyboardBinding() {
        const el = this.$refs.sessionListEl
        if (el) {
          console.log('Testing keyboard binding...')
          // 模拟键盘事件
          const downEvent = new KeyboardEvent('keydown', { key: 'ArrowDown', code: 'ArrowDown' })
          el.dispatchEvent(downEvent)
        }
      },
      pickTip(text) {
        if (this.busy) return
        this.inputText = text
        this.$nextTick(() => {
          this.autosize()
          const el = this.$refs.inputEl
          if (el) {
            el.focus()
            try { el.setSelectionRange(el.value.length, el.value.length) } catch (e) {}
          }
        })
      },
      showNotify(msg, type) {
        this.notifyMsg = msg
        this.notifyType = type === 'error' ? 'error' : 'success'
        this.notifyShow = true
        clearTimeout(notifyTimer)
        notifyTimer = setTimeout(() => { this.notifyShow = false }, 6000)
      },
      setWorkspace() {
        if (this.wsBusy) return
        const self = this
        const cwd = (this.workspace || '').trim()
        if (!cwd) return
        this.wsBusy = true
        this.fetchFend('workspace_set', { cwd: cwd }, 10000).then((data) => {
          self.wsBusy = false
          if (data && data.ok) {
            self.workspace = data.cwd
            self.showNotify('workspace set: ' + data.cwd, 'success')
            self.sessionId = ''
            self.clearChat()
            self.loadSessions()
          } else {
            self.showNotify('set failed: ' + ((data && data.error) || 'unknown'), 'error')
          }
        }).catch((e) => {
          self.wsBusy = false
          self.showNotify('set workspace error: ' + e.message, 'error')
        })
      },
      loadSessions() {
        const self = this
        this.loading = true
        return Promise.all([
          this.fetchFend('sessions', {}, 10000).catch((e) => { self.showNotify('sessions: ' + e.message, 'error'); return { pinned: [] } }),
          this.fetchFend('models', {}, 15000).catch((e) => { self.showNotify('models: ' + e.message, 'error'); return { models: [] } })
        ]).then((results) => {
          self.models = (results[1] && results[1].models) || []
          self.pinnedSessions = (results[0] && results[0].pinned) || []
          return self.fetchFend('pi_sessions', {}, 8000).catch((e) => { self.showNotify('pi sessions: ' + e.message, 'error'); return { sessions: [] } })
        }).then((oc) => {
          if (oc && oc.sessions) self.sessions = oc.sessions
          return self.fetchFend('workspace', {}, 8000).catch(() => ({}))
        }).then((ws) => {
          if (ws && ws.cwd) self.workspace = ws.cwd
        }).finally(() => { self.loading = false })
      },
      fetchFend(key, data, timeout) {
        return fetch('', {
          method: 'post',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({key: key, data: data, timeout: timeout || 60000})
        }).then((r) => { return r.json() })
      },
      selectModel(m) {
        const model = (m || '').replace(/\r/g, '')
        const pidx = model.indexOf('/')
        if (pidx > 0 && model.slice(0, pidx) === 'omniroute' && !this.omniRunning) {
          this.dropdown = ''
          if (!confirm('OmniRoute is not started yet.\nEnable and start it now?')) return
          this.omniPendingModel = model
          this.useOmniRoute()
          return
        }
        this.currentModel = model
        localStorage.setItem('aichat_pi_last_model', this.currentModel)
        this.dropdown = ''
        this.$nextTick(() => { this.$refs.inputEl?.focus() })
        this.refreshCtx()
        this.loadProviders().catch(() => {})
        if (pidx > 0 && model.slice(0, pidx) !== 'omniroute') {
          const sel = (this.providerList || []).find((x) => x.name === model.slice(0, pidx))
          if (sel && !sel.keySet) {
            this.showNotify('Please enter the API key for ' + sel.name + ' first', 'error')
            this.showProviderPicker()
          }
        }
      },
      switchDefaultModel(m) {
        this.currentModel = (m || '').replace(/\r/g, '')
        localStorage.setItem('aichat_pi_last_model', this.currentModel)
        this.dropdown = ''
        this.$nextTick(() => { this.$refs.inputEl?.focus() })
        this.refreshCtx()
        this.loadProviders().catch(() => {})
      },
      selectSession(id) {
        const prev = this.sessionId
        this.sessionId = id
        localStorage.setItem('aichat_pi_last_session', id)
        this.dropdown = ''
        this.$nextTick(() => { this.$refs.inputEl?.focus() })
        this.loadSessions()
        this.syncCtx(id)
        if (!(this.busy && id === prev)) this.loadSessionMessages(id)
      },
      loadSessionMessages(id) {
        const self = this
        this.messages = []
        this.switching = true
        return this.fetchFend('session_messages', { id: id }, 15000).then((data) => {
          self.switching = false
          if (data && Array.isArray(data.messages)) {
            self.messages = data.messages
            self.scrollBottom()
          }
        }).catch(() => { self.switching = false })
      },
      deleteLocalSession(id) {
        if (this.deleting[id]) return
        const self = this
        const wasCurrent = self.sessionId === id
        if (wasCurrent && !confirm('Delete the current session?')) return
        this.deleting[id] = true
        this.fetchFend('delete_session', { id: id }, 10000).then(() => {
          if (wasCurrent) self.newSession()
          self.loadSessions()
          self.showNotify('Session deleted', 'success')
        }).catch((e) => {
          self.showNotify('Delete failed: ' + e.message, 'error')
        }).then(() => { delete self.deleting[id] })
      },
      deleteOCSession(id) {
        if (this.deleting[id]) return
        const self = this
        const wasCurrent = self.sessionId === id
        if (wasCurrent && !confirm('Delete the current session?')) return
        this.deleting[id] = true
        this.fetchFend('pi_delete_session', { id: id }, 10000).then((data) => {
          if (data.ok) {
            if (wasCurrent) self.newSession()
            self.loadSessions()
            self.showNotify('Session deleted', 'success')
          } else {
            self.showNotify('Delete failed: ' + (data.error || 'unknown'), 'error')
          }
        }).catch((e) => {
          self.showNotify('Delete failed: ' + e.message, 'error')
        }).then(() => { delete self.deleting[id] })
      },
      autosize() {
        const el = this.$refs.inputEl
        if (!el) return
        el.style.height = 'auto'
        el.style.height = Math.min(el.scrollHeight, 160) + 'px'
      },
      onInput() {
        this.autosize()
        const q = this.inputText.replace(/^\s*/, '')
        if (q.charAt(0) === '/') {
          this.cmdOpen = true
          this.cmdIdx = 0
        } else {
          this.cmdOpen = false
        }
      },
      pickCmd(c) {
        this.inputText = '/' + c.name + ' '
        this.cmdOpen = false
        this.cmdIdx = -1
        this.autosize()
        const el = this.$refs.inputEl
        if (el) el.focus()
      },
      loadCommands() {
        const self = this
        this.fetchFend('commands', {}, 8000).then((data) => {
          if (data && data.ok && Array.isArray(data.commands)) self.commands = data.commands
        }).catch(() => {})
      },
      loadProviders() {
        const self = this
        const seq = ++this.provSeq
        return this.fetchFend('providers', { model: this.currentModel }, 10000).then((data) => {
          if (seq !== this.provSeq) return data || {}
          if (data && Array.isArray(data.providers)) self.providerList = data.providers
          self.omniCurrent = !!(data && data.omniCurrent)
          self.omniStatus = data && data.omniStatus ? data.omniStatus : 'offline'
          self.omniRunning = !!(data && data.omniRunning)
          const cur = (self.providerList || []).find((p) => p.current)
          self.currentProvider = self.omniCurrent ? 'omniroute' : (cur ? cur.name : '')
          return data || {}
        }).catch(() => {})
      },
      loadElecV2PTheme() {
        const self = this
        // 主题数据由 /data?type=overview 返回（含 theme 字段）
        return fetch('/data?type=overview', {
          method: 'get',
          headers: {'Content-Type': 'application/json'}
        }).then((r) => { return r.json() }).then((data) => {
          // 后端未保存过主题时 CONFIG.webUI.theme 不存在，这里回退到内置默认预设，
          // 保证未保存时弹窗也有预设主题可选、也能应用。
          let theme = data && data.theme
          if (!theme || !theme.list || !theme.list.length) {
            theme = {
              simple: null,
              list: [
                { name: '简单暗黑', mainbk: '#000C', maincl: '#6E77FB', appbk: '#000C', style: '' },
                { name: '简单透明', mainbk: '#0000', maincl: '#FFC107', appbk: 'url(https://images.unsplash.com/photo-1646505183416-f3301d2a8127?auto=format)', style: '.content>div,.elecBtn--long,.efssset_container,.efsslist{border: 1px solid var(--tras-bk);}.eapp_item .eapp_name,.efsslist_content .efssa{color: var(--main-cl);}.loginfo.loginfo--full{background: var(--secd-bk);}.codeditor{--main-bk: var(--secd-bk);}' }
              ]
            }
          }
          self.elecV2PTheme = theme
          // 恢复用户上次选择的主题；未选择过或选了默认则保持 Pi 原生主题
          let sel = null
          try { sel = localStorage.getItem('aichat_pi_theme') } catch (e) {}
          if (sel && sel !== 'default') {
            if (sel === 'simple') {
              self.applyTheme(self.elecV2PTheme.simple || {})
            } else if (typeof sel === 'string' && sel.indexOf('list:') === 0) {
              const idx = parseInt(sel.slice(5), 10)
              const t = self.elecV2PTheme.list && self.elecV2PTheme.list[idx]
              if (t) self.applyTheme(t)
            } else {
              try { self.applyTheme(JSON.parse(sel)) } catch (e) {}
            }
          }
        }).catch(() => {})
      },
      applyTheme(theme) {
        // Pi 界面实际使用的变量是 --bk/--bk2/--bk3/--fc/--fc2/--fc3/--ac/--bd 等，
        // 需要把 elecV2P 主题（mainbk/maincl）映射到这组变量上才会生效。
        const styleId = 'pi-theme-style'
        const existing = document.getElementById(styleId)
        if (existing) existing.remove()

        const root = document.documentElement
        // 恢复默认主题
        if (!theme) {
          ;['--bk','--bk2','--bk3','--fc','--fc2','--fc3','--ac','--bd','--code-bk'].forEach(k => root.style.removeProperty(k))
          this.currentTheme = null
          return
        }

        let vars = ''
        let rules = ''
        const rgb = theme.mainbk ? this.hexToRgb(theme.mainbk) : null
        if (rgb) {
          // 能够解析出颜色时：标准化为 6 位实色（避免 #RGBA 简写的透明黑导致界面全黑），
          // 并依据背景亮度推导文字/边框/辅助背景色。
          const base = this.rgbToHex(rgb)
          const brightness = (rgb.r * 299 + rgb.g * 587 + rgb.b * 114) / 1000
          const light = brightness > 128
          const fg  = light ? '#0d1117' : '#e6edf3'
          const fg2 = light ? 'rgba(13,17,23,.55)' : 'rgba(230,237,243,.55)'
          const fg3 = light ? 'rgba(13,17,23,.35)' : 'rgba(230,237,243,.35)'
          const bd  = light ? 'rgba(13,17,23,.22)' : 'rgba(230,237,243,.18)'
          vars += `--bk: ${base};--code-bk: ${base};--bk2: ${this.shade(base, light ? -0.07 : 0.06)};--bk3: ${this.shade(base, light ? -0.11 : 0.10)};`
          vars += `--fc: ${fg};--fc2: ${fg2};--fc3: ${fg3};--bd: ${bd};`
        } else if (theme.mainbk) {
          // 颜色无法解析（如 url(...) 背景图），保留原值，辅助色直接用主背景
          vars += `--bk: ${theme.mainbk};--code-bk: ${theme.mainbk};--bk2: ${theme.mainbk};--bk3: ${theme.mainbk};--fc: #e6edf3;--fc2: rgba(230,237,243,.55);--fc3: rgba(230,237,243,.35);--bd: rgba(230,237,243,.18);`
        }
        if (theme.maincl) {
          vars += `--ac: ${theme.maincl};`
        }
        // appbk：应用背景（背景图片或纯色），作用于页面 body，图片铺满并固定
        if (theme.appbk) {
          let bg = theme.appbk
          if (/^https?:/.test(bg)) bg = `url(${bg})`
          rules += `body { background: ${bg} !important; background-size: cover; background-position: center; background-attachment: fixed; }`
        }
        // elecV2P 主题附带的自定义样式（类名可能不匹配 Pi，但仍保留以免遗漏关键变量）
        if (theme.style) rules += theme.style

        let allCss = ''
        if (vars) allCss += `:root {\n  ${vars}\n}`
        if (rules) allCss += `\n${rules}`
        if (allCss) {
          const styleEl = document.createElement('style')
          styleEl.id = styleId
          styleEl.textContent = allCss
          document.head.appendChild(styleEl)
        }

        // 保存当前主题设置
        this.currentTheme = theme
      },
      shade(hex, amount) {
        // amount>0 向白色混合（变亮），amount<0 向黑色混合（变暗）
        const rgb = this.hexToRgb(hex)
        if (!rgb) return hex
        const mix = (c) => {
          const v = amount >= 0 ? c + (255 - c) * amount : c * (1 + amount)
          return Math.max(0, Math.min(255, Math.round(v)))
        }
        const r = mix(rgb.r), g = mix(rgb.g), b = mix(rgb.b)
        return '#' + [r, g, b].map(v => v.toString(16).padStart(2, '0')).join('')
      },
      hexToRgb(hex) {
        if (!hex || typeof hex !== 'string' || hex[0] !== '#') return null
        let h = hex.trim()
        // 展开简写：#RGB -> #RRGGBB， #RGBA -> #RRGGBB
        if (/^#[a-f\d]{3}$/i.test(h)) {
          h = '#' + h.slice(1).split('').map(c => c + c).join('')
        } else if (/^#[a-f\d]{4}$/i.test(h)) {
          h = '#' + h.slice(1, 4).split('').map(c => c + c).join('')
        }
        const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(h)
        return result ? {
          r: parseInt(result[1], 16),
          g: parseInt(result[2], 16),
          b: parseInt(result[3], 16)
        } : null
      },
      rgbToHex(rgb) {
        if (!rgb) return null
        return '#' + [rgb.r, rgb.g, rgb.b].map(v => v.toString(16).padStart(2, '0')).join('')
      },
      showProviderPicker() {
        const self = this
        const keysCopy = {}
        for (const p of this.providerList) keysCopy[p.name] = ''
        this.providerKeys = keysCopy
        this.providerOverlay = true
        this.loadProviders().catch(() => {})
      },
      checkProviderReady() {
        const cm = this.currentModel.replace(/\r/g, '')
        const sep = cm.indexOf('/')
        let name = sep > 0 ? cm.slice(0, sep) : this.currentProvider
        if (!name) {
          const cur = (this.providerList || []).find((p) => p.current)
          if (cur) name = cur.name
        }
        if (this.omniCurrent || name === 'omniroute') return true
        const p = (this.providerList || []).find((x) => x.name === name)
        if (!name || !p || !p.keySet) {
          if (p) this.showNotify('Please enter the API key for ' + name + ' first')
          else this.showNotify('Please choose a model provider first')
          this.showProviderPicker()
          return false
        }
        return true
      },
      useProvider(name) {
        const self = this
        const p = this.providerList.find((x) => x.name === name) || {}
        const key = (this.providerKeys[name] || '').trim()
        if (!key && !p.keySet) { this.showNotify('Please enter an API key for ' + name); return }
        this.providerBusy = true
        const fendName = (p.custom || p.overridden) ? 'provider_custom_save' : 'provider_save'
        const payload = { name: name }
        if (key) payload.apiKey = key
        if (p.custom || p.overridden) {
          payload.baseUrl = p.baseUrl
          payload.api = p.api
          if (p.models && p.models.length) payload.models = p.models
        }
        this.fetchFend(fendName, payload, 60000).then((data) => {
          self.providerBusy = false
          if (data && data.ok) {
            self.showNotify('Provider ' + name + (key ? ' saved' : ' selected'), 'success')
            self.currentProvider = name
            self.providerOverlay = false
            self.loadSessions().then(() => {
              const defModel = data && data.model ? data.model : ''
              if (defModel) {
                self.switchDefaultModel(defModel)
              } else {
                self.selectModel('')
              }
            })
          } else {
            self.showNotify('Failed: ' + ((data && data.error) || 'unknown'), 'error')
          }
        }).catch((e) => {
          self.providerBusy = false
          self.showNotify('Failed: ' + e.message, 'error')
        })
      },
      useOmniRoute() {
        const self = this
        this.omniOverlay = true
        this.omniBusy = true
        this.omniErr = ''
        this.omniLog = []
        this.omniCmd = ''
        this.omniProgress = 'Checking OmniRoute...'
        if (this.omniEs) { try { this.omniEs.close() } catch(e) {} }
        const omniId = Date.now() + '-' + Math.random().toString(36).slice(2, 8)
        const es = new EventSource('/sse/elecV2P/' + omniId)
        this.omniEs = es
        es.onmessage = (e) => {
          try {
            const d = JSON.parse(e.data)
            if (d.type === 'cmd') {
              self.omniCmd = d.content
              return
            }
            if (d.type === 'progress') {
              self.omniLog.push(String(d.content).replace(/\s+/g, ' ').trim())
              if (self.omniLog.length > 200) self.omniLog.shift()
              self.$nextTick(() => {
                const el = self.$refs.omniLog
                if (el) el.scrollTop = el.scrollHeight
              })
              return
            }
            if (d.type === 'full_log') {
              self.omniLog = String(d.content).split('\n').filter(Boolean)
              self.$nextTick(() => {
                const el = self.$refs.omniLog
                if (el) el.scrollTop = el.scrollHeight
              })
              return
            }
            if (d.type === 'done') {
              es.close()
              self.omniEs = null
              self.omniBusy = false
              self.omniOverlay = false
              self.fetchFend('provider_save', { name: 'omniroute', apiKey: '' }, 10000).then((data) => {
                if (data && data.ok) {
                  self.showNotify('OmniRoute enabled', 'success')
                  self.omniCurrent = true
                  self.currentProvider = 'omniroute'
                  self.providerOverlay = false
                  const pickModel = self.omniPendingModel || (data && data.model) || ''
                  self.omniPendingModel = ''
                  self.loadSessions().then(() => {
                    if (pickModel) self.switchDefaultModel(pickModel)
                    else self.selectModel('')
                  })
                } else {
                  self.showNotify('Failed to save config: ' + ((data && data.error) || 'unknown'), 'error')
                }
              }).catch((err) => {
                self.showNotify('Failed: ' + err.message, 'error')
              })
              return
            }
            if (d.type === 'error') {
              es.close()
              self.omniEs = null
              self.omniBusy = false
              self.omniErr = d.content
              return
            }
          } catch(e) {}
        }
        es.onerror = () => {}
        this.fetchFend('ensure_omniroute', { installId: omniId }, 180000).then((data) => {
          if (data && data.ok && data.running) {
            es.close()
            self.omniEs = null
            self.omniBusy = false
            self.omniOverlay = false
            self.fetchFend('provider_save', { name: 'omniroute', apiKey: '' }, 10000).then((sav) => {
              if (sav && sav.ok) {
                self.showNotify('OmniRoute enabled', 'success')
                self.omniCurrent = true
                self.currentProvider = 'omniroute'
                self.providerOverlay = false
                const pickModel = self.omniPendingModel || (sav && sav.model) || ''
                self.omniPendingModel = ''
                self.loadSessions().then(() => {
                  if (pickModel) self.switchDefaultModel(pickModel)
                  else self.selectModel('')
                })
              } else {
                self.showNotify('Failed to save config: ' + ((sav && sav.error) || 'unknown'), 'error')
              }
            }).catch((err) => {
              self.showNotify('Failed: ' + err.message, 'error')
            })
          } else if (data && !data.ok && data.error) {
            es.close()
            self.omniEs = null
            self.omniBusy = false
            self.omniErr = data.error
          }
        }).catch((e) => {
          self.omniBusy = false
          self.omniErr = e.message
        })
      },
      openCustomProvider() {
        this.customForm = { name: '', baseUrl: '', apiKey: '', api: 'openai-completions', models: '' }
        this.customEditing = false
        this.customOpen = true
      },
      editProvider(p) {
        if (!p) return
        this.customForm = {
          name: p.name || '',
          baseUrl: p.baseUrl || '',
          apiKey: '',
          api: p.api || 'openai-completions',
          models: (p.models || []).join(', ')
        }
        this.customEditing = true
        this.customOpen = true
      },
      closeCustomProvider() {
        if (this.customBusy) return
        this.customOpen = false
      },
      fetchCustomModels() {
        const self = this
        const baseUrl = (this.customForm.baseUrl || '').trim()
        if (!baseUrl) { this.showNotify('Please enter a base URL first', 'error'); return }
        if (this.customFetchBusy) return
        this.customFetchBusy = true
        this.fetchFend('provider_fetch_models', {
          name: (this.customForm.name || '').trim(),
          baseUrl: baseUrl,
          api: this.customForm.api,
          apiKey: (this.customForm.apiKey || '').trim()
        }, 60000).then((data) => {
          self.customFetchBusy = false
          if (data && data.ok && Array.isArray(data.models)) {
            if (data.models.length) {
              self.customForm.models = data.models.join(', ')
              const removed = data.removed ? (' · ' + data.removed + ' unavailable removed') : ''
              self.showNotify('Fetched ' + data.models.length + ' models' + removed, 'success')
            } else {
              self.showNotify('Provider returned an empty model list')
            }
          } else {
            self.showNotify('Fetch failed: ' + ((data && data.error) || 'unknown'), 'error')
          }
        }).catch((e) => {
          self.customFetchBusy = false
          self.showNotify('Fetch failed: ' + e.message, 'error')
        })
      },
      saveCustomProvider() {
        const self = this
        const name = (this.customForm.name || '').trim().replace(/\s+/g, '-').toLowerCase()
        const baseUrl = (this.customForm.baseUrl || '').trim()
        const apiKey = (this.customForm.apiKey || '').trim()
        if (!name) { this.showNotify('Please enter a provider name', 'error'); return }
        if (!/^[a-z0-9][a-z0-9-]*$/.test(name)) { this.showNotify('Name must be letters/numbers/hyphens only', 'error'); return }
        if (!baseUrl) { this.showNotify('Please enter a base URL', 'error'); return }
        const existing = (this.providerList || []).find((x) => x.name === name)
        if (!apiKey && !(existing && existing.keySet)) { this.showNotify('Please enter an API key', 'error'); return }
        this.customBusy = true
        this.fetchFend('provider_custom_save', {
          name: name, baseUrl: baseUrl, apiKey: apiKey, api: this.customForm.api,
          models: (this.customForm.models || '').split(',').map((s) => s.trim()).filter(Boolean)
        }, 60000).then((data) => {
          self.customBusy = false
          if (data && data.ok) {
            self.showNotify('Custom provider ' + name + ' saved', 'success')
            self.currentProvider = name
            self.customOpen = false
            self.providerOverlay = false
            self.loadSessions().then(() => {
              const defModel = data.model ? data.model : ''
              if (defModel) self.switchDefaultModel(defModel)
              else self.selectModel('')
            })
          } else {
            self.showNotify('Failed: ' + ((data && data.error) || 'unknown'), 'error')
          }
        }).catch((e) => {
          self.customBusy = false
          self.showNotify('Failed: ' + e.message, 'error')
        })
      },
      deleteProvider(name) {
        const self = this
        if (!name) return
        if (this.providerList.find((p) => p.name === name && p.current)) {
          this.showNotify('Cannot delete the current provider. Switch provider first.', 'error')
          return
        }
        if (!confirm('Delete provider "' + name + '"?')) return
        this.providerBusy = true
        this.fetchFend('provider_delete', { name: name }, 10000).then((data) => {
          self.providerBusy = false
          if (data && data.ok) {
            self.showNotify('Provider ' + name + ' deleted', 'success')
            self.loadProviders().catch(() => {})
          } else {
            self.showNotify('Failed: ' + ((data && data.error) || 'unknown'), 'error')
          }
        }).catch((e) => {
          self.providerBusy = false
          self.showNotify('Failed: ' + e.message, 'error')
        })
      },
      loadHistory() {
        try {
          let arr = JSON.parse(localStorage.getItem('aichat_pi_history') || '[]')
          if (Array.isArray(arr)) this.histList = arr
        } catch(e) {}
        this.histIdx = -1
        this.histDraft = ''
      },
      saveHistory(text) {
        const t = String(text || '').trim()
        if (!t) return
        let arr = this.histList.filter((x) => { return x !== t })
        arr.push(t)
        if (arr.length > 50) arr = arr.slice(arr.length - 50)
        this.histList = arr
        this.histIdx = -1
        this.histDraft = ''
        try { localStorage.setItem('aichat_pi_history', JSON.stringify(arr)) } catch(e) {}
      },
      histNav(dir) {
        const self = this
        const list = this.histList
        if (!list.length) return
        const el = this.$refs.inputEl
        if (this.histIdx === -1) this.histDraft = this.inputText
        if (dir < 0) {
          this.histIdx = this.histIdx === -1 ? list.length - 1 : this.histIdx - 1
        } else {
          this.histIdx = this.histIdx === -1 ? -1 : this.histIdx + 1
          if (this.histIdx >= list.length) this.histIdx = -1
        }
        this.inputText = this.histIdx >= 0 ? list[this.histIdx] : this.histDraft
        this.cmdOpen = false
        this.$nextTick(() => {
          self.autosize()
          if (el) {
            el.focus()
            el.setSelectionRange(el.value.length, el.value.length)
          }
        })
      },
      onKey(e) {
        if (this.sessionPanelOpen && e.key === 'Escape') {
          e.preventDefault()
          this.closeSessionPanel()
          return
        }
        if (this.dropdown === 'model' && e.key === 'Escape') {
          e.preventDefault()
          this.dropdown = ''
          this.modelNavIdx = 0
          this.$nextTick(() => { this.$refs.inputEl?.focus() })
          return
        }
        if (this.cmdOpen && this.cmdFiltered.length) {
          if (e.key === 'ArrowDown') {
            e.preventDefault()
            this.cmdIdx = (this.cmdIdx + 1) % this.cmdFiltered.length
            return
          }
          if (e.key === 'ArrowUp') {
            e.preventDefault()
            this.cmdIdx = (this.cmdIdx - 1 + this.cmdFiltered.length) % this.cmdFiltered.length
            return
          }
          if (e.key === 'Tab') {
            e.preventDefault()
            this.pickCmd(this.cmdFiltered[this.cmdIdx >= 0 ? this.cmdIdx : 0])
            return
          }
          if (e.key === 'Enter' && !(e.ctrlKey || e.metaKey)) {
            e.preventDefault()
            this.pickCmd(this.cmdFiltered[this.cmdIdx >= 0 ? this.cmdIdx : 0])
            this.send()
            return
          }
          if (e.key === 'Escape') {
            e.preventDefault()
            this.cmdOpen = false
            this.cmdIdx = -1
            return
          }
        }
        if (e.key === 'ArrowUp' && !this.cmdOpen) {
          e.preventDefault()
          this.histNav(-1)
          return
        }
        if (e.key === 'ArrowDown' && !this.cmdOpen) {
          e.preventDefault()
          this.histNav(1)
          return
        }
        if (e.key === 'Enter') {
          if (e.ctrlKey || e.metaKey) {
            e.preventDefault()
            this.insertNewline()
          } else {
            e.preventDefault()
            this.send()
          }
        }
      },
      insertNewline() {
        const el = this.$refs.inputEl
        if (!el) return
        const start = el.selectionStart
        const end = el.selectionEnd
        this.inputText = this.inputText.slice(0, start) + '\n' + this.inputText.slice(end)
        this.autosize()
        const self = this
        this.$nextTick(() => {
          el.focus()
          el.setSelectionRange(start + 1, start + 1)
        })
      },
      scrollBottom() {
        const self = this
        this.$nextTick(() => {
          const el = self.$refs.messagesEl
          if (el) {
            el.scrollTop = el.scrollHeight
            const tos = el.querySelectorAll('.tool-out')
            for (let i = 0; i < tos.length; i++) tos[i].scrollTop = tos[i].scrollHeight
          }
        })
      },
      send() {
        if (this.busy) return
        const self = this
        let prompt = this.inputText.trim()
        if (!prompt) return
        if (prompt.length > 1200) {
          prompt = prompt.slice(0, 1200)
          this.showNotify('Message exceeds 1200 chars, truncated', 'error')
        }
        this.cmdOpen = false
        this.cmdIdx = -1
        if (/^\/new\s*$/.test(prompt)) {
          this.inputText = ''
          this.$nextTick(() => { self.autosize() })
          this.newSession()
          this.showNotify('New session started','success')
          return
        }
        if (/^\/clear\s*$/.test(prompt)) {
          // 只清空前端显示，不重置 session
          this.inputText = ''
          this.$nextTick(() => { self.autosize() })
          this.clearChat()
          this.showNotify('Chat cleared')
          return
        }
        if (/^\/compact\s*$/.test(prompt)) {
          this.inputText = ''
          this.$nextTick(() => { self.autosize() })
          self.compactChat()
          return
        }
        const sessionMatch = prompt.match(/^\/session\s*(.*)/i)
        if (sessionMatch) {
          // /session 不带参数 → 打开左侧 session 面板
          // /session <id> → 加载指定 session
          const arg = (sessionMatch[1] || '').trim()
          this.inputText = ''
          this.$nextTick(() => { self.autosize() })
          if (arg) {
            this.selectSession(arg)
            this.showNotify('Session ' + arg.slice(0, 8) + ' loaded')
          } else {
            this.openSessionPanel()
          }
          return
        }
        const modelMatch = prompt.match(/^\/model\s*(.*)/i)
        if (modelMatch) {
          // /model 不带参数 → 打开 model 下拉
          // /model <name> → 切换模型
          const arg = (modelMatch[1] || '').trim()
          if (arg) {
            this.selectModel(arg)
            this.showNotify('Model switched to ' + arg)
          } else {
            this.toggleDropdown('model')
            this.$nextTick(() => {
              const el = self.$refs.modelFilterInput
              if (el && el.focus) { el.focus(); el.select && el.select() }
            })
          }
          this.inputText = ''
          this.$nextTick(() => { self.autosize() })
          return
        }
        const themeMatch = prompt.match(/^\/theme\s*(.*)/i)
        if (themeMatch) {
          // /theme 不带参数 → 打开主题选择弹窗
          // /theme <name> → 直接应用指定主题
          const arg = (themeMatch[1] || '').trim()
          if (arg) {
            const t = (this.elecV2PTheme && this.elecV2PTheme.list || []).concat(this.elecV2PTheme && this.elecV2PTheme.simple ? [this.elecV2PTheme.simple] : [])
            const hit = t.find((x) => x && (x.name === arg || (x.name || '').toLowerCase() === arg.toLowerCase()))
            if (hit) {
              this.selectTheme(hit)
              this.showNotify('Theme applied: ' + (hit.name || arg), 'success')
            } else {
              this.showNotify('No theme named "' + arg + '"', 'error')
            }
          } else {
            this.showThemeSelector()
          }
          this.inputText = ''
          this.$nextTick(() => { self.autosize() })
          return
        }
        if (/^\/help\s*$/.test(prompt)) {
          this.inputText = ''
          this.$nextTick(() => { self.autosize() })
          const cmds = (this.commands || [])
          const cmdLines = cmds.map((c) => `• /${c.name}  —  ${c.description}`).join('  \n  ')
          const extra = `\n\n💡  小提示：\n  /new  开启新 session（保留当前不重置）\n  /clear  清空前端显示（不切 session）\n  /session  打开左侧历史面板，方向键选中，Enter 载入\n  /model  切换模型（可带参数或不带参数）\n  /theme  打开主题选择弹窗（可带参数直接应用）\n  /compact  压缩上下文节省 token`
          this.messages.push({ role: 'assistant', parts: [{ t: 'text', c: (cmdLines || 'No commands') + extra }], streaming: false })
          this.$nextTick(() => { this.scrollBottom() })
          return
        }
        if (/^\/(new|clear|session|model|theme|help)\b/.test(prompt)) {
          // known command with no further match above; drop the text and ignore
          this.inputText = ''
          this.$nextTick(() => { self.autosize() })
          return
        }
        if (!this.checkProviderReady()) return
        this.saveHistory(prompt)
        this.inputText = ''
        this.$nextTick(() => { self.autosize() })
        this.busy = true
        this.messages.push({ role: 'user', content: prompt })
        const el = Vue.reactive({ role: 'assistant', parts: [], streaming: true })
        this.messages.push(el)
        this.scrollBottom()
        const startTime = Date.now()
        const runId = Date.now() + '-' + Math.random().toString(36).slice(2, 8)
        this.runId = runId
        this.todos = []
        if (this.currentModel) this.ctxModel = this.currentModel

        let textBuf = ''
        let textFlush = null
        let reasonBuf = ''
        let reasonFlush = null
        let curReason = null // 当前打开的 reasoning 块（HTML ref part）
        // 收尾当前 reasoning 块：把剩余缓冲写入它，标记关闭，后续内容另起新块
        const closeReason = () => {
          if (reasonBuf) {
            if (curReason) curReason.body = (curReason.body || '') + reasonBuf
            else {
              curReason = { t: 'ref', c: '✱ reasoning', cls: 'reasoning', body: reasonBuf, reasonBody: true }
              el.parts.push(curReason)
            }
            reasonBuf = ''
          }
          if (curReason) curReason.closed = true
          curReason = null
        }
        const flushReasoning = () => {
          if (reasonFlush) { clearTimeout(reasonFlush); reasonFlush = null }
          if (!reasonBuf) return
          if (!curReason || curReason.closed) {
            curReason = { t: 'ref', c: '✱ reasoning', cls: 'reasoning', body: '', reasonBody: true }
            el.parts.push(curReason)
          }
          curReason.body = (curReason.body || '') + reasonBuf
          reasonBuf = ''
          self.scrollReasoningBottom()
        }
        const flushText = () => {
          flushReasoning()
          if (textFlush) { clearTimeout(textFlush); textFlush = null }
          if (!textBuf) return
          const last = el.parts[el.parts.length - 1]
          if (last && last.t === 'text') {
            last.c += textBuf
          } else {
            el.parts.push({ t: 'text', c: textBuf })
          }
          textBuf = ''
        }

        const onMsg = (data) => {
          try {
            const clearRunning = () => {
              for (let i = 0; i < el.parts.length; i++) {
                if (el.parts[i].running) el.parts[i].running = false
                if (el.parts[i].cls && el.parts[i].cls.indexOf('retrying') >= 0) {
                  el.parts[i].cls = (el.parts[i].cls || '').replace(/retrying/g, '').trim()
                  if (!el.parts[i].cls) el.parts[i].cls = 'info'
                }
              }
            }
            if (data.type === 'running') {
              // 工具开始执行：在对应 ref 行点亮一个运行指示灯，消除"卡住"的观感
              clearRunning()
              const lastRef = el.parts[el.parts.length - 1]
              if (lastRef && lastRef.t === 'ref') {
                lastRef.running = true
                self.scrollBottom()
              }
              return
            }
            if (data.type === 'init') {
              if (data.content && el.initShown !== data.content) {
                flushText()
                el.parts.push({ t: 'ref', c: data.content, cls: 'info' })
                el.initShown = data.content
                self.scrollBottom()
              }
              return
            }
            if (data.type === 'model') {
              if (data.removed && self.models.indexOf(self.currentModel) >= 0) {
                self.models = self.models.filter((m) => m !== self.currentModel)
              }
              self.currentModel = (data.model || '').replace(/\r/g, '')
              try { localStorage.setItem('aichat_pi_last_model', self.currentModel) } catch(e) {}
              const mp = self.currentModel.indexOf('/')
              if (mp > 0) self.currentProvider = self.currentModel.slice(0, mp)
              return
            }
            if (data.type === 'model_removed') {
              if (data.model && self.models.indexOf(data.model) >= 0) {
                self.models = self.models.filter((m) => m !== data.model)
              }
              return
            }
            if (data.type === 'ref') {
              clearRunning()
              flushText()
              if (data.uid) {
                const found = el.parts.find((p) => p.uid === data.uid)
                if (found) { found.c = data.content; found.cls = data.cls || '' }
                else el.parts.push({ t: 'ref', c: data.content, cls: data.cls || '', uid: data.uid })
              } else if (data.cls === 'reasoning' && data.content.indexOf('✱') === 0) {
                // 新的 reasoning 块开始：先收尾上一个块，本块内容稍后由 flushReasoning 另起新块
                closeReason()
              } else {
                // reasoning done 行 / 工具 / 信息等显示行：先收尾尚未结束的 reasoning 块，避免内容串块
                closeReason()
                el.parts.push({ t: 'ref', c: data.content, cls: data.cls || '' })
              }
            }
            if (data.type === 'reasoning') {
              flushText()
              reasonBuf += data.content || ''
              if (!reasonFlush) reasonFlush = setTimeout(flushReasoning, 50)
            }
            if (data.type === 'out') {
              flushText()
              const lastOut = el.parts[el.parts.length - 1]
              if (lastOut && lastOut.t === 'out') lastOut.c += data.content
              else el.parts.push({ t: 'out', c: data.content })
            }
            if (data.type === 'text') {
              textBuf += data.content
              if (!textFlush) textFlush = setTimeout(flushText, 50)
            }
            if (data.type === 'todo') {
              self.todos = data.data || []
            }
            if (data.type === 'ctx') {
              self.ctxUsed = data.used || 0
              if (data.limit > 0) self.ctxLimit = data.limit
              if (data.pct !== undefined && data.pct !== null) self.ctxPct = data.pct
              else if (self.ctxLimit) self.ctxPct = Math.round((self.ctxUsed || 0) / self.ctxLimit * 1000) / 10
              if (data.model) self.ctxModel = data.model
              try {
                if (self.ctxLimit) localStorage.setItem('aichat_pi_ctx_limit', String(self.ctxLimit))
                if (self.ctxModel) localStorage.setItem('aichat_pi_ctx_model', self.ctxModel)
              } catch(e) {}
            }
            if (data.type === 'session') {
              self.sessionId = data.id || ''
              try {
                if (self.sessionId) localStorage.setItem('aichat_pi_last_session', self.sessionId)
              } catch(e) {}
            }
            if (data.type === 'question') {
              self.question = data.data || null
              self.qSel = []
              self.qCustom = []
              if (self.question && self.question.questions) {
                for (let i = 0; i < self.question.questions.length; i++) {
                  self.qSel.push([])
                  self.qCustom.push('')
                }
              }
              flushText()
              self.qEl = el
              const qs = (self.question && self.question.questions) || []
              for (let i = 0; i < qs.length; i++) {
                const q = qs[i]
                let line = '❓ ' + (q.header || 'Question') + ': ' + q.question
                if (Array.isArray(q.options)) {
                  line += '\n' + q.options.map((o) => '   · ' + o.label).join('\n')
                }
                el.parts.push({ t: 'ref', c: line, cls: 'question' })
              }
              self.scrollBottom()
              return
            }
            if (data.type === 'question_done') {
              if (self.question && data.data && self.question.requestID === data.data.requestID) {
                self.qEl = null
                self.question = null
                self.qSel = []
                self.qCustom = []
              }
              return
            }
            if (data.type === 'done') {
              flushText()
              if (data.content) el.parts.push({ t: 'text', c: data.content })
              el.streaming = false
              self.qEl = null
              self.question = null
              self.qSel = []
              self.qCustom = []
              delete self.sseHandlers[runId]
              if (!el.stopped) {
                let meta = Math.round((Date.now() - startTime) / 1000) + 's'
                if (data.tokens) meta += ' | ⚙ ' + data.tokens.total + ' tokens'
                if (data.steps) meta += ' | ' + data.steps + ' steps'
                if (data.model) meta += ' | ' + data.model
                if (data.timeout) {
                  meta += ' | ⚠ timed out'
                  el.errored = true
                } else {
                  meta = '✓ ' + meta
                }
                el.meta = meta
                if (data.model) self.ctxModel = data.model
                try {
                  if (data.model) localStorage.setItem('aichat_pi_ctx_model', data.model)
                } catch(e) {}
              }
              self.busy = false
              self.runId = ''
              self.todos = []
              if (!self.sessionId) {
                self.loadSessions().then(() => {
                  if (self.sessions.length > 0) self.selectSession(self.sessions[0].id)
                })
              } else {
                self.loadSessions()
              }
              self.scrollBottom()
              return
            }
            if (data.type === 'error') {
              flushText()
              el.streaming = false
              el.errored = true
              self.question = null
              self.qSel = []
              self.qCustom = []
              if (el.stopped) {
                if (data.content && data.content !== 'client disconnected') {
                  el.meta = (el.meta ? el.meta + ' | ' : '') + '⚠ ' + data.content
                }
                delete self.sseHandlers[runId]
                self.busy = false
                self.runId = ''
                self.todos = []
                self.scrollBottom()
                return
              }
              if (el.parts.length) {
                el.meta = (el.meta ? el.meta + ' | ' : '') + '⚠ ' + data.content
              } else {
                el.parts = [{ t: 'text', c: 'Error: ' + data.content, cls: 'err-text' }]
              }
              delete self.sseHandlers[runId]
              self.busy = false
              self.runId = ''
              self.todos = []
              self.scrollBottom()
              return
            }
            self.scrollBottom()
          } catch(e) {}
        }
        self.sseHandlers[runId] = onMsg

        this.fetchFend('start', { prompt: prompt, runId: runId, session: this.sessionId, model: this.currentModel }, 120000).then((data) => {
          if (!data.ok) {
            el.errored = true; el.streaming = false
            el.parts = [{ t: 'text', c: 'Error: ' + (data.error || 'failed to start'), cls: 'err-text' }]
            self.busy = false
            self.runId = ''
            self.todos = []
            delete self.sseHandlers[runId]
            self.scrollBottom()
          } else if (data.sessionId) {
            self.sessionId = data.sessionId
            try {
              if (self.sessionId) localStorage.setItem('aichat_pi_last_session', self.sessionId)
            } catch(e) {}
          }
        }).catch((e) => {
          flushText()
          if (el.parts.length) {
            el.streaming = false
            el.meta = 'Connection closed'
          } else {
            el.errored = true; el.streaming = false
            el.parts = [{ t: 'text', c: 'Error: ' + e.message, cls: 'err-text' }]
          }
          self.busy = false
          self.runId = ''
          self.todos = []
          delete self.sseHandlers[runId]
          self.scrollBottom()
        })
      },
      stop() {
        const self = this
        const runId = this.runId
        const sessionId = this.sessionId
        const last = this.messages[this.messages.length - 1]
        if (last && last.role === 'assistant' && last.streaming) {
          last.streaming = false
          last.stopped = true
          last.errored = true
          last.meta = (last.meta ? last.meta + ' | ' : '') + '⏹ stopped'
        }
        this.fetchFend('stop', { runId: runId, session: sessionId }, 15000).then((data) => {
          if (!data.ok) {
            self.showNotify('stop failed: ' + (data.error || (data.code ? 'code ' + data.code : 'unknown')), 'error')
          }
          self.busy = false
        }).catch((e) => {
          self.showNotify('stop error: ' + e.message, 'error')
          self.busy = false
        })
      },
      qToggle(qi, label) {
        if (!this.question || this.qSubmitting) return
        const q = this.question.questions[qi]
        const cur = (this.qSel[qi] || []).slice()
        const idx = cur.indexOf(label)
        if (idx >= 0) cur.splice(idx, 1)
        else cur.push(label)
        this.qSel[qi] = q.multiple ? cur : cur.slice(-1)
        this.qSel = this.qSel.slice()
      },
      qSubmit() {
        const self = this
        if (!this.question || this.qSubmitting) return
        const answers = this.question.questions.map((q, qi) => {
          const arr = (this.qSel[qi] || []).slice()
          const custom = (this.qCustom[qi] || '').trim()
          if (custom && q.custom !== false && arr.indexOf(custom) < 0) arr.push(custom)
          return arr
        })
        this.qSubmitting = true
        const qData = this.question
        this.fetchFend('question_reply', { requestID: this.question.requestID, sessionID: this.question.sessionID, answers: answers }, 15000).then((data) => {
          self.qSubmitting = false
          if (data && data.ok) {
            if (self.qEl && qData && Array.isArray(qData.questions)) {
              const lines = qData.questions.map((q, qi) => {
                const arr = (self.qSel[qi] || []).slice()
                const custom = (self.qCustom[qi] || '').trim()
                if (custom && q.custom !== false && arr.indexOf(custom) < 0) arr.push(custom)
                return '✔ ' + (q.header || 'Answer') + ': ' + (arr.length ? arr.join(', ') : '(no selection)')
              })
              self.qEl.parts.push({ t: 'ref', c: lines.join('\n'), cls: 'answer' })
            }
            self.qEl = null
            self.question = null
            self.qSel = []
            self.qCustom = []
          } else {
            self.showNotify('Reply failed: ' + ((data && data.error) || 'unknown'), 'error')
          }
        }).catch((e) => {
          self.qSubmitting = false
          self.showNotify('Reply failed: ' + e.message, 'error')
        })
      },
      qReject() {
        const self = this
        if (!this.question || this.qSubmitting) return
        this.qSubmitting = true
        this.fetchFend('question_reject', { requestID: this.question.requestID }, 15000).then((data) => {
          self.qSubmitting = false
          if (data && data.ok) {
            if (self.qEl) self.qEl.parts.push({ t: 'ref', c: '✖ question dismissed', cls: 'answer' })
            self.qEl = null
            self.question = null
            self.qSel = []
            self.qCustom = []
          } else {
            self.showNotify('Reject failed: ' + ((data && data.error) || 'unknown'), 'error')
          }
        }).catch((e) => {
          self.qSubmitting = false
          self.showNotify('Reject failed: ' + e.message, 'error')
        })
      },
      clearChat() {
        // 只清空前端的显示内容，不开启新 session
        this.messages = []
        this.qEl = null
        this.question = null
        this.qSel = []
        this.qCustom = []
        this.ctxUsed = 0
        this.ctxPct = 0
      },
      newSession() {
        // 真正开启一个新 session（之前 /new 的行为）
        this.clearChat()
        this.sessionId = ''
        try { localStorage.removeItem('aichat_pi_last_session') } catch(e) {}
      },
      compactChat() {
        if (this.compacting || this.busy) return
        if (!this.sessionId) { this.showNotify('No active session to compact', 'error'); return }
        const sid = this.sessionId
        const self = this
        const compactId = 'compact-' + Date.now()
        this.compacting = true
        this.compactElapsed = 0
        if (this.compactTimer) clearInterval(this.compactTimer)
        this.compactTimer = setInterval(() => { self.compactElapsed++ }, 1000)
        // SSE handler for compact events
        const onMsg = (data) => {
          if (!data) return
          if (data.runId && data.runId !== compactId) return
          try {
            if (data.type === 'compact_log' && data.message) {
              console.log('[compact]', data.message)
              self.messages.push({
                role: 'assistant',
                parts: [{ t: 'text', c: '↻ ' + data.message }],
                streaming: false
              })
              self.scrollBottom()
              return
            }
            if (data.type === 'compaction_start') {
              self.messages.push({
                role: 'assistant',
                parts: [{ t: 'text', c: '↻ Compacting context...', cls: 'compact-msg' }],
                streaming: false
              })
              self.scrollBottom()
              return
            }
            if (data.type === 'compaction_end') {
              const r = data.result || {}
              const lines = []
              if (r.summary) lines.push('Summary: ' + r.summary)
              if (r.tokensBefore !== undefined) lines.push('Before: ~' + r.tokensBefore + ' tokens')
              if (r.estimatedTokensAfter !== undefined) lines.push('After: ~' + r.estimatedTokensAfter + ' tokens')
              if (r.usage) lines.push('Usage: ' + JSON.stringify(r.usage))
              const msg = lines.join('\n') || 'Compaction finished'
              self.messages.push({
                role: 'assistant',
                parts: [{ t: 'text', c: '↻ ' + msg }],
                streaming: false
              })
              self.scrollBottom()
              return
            }
            if (data.type === 'compact_done') {
              self.compacting = false
              if (self.compactTimer) { clearInterval(self.compactTimer); self.compactTimer = null }
              const r = data.result || {}
              if (r.estimatedTokensAfter) {
                self.ctxUsed = r.estimatedTokensAfter
                if (self.ctxLimit) self.ctxPct = Math.round(self.ctxUsed / self.ctxLimit * 1000) / 10
              } else if (data.result && data.result.tokensBefore) {
                // Fallback: if estimatedTokensAfter not set, use tokensBefore as approximation
                self.ctxUsed = data.result.tokensBefore
                if (self.ctxLimit) self.ctxPct = Math.round(self.ctxUsed / self.ctxLimit * 1000) / 10
              }
              self.showNotify('Context compacted', 'success')
              return
            }
            if (data.type === 'error') {
              self.compacting = false
              if (self.compactTimer) { clearInterval(self.compactTimer); self.compactTimer = null }
              self.showNotify('Compact failed: ' + (data.message || data.error || 'unknown'), 'error')
              return
            }
          } catch(e) {}
        }
        this.sseHandlers[compactId] = onMsg
        this.fetchFend('compact', { runId: compactId, session: sid, model: this.currentModel }, 180000).then((data) => {
          if (!data || data.ok === false) {
            onMsg({ type: 'error', message: (data && (data.error || data.message)) || 'compact failed' })
          }
        }).catch((e) => {
          onMsg({ type: 'error', message: e.message || String(e) })
        }).then(() => {
          delete this.sseHandlers[compactId]
        })
      },
      startInstall() {
        if (this.installBusy) return
        const self = this
        this.installBusy = true
        this.installErr = ''
        this.installLog = []
        this.installCmd = ''
        this.installProgress = 'This may take a minute'
        if (this.installEs) { try { this.installEs.close() } catch(e) {} }
        const instId = Date.now() + '-' + Math.random().toString(36).slice(2, 8)
        const installEs = new EventSource('/sse/elecV2P/' + instId)
        this.installEs = installEs
        installEs.onmessage = (e) => {
          try {
            const d = JSON.parse(e.data)
            if (d.type === 'cmd') {
              self.installCmd = d.content
              return
            }
            if (d.type === 'full_log') {
              self.installLog = String(d.content).split('\n').filter(Boolean)
              self.$nextTick(() => {
                const el = self.$refs.installLog
                if (el) el.scrollTop = el.scrollHeight
              })
              return
            }
            if (d.type === 'progress') {
              self.installLog.push(String(d.content).replace(/\s+/g, ' ').trim())
              if (self.installLog.length > 200) self.installLog.shift()
              self.$nextTick(() => {
                const el = self.$refs.installLog
                if (el) el.scrollTop = el.scrollHeight
              })
            }
            if (d.type === 'done') {
              installEs.close()
              self.installEs = null
              self.installBusy = false
              if (d.version) self.piVersion = d.version
              self.initApp()
            }
            if (d.type === 'error') {
              installEs.close()
              self.installEs = null
              self.installBusy = false
              self.installErr = d.content
            }
          } catch(e) {}
        }
        this.fetchFend('ensure_pi', { installId: instId }, 180000).then((data) => {
          if (data && data.ok && !data.installing) {
            installEs.close()
            self.installEs = null
            self.installBusy = false
            if (data.version) self.piVersion = data.version
            self.initApp()
          } else if (data && !data.ok && data.error) {
            installEs.close()
            self.installEs = null
            self.installBusy = false
            self.installErr = data.error
          } else if (data && data.ok && data.installing) {
            self.$nextTick(() => {
              const el = self.$refs.installLog
              if (el) el.scrollTop = el.scrollHeight
            })
          }
        }).catch((e) => {
          self.installBusy = false
        })
      },
      retryInstall() {
        const self = this
        self.startInstall()
      },
      retryOmni() {
        this.useOmniRoute()
      },
      reasoningScroll(ev) {
        // 用户手动上滚离开底部时暂停跟随，滚回底部(24px内)恢复
        const el = ev.target
        el.__stick = el.scrollTop + el.clientHeight >= el.scrollHeight - 24
      },
      scrollReasoningBottom() {
        if (this.scrollPending) return
        this.scrollPending = true
        this.$nextTick(() => {
          this.scrollPending = false
          const els = document.querySelectorAll('.reasoning-body')
          if (!els.length) return
          const el = els[els.length - 1]
          if (el.__stick === undefined) el.__stick = true
          if (el.__stick) el.scrollTop = el.scrollHeight
        })
      },
      omniToProviders() {
        if (this.omniEs) { try { this.omniEs.close() } catch(e) {} this.omniEs = null }
        this.omniOverlay = false
        this.omniErr = ''
        this.omniBusy = false
        this.omniPendingModel = ''
        this.showProviderPicker()
      },
      initApp() {
        if (_inited) return
        _inited = true
        this.installOverlay = false
        this.loading = true
        const self = this
        this.loadCommands()
        this.loadHistory()
        this.loadSessions().then(() => {
          self.loading = false
          const savedModel = localStorage.getItem('aichat_pi_last_model')
          if (savedModel && savedModel.replace(/\r/g, '') !== '') {
            self.currentModel = savedModel.replace(/\r/g, '')
          } else if (self.models && self.models.length) {
            self.currentModel = self.models[0].replace(/\r/g, '')
          }
          const savedSession = localStorage.getItem('aichat_pi_last_session')
          if (savedSession && savedSession !== self.sessionId && savedSession !== '') {
            for (let i = 0; i < self.sessions.length; i++) {
              if (self.sessions[i].id === savedSession) { self.selectSession(savedSession); break }
            }
          }
          self.refreshCtx()
          self.loadProviders().then(() => {
            if (!self.currentProvider) self.showProviderPicker()
            else if (self.omniCurrent && self.omniStatus && self.omniStatus.indexOf('not running') >= 0) {
              self.useOmniRoute()
            }
          })
          // 加载 elecV2P 主题
          self.loadElecV2PTheme()
        })
      },
      refreshCtx() {
        const self = this
        this.fetchFend('ctxinfo', { model: this.currentModel }, 10000).then((data) => {
          if (data && data.limit) {
            self.ctxLimit = data.limit
            if (data.model) self.ctxModel = data.model
          } else {
            // Model not in models.json (custom provider / no contextWindow) or no model selected.
            // Do NOT silently fall back to a stale cached limit from a previous model.
            const savedModel = localStorage.getItem('aichat_pi_ctx_model')
            if (savedModel && !self.ctxModel) self.ctxModel = savedModel
            if (!self.ctxLimit) self.ctxLimit = 0
          }
          if (self.sessionId) self.syncCtx(self.sessionId)
        }).catch(() => {})
      },
      syncCtx(sessionId) {
        if (!sessionId) return
        const self = this
        // Use the session's own model (returned by backend) so used/limit come from the same model.
        this.fetchFend('session_ctx', { id: sessionId, model: this.currentModel || this.ctxModel }, 12000).then((data) => {
          if (!data) return
          if (data.limit) self.ctxLimit = data.limit
          if (data.model) self.ctxModel = data.model
          if (!self.ctxLimit) { self.ctxUsed = 0; self.ctxPct = 0; return }
          self.ctxUsed = data.used || 0
          self.ctxPct = Math.round((self.ctxUsed || 0) / self.ctxLimit * 1000) / 10
        }).catch(() => {})
      },
    },
    mounted() {
      const self = this
      document.addEventListener('click', (e) => {
        // 检查点击是否在下拉菜单外部
        const dropdownEl = document.getElementById('modelDropdown')
        if (dropdownEl && !dropdownEl.contains(e.target) && self.dropdown === 'model') {
          self.dropdown = ''
          self.$nextTick(() => { self.$refs.inputEl?.focus() })
        } else {
          self.dropdown = ''
        }
        // 检查点击是否在主题选择器外部
        if (self.themeSelectorOpen) {
          const themeOverlay = e.target.closest('.theme-overlay')
          const themePanel = e.target.closest('.theme-panel')
          if (!themeOverlay || !themePanel) {
            self.themeSelectorOpen = false
          }
        }
      })

      const mainEs = new EventSource('/sse/elecV2P/pi-main')
      self.sseMain = mainEs
      mainEs.onmessage = (e) => {
        try {
          const d = JSON.parse(e.data)
          if (d.runId && self.sseHandlers[d.runId]) {
            self.sseHandlers[d.runId](d)
            return
          }
          if (d.type === 'init') {
            self.mainReady = true
            return
          }
        } catch(e) {}
      }
      mainEs.onerror = () => {}
      this.$nextTick(() => { const el = self.$refs.inputEl; if (el && el.focus) el.focus() })

      this.startInstall()
    }
  })

  app.mount('#app')
</script>

<script favend>
// @grant persist
const { spawn, exec } = require('child_process')
const fs = require('fs')
const path = require('path')
const os = require('os')

const PI_BIN = 'pi'
const OMNI_HOST = process.env.OMNIROUTE_URL || 'http://127.0.0.1:20128'
const WS_KEY = 'pi_workspace'
const APP_CH = 'pi-main'

const stripAnsi = (s) => { return String(s).replace(/\u001b\[[0-9;]*[a-zA-Z]/g, '').replace(/\r/g, '') }
const sleep = (ms) => { return new Promise((resolve) => { setTimeout(resolve, ms) }) }

const SECRET_MASK = '***'
const maskSecrets = (s) => {
  if (!s) return s
  return String(s)
    .replace(/(api[_-]?key|api_token|access_token|auth[_-]?token|secret|password|passwd)\s*[:=]\s*(?:"[^"]*"|'[^']*'|[^\s,;]+)/gi, '$1=' + SECRET_MASK)
    .replace(/(Bearer\s+)[A-Za-z0-9._~+\/=:-]+/gi, '$1' + SECRET_MASK)
    .replace(/\b(?:sk-[A-Za-z0-9_-]{6,}|sign[a-z0-9_.-]{8,}|eyJ[A-Za-z0-9_-]{10,})\b/gi, SECRET_MASK)
}

const IS_WIN = process.platform === 'win32'
const DEVNULL = IS_WIN ? 'nul' : '/dev/null'
const redirCmd = (cmd) => { return cmd + ' 2>' + DEVNULL }

const killTree = (child) => {
  if (!child || !child.pid) return
  try {
    if (IS_WIN) execAsync('taskkill /PID ' + child.pid + ' /T /F', 5000).catch(() => {})
    else {
      try { process.kill(-child.pid, 'SIGTERM') } catch(e) {}
      setTimeout(() => { try { process.kill(-child.pid, 'SIGKILL') } catch(e) {} }, 1500)
    }
  } catch(e) {}
}

const execAsync = (cmd, timeout) => {
  return new Promise((resolve, reject) => {
    exec(cmd, { timeout: timeout || 15000, windowsHide: true, encoding: 'utf-8', maxBuffer: 5 * 1024 * 1024 }, (error, stdout, stderr) => {
      if (error) reject(error)
      else resolve({ stdout: stdout || '', stderr: stderr || '' })
    })
  })
}

const httpGetUrl = (url, timeout, hops) => {
  return new Promise((resolve) => {
    let httpMod
    try {
      httpMod = require(/^https:/.test(String(url)) ? 'https' : 'http')
    } catch(e) { resolve({ status: 0, body: '' }); return }
    let u
    try { u = new (require('url').URL)(url) } catch(e) { resolve({ status: 0, body: '' }); return }
    const maxHops = hops || 5
    const req = httpMod.get({ hostname: u.hostname, port: u.port || (u.protocol === 'https:' ? 443 : 80), path: u.pathname + u.search }, (res) => {
      if (res.statusCode >= 300 && res.statusCode < 400 && res.headers.location && maxHops > 0) {
        res.resume()
        let next = res.headers.location
        try { next = new (require('url').URL)(next, url).href } catch(e) {}
        httpGetUrl(next, timeout, maxHops - 1).then(resolve)
        return
      }
      let buf = ''
      res.on('data', (c) => { buf += c })
      res.on('end', () => { resolve({ status: res.statusCode, body: buf }) })
    })
    req.on('error', () => { resolve({ status: 0, body: '' }) })
    req.setTimeout(timeout || 4000, () => { req.destroy(); resolve({ status: 0, body: '' }) })
  })
}

const fetchProviderModelsRaw = (url, headers, timeout, hops) => {
  return new Promise((resolve, reject) => {
    let httpMod
    try {
      httpMod = require(/^https:/.test(String(url)) ? 'https' : 'http')
    } catch(e) { reject(new Error('invalid url protocol')); return }
    let u
    try { u = new (require('url').URL)(url) } catch(e) { reject(new Error('invalid url: ' + url)); return }
    const maxHops = hops === undefined ? 3 : hops
    const req = httpMod.get({
      hostname: u.hostname,
      port: u.port || (u.protocol === 'https:' ? 443 : 80),
      path: u.pathname + u.search,
      headers: Object.assign({ accept: 'application/json' }, headers || {})
    }, (res) => {
      if (res.statusCode >= 300 && res.statusCode < 400 && res.headers.location && maxHops > 0) {
        res.resume()
        let next = res.headers.location
        try { next = new (require('url').URL)(next, url).href } catch(e) { reject(new Error('bad redirect')); return }
        fetchProviderModelsRaw(next, headers, timeout, maxHops - 1).then(resolve, reject)
        return
      }
      let buf = ''
      res.on('data', (c) => { buf += c })
      res.on('end', () => {
        if (res.statusCode !== 200) { reject(new Error('HTTP ' + res.statusCode + (buf ? ': ' + buf.slice(0, 160) : ''))); return }
        try { resolve(JSON.parse(buf)) } catch(e) { reject(new Error('response is not valid JSON')) }
      })
    })
    req.on('error', (e) => { reject(new Error(e.message || 'request failed')) })
    req.setTimeout(timeout || 10000, () => { req.destroy(); reject(new Error('request timeout')) })
  })
}

const BAD_MODELS_KEY = 'pi_bad_models'
const readBadModels = () => {
  try {
    const v = JSON.parse($store.get(BAD_MODELS_KEY) || '{}')
    return v && typeof v === 'object' ? v : {}
  } catch(e) { return {} }
}
const markBadModels = (keys) => {
  const list = Array.isArray(keys) ? keys : [keys]
  if (!list.length) return false
  const bad = readBadModels()
  let changed = false
  for (const k of list) { if (k && !bad[k]) { bad[k] = Date.now(); changed = true } }
  if (changed) { try { $store.set(BAD_MODELS_KEY, JSON.stringify(bad)) } catch(e) {} }
  return changed
}
const reviveBadModels = (keys) => {
  const list = Array.isArray(keys) ? keys : [keys]
  if (!list.length) return
  const bad = readBadModels()
  let changed = false
  for (const k of list) { if (bad[k]) { delete bad[k]; changed = true } }
  if (changed) { try { $store.set(BAD_MODELS_KEY, JSON.stringify(bad)) } catch(e) {} }
}

// resolves {status, body} for any response; status 0 = network error/timeout
const fetchProviderStatus = (url, headers, timeout, hops) => {
  return new Promise((resolve) => {
    let httpMod
    try {
      httpMod = require(/^https:/.test(String(url)) ? 'https' : 'http')
    } catch(e) { resolve({ status: 0, body: '' }); return }
    let u
    try { u = new (require('url').URL)(url) } catch(e) { resolve({ status: 0, body: '' }); return }
    const maxHops = hops === undefined ? 3 : hops
    const req = httpMod.get({
      hostname: u.hostname,
      port: u.port || (u.protocol === 'https:' ? 443 : 80),
      path: u.pathname + u.search,
      headers: Object.assign({ accept: 'application/json' }, headers || {})
    }, (res) => {
      if (res.statusCode >= 300 && res.statusCode < 400 && res.headers.location && maxHops > 0) {
        res.resume()
        let next = res.headers.location
        try { next = new (require('url').URL)(next, url).href } catch(e) { resolve({ status: 0, body: '' }); return }
        fetchProviderStatus(next, headers, timeout, maxHops - 1).then(resolve)
        return
      }
      res.resume()
      resolve({ status: res.statusCode, body: '' })
    })
    req.on('error', () => { resolve({ status: 0, body: '' }) })
    req.setTimeout(timeout || 6000, () => { req.destroy(); resolve({ status: 0, body: '' }) })
  })
}

const isDeadModelStatus = (s) => { return s === 404 || s === 410 }

// probe each listed model via GET /models/{id}; drop ones the endpoint reports as gone (404/410).
// unknown results (auth errors, rate limits, network issues) keep the model.
const filterDeadModels = (api, baseUrl, apiKey, providerName, ids) => {
  if ((api !== 'openai-completions' && api !== 'openai-responses') || !ids.length || ids.length > 150) {
    return Promise.resolve({ ids: ids, removed: [] })
  }
  const root = String(baseUrl || '').replace(/\/+$/, '')
  const headers = apiKey ? { authorization: 'Bearer ' + apiKey } : {}
  const deadline = Date.now() + 45000
  const CONC = 8
  const alive = []
  const removed = []
  const runBatch = (batch) => {
    return Promise.all(batch.map((id) => {
      const enc = String(id).split('/').map(encodeURIComponent).join('/')
      return fetchProviderStatus(root + '/models/' + enc, headers, 6000).then((r) => {
        return { id: id, state: isDeadModelStatus(r.status) ? 'dead' : (r.status === 200 ? 'alive' : 'unknown') }
      }).catch(() => { return { id: id, state: 'unknown' } })
    }))
  }
  let chain = Promise.resolve()
  for (let i = 0; i < ids.length; i += CONC) {
    const batch = ids.slice(i, i + CONC)
    chain = chain.then(() => {
      if (removed.length && Date.now() > deadline) { alive.push(...batch); return [] }
      return runBatch(batch)
    }).then((results) => {
      for (const r of results) {
        if (r.state === 'dead') removed.push(r.id)
        else alive.push(r.id)
      }
    })
  }
  return chain.then(() => {
    if (providerName) {
      const fullKeys = removed.map((id) => providerName + '/' + id)
      if (fullKeys.length) markBadModels(fullKeys)
      reviveBadModels(alive.filter((id) => !removed.includes(id)).map((id) => providerName + '/' + id))
    }
    return { ids: alive, removed: removed }
  })
}

const fetchIdsForApi = (api, baseUrl, key) => {
  api = String(api || 'openai-completions')
  baseUrl = String(baseUrl || '').trim().replace(/\/+$/, '')
  if (!baseUrl) return Promise.reject(new Error('base URL required'))
  if (api === 'anthropic-messages') {
    const root = baseUrl.replace(/\/v1$/, '')
    return fetchProviderModelsRaw(root + '/v1/models?limit=1000', {
      'x-api-key': key,
      'anthropic-version': '2023-06-01'
    }, 12000).then((j) => {
      const list = (j && j.data) || []
      return list.map((m) => m && m.id).filter(Boolean)
    })
  }
  if (api === 'google-generative-ai') {
    return fetchProviderModelsRaw('https://generativelanguage.googleapis.com/v1beta/models' + (key ? '?key=' + encodeURIComponent(key) + '&pageSize=1000' : '?pageSize=1000'), {}, 12000).then((j) => {
      const list = (j && j.models) || []
      return list.map((m) => String((m && m.name) || '').replace(/^models\//, '')).filter(Boolean)
    })
  }
  return fetchProviderModelsRaw(baseUrl + '/models', key ? { authorization: 'Bearer ' + key } : {}, 12000).then((j) => {
    const list = Array.isArray(j) ? j : ((j && (j.data || j.models)) || [])
    return list.map((m) => typeof m === 'string' ? m : (m && m.id)).filter(Boolean)
  })
}

const fetchModelsForApi = (api, baseUrl, apiKey, providerName) => {
  const key = String(apiKey || '').replace(/^\$.*/, '')
  return fetchIdsForApi(api, baseUrl, key).then((ids) => {
    return filterDeadModels(api, baseUrl, key, providerName || '', dedupeList(ids))
  })
}

const dedupeList = (arr) => {
  const out = []
  for (const item of arr || []) { if (item && out.indexOf(item) < 0) out.push(item) }
  return out
}

const fetchOmniModels = () => {
  return new Promise((resolve) => {
    httpGetUrl(OMNI_HOST + '/v1/models', 6000, 3).then((r) => {
      let models = []
      if (r.status === 200 && r.body) {
        try {
          const parsed = JSON.parse(r.body)
          const list = (parsed && parsed.data) || []
          models = list.filter((m) => m && m.id).map((m) => {
            return {
              id: String(m.id),
              name: m.name || m.id,
              contextWindow: m.context_length || 128000,
              maxTokens: m.max_output_tokens || 16384
            }
          })
        } catch(e) {}
      }
      resolve(models)
    }).catch(() => resolve([]))
  })
}

const getWorkDir = () => {
  try {
    const w = $store.get(WS_KEY)
    if (w) return String(w)
  } catch(e) {}
  try { return process.cwd() } catch(e) { return '.' }
}
const setWorkDir = (d) => { try { $store.set(WS_KEY, String(d)) } catch(e) {} }

const agentDir = () => {
  return process.env.PI_CODING_AGENT_DIR || path.join(os.homedir(), '.pi', 'agent')
}
const modelsFile = () => { return path.join(agentDir(), 'models.json') }
const sessionDirFor = (cwd) => {
  const safe = '--' + String(cwd).replace(/^[\/\\]/, '').replace(/[\/\\:]/g, '-') + '--'
  return path.join(agentDir(), 'sessions', safe)
}
const readModelsJson = () => {
  try { return JSON.parse(fs.readFileSync(modelsFile(), 'utf8')) } catch(e) { return null }
}

const toolArg = (inp) => {
  const i = inp || {}
  let arg = i.command || i.filePath || i.path || i.url || i.pattern || i.query || i.message || ''
  if (i.filePath) {
    const off = Number(i.offset)
    const lim = Number(i.limit)
    if (!isNaN(off) && !isNaN(lim) && lim > 0) arg += ' · L' + off + '-' + (off + lim - 1)
    else if (!isNaN(lim) && lim > 0) arg += ' · ' + lim + ' lines'
    else if (!isNaN(off) && off > 0) arg += ' · from L' + off
  }
  if (typeof i.old_string === 'string' || typeof i.new_string === 'string') {
    const oldLines = typeof i.old_string === 'string' && i.old_string ? i.old_string.split('\n').length : 0
    const newLines = typeof i.new_string === 'string' && i.new_string ? i.new_string.split('\n').length : 0
    arg += ' · -' + oldLines + '/+' + newLines
  }
  if (Array.isArray(i.edits) && i.edits.length) {
    let oldLines = 0, newLines = 0
    for (const ed of i.edits) {
      const o = ed && (ed.oldText || ed.old_string)
      const n = ed && (ed.newText || ed.new_string)
      if (o) oldLines += o.split('\n').length
      if (n) newLines += n.split('\n').length
    }
    arg += ' · -' + oldLines + '/+' + newLines
    if (i.edits.length > 1) arg += ' · ' + i.edits.length + ' blocks'
  }
  return arg
}

const isFileEditTool = (name) => { return /^(edit|write)$/.test(String(name || '').toLowerCase()) }
const toolCallRef = (name, arg) => {
  name = String(name || 'tool')
  const suf = arg ? ' · ' + maskSecrets(arg) : ''
  if (isFileEditTool(name)) return { c: '← ' + name + suf, cls: 'edit' }
  return { c: '◈ ' + name + suf, cls: 'tool' }
}

const parseModel = (s) => {
  s = String(s || '').replace(/\r/g, '')
  const i = s.indexOf('/')
  if (i > 0) return { provider: s.slice(0, i), model: s.slice(i + 1) }
  return { provider: '', model: s }
}

const collectConfiguredModels = (mj) => {
  const out = []
  const bad = readBadModels()
  if (mj && mj.providers) {
    for (const p of Object.keys(mj.providers)) {
      const conf = mj.providers[p] || {}
      const models = conf.models || []
      for (const m of models) {
        if (m && m.id && !bad[p + '/' + m.id]) out.push(p + '/' + m.id)
      }
    }
  }
  return out
}

const SETTINGS_FILE = () => { return path.join(agentDir(), 'settings.json') }

const readSettingsJson = () => {
  try { return JSON.parse(fs.readFileSync(SETTINGS_FILE(), 'utf8')) } catch(e) { return {} }
}

const writeFileJson = (full, obj) => {
  try { fs.chmodSync(full, 0o600) } catch(e) {}
  fs.mkdirSync(path.dirname(full), { recursive: true })
  fs.writeFileSync(full, JSON.stringify(obj, null, 2))
  try { fs.chmodSync(full, 0o600) } catch(e) {}
}

const PROVIDER_PRESETS = [
  { name: 'openai', api: 'openai-completions', baseUrl: 'https://api.openai.com/v1', models: [
    { id: 'gpt-5.6-sol', name: 'GPT-5.6 Sol', reasoning: true, contextWindow: 1050000, maxTokens: 181888 },
    { id: 'gpt-4.1', name: 'GPT-4.1', contextWindow: 1048576, maxTokens: 32768 },
    { id: 'gpt-4o-mini', name: 'GPT-4o mini', contextWindow: 128000, maxTokens: 16384 }
  ] },
  { name: 'anthropic', api: 'anthropic-messages', baseUrl: 'https://api.anthropic.com', models: [
    { id: 'claude-opus-4-7', name: 'Claude Opus 4.7', reasoning: true, contextWindow: 1000000, maxTokens: 128000 },
    { id: 'claude-sonnet-4-5', name: 'Claude Sonnet 4.5', reasoning: true, contextWindow: 1000000, maxTokens: 65536 },
    { id: 'claude-haiku-4-5', name: 'Claude Haiku 4.5', contextWindow: 1000000, maxTokens: 65536 }
  ] },
  { name: 'deepseek', api: 'openai-completions', baseUrl: 'https://api.deepseek.com/v1', models: [
    { id: 'deepseek-chat', name: 'DeepSeek Chat', contextWindow: 128000, maxTokens: 8192 },
    { id: 'deepseek-reasoner', name: 'DeepSeek Reasoner', reasoning: true, contextWindow: 128000, maxTokens: 8192 }
  ] },
  { name: 'nvidia', api: 'openai-completions', baseUrl: 'https://integrate.api.nvidia.com/v1', models: [
    { id: 'z-ai/glm-5.2', name: 'GLM-5.2 (NIM) · agent', reasoning: true, contextWindow: 1000000, maxTokens: 128000 },
    { id: 'deepseek-ai/deepseek-v4-pro', name: 'DeepSeek-V4-Pro (NIM) · coding', contextWindow: 1000000, maxTokens: 16384 },
    { id: 'deepseek-ai/deepseek-v4-flash', name: 'DeepSeek-V4-Flash (NIM) · fast', contextWindow: 1000000, maxTokens: 16384 }
  ] },
  { name: 'openrouter', api: 'openai-completions', baseUrl: 'https://openrouter.ai/api/v1', models: [
    { id: 'openai/gpt-5.6-sol', name: 'GPT-5.6 Sol (OR)', reasoning: true, contextWindow: 1050000, maxTokens: 181888 },
    { id: 'anthropic/claude-sonnet-4-5', name: 'Claude Sonnet 4.5 (OR)', reasoning: true, contextWindow: 1000000, maxTokens: 65536 },
    { id: 'deepseek/deepseek-chat', name: 'DeepSeek Chat (OR)', contextWindow: 128000, maxTokens: 8192 }
  ] }
]

$fend('provider_fetch_models', (data) => {
  const name = data && data.name ? String(data.name).trim() : ''
  let baseUrl = data && data.baseUrl ? String(data.baseUrl).trim() : ''
  let api = data && data.api ? String(data.api).trim() : ''
  let apiKey = data && data.apiKey ? String(data.apiKey).trim() : ''
  if (name) {
    const conf = (readModelsJson() || { providers: {} }).providers[name]
    if (conf) {
      if (!baseUrl) baseUrl = String(conf.baseUrl || '')
      if (!api) api = String(conf.api || '')
      if (!apiKey && conf.apiKey && !/^\$/.test(String(conf.apiKey))) apiKey = String(conf.apiKey)
    }
    const preset = PROVIDER_PRESETS.find((p) => p.name === name)
    if (preset) {
      if (!baseUrl) baseUrl = preset.baseUrl
      if (!api) api = preset.api
    }
  }
  return fetchModelsForApi(api, baseUrl, apiKey, name).then((res) => {
    return { ok: true, models: dedupeList(res.ids), removed: (res.removed || []).length }
  }).catch((e) => {
    return { ok: false, error: e.message || String(e) }
  })
})

$fend('providers', (data) => {
  const mj = readModelsJson() || { providers: {} }
  const st = readSettingsJson()
  const def = String(st.defaultProvider || '')
  const pm = parseModel(String((data && data.model) || '').trim())
  let eff = def
  if (pm.provider) {
    if ((mj.providers || {})[pm.provider]) eff = pm.provider
    else if (pm.provider === 'oc' && (mj.providers || {}).omniroute) eff = 'omniroute'
  }
  const hidden = ((st.hiddenProviders) || []).filter((x) => typeof x === 'string')
  const list = []
  for (const p of PROVIDER_PRESETS) {
    if (hidden.indexOf(p.name) >= 0) continue
    const existing = (mj.providers || {})[p.name] || {}
    const hasKey = !!(existing.apiKey && String(existing.apiKey) !== '' && !/^\$/.test(String(existing.apiKey)))
    const presetModels = (existing.models && existing.models.length) ? existing.models : p.models
    list.push({ name: p.name, baseUrl: existing.baseUrl || p.baseUrl, api: existing.api || p.api, hasKey: hasKey, keySet: !!existing.apiKey, current: eff === p.name, custom: false, overridden: !!(existing.models && existing.models.length), models: presetModels.map((m) => (m && m.id) || '').filter(Boolean) })
  }
  for (const key in (mj.providers || {})) {
    if (key === 'omniroute') continue
    if (PROVIDER_PRESETS.find((p) => p.name === key)) continue
    const existing = mj.providers[key] || {}
    const hasKey = !!(existing.apiKey && String(existing.apiKey) !== '' && !/^\$/.test(String(existing.apiKey)))
    list.push({ name: key, baseUrl: existing.baseUrl || '', api: existing.api || 'openai-completions', hasKey: hasKey, keySet: !!existing.apiKey, current: eff === key, custom: true, models: (existing.models || []).map((m) => (m && m.id) || '').filter(Boolean) })
  }
  let omniCurrent = eff === 'omniroute'
  let omniStatus = 'disabled'
  if (omniCurrent) omniStatus = (mj.providers || {}).omniroute ? 'enabled · default provider' : 'pending config'
  else if ((mj.providers || {}).omniroute) omniStatus = 'installed · not default'
  return new Promise((resolve) => {
    httpGetUrl(OMNI_HOST + '/', 3000).then((r) => {
      const running = r.status === 200
      if (running) {
        if (omniStatus.indexOf('enabled') < 0 && omniStatus.indexOf('pending') < 0) omniStatus = 'running'
        else if (omniStatus.indexOf('pending') === 0) omniStatus = 'running · pending config'
      } else {
        if (omniStatus.indexOf('enabled') >= 0) omniStatus = 'default but not running'
      }
      resolve({ ok: true, providers: list, omniCurrent: omniCurrent, omniStatus: omniStatus, hasOmniConfig: !!(mj.providers || {}).omniroute, omniRunning: running })
    }).catch(() => { resolve({ ok: true, providers: list, omniCurrent: omniCurrent, omniStatus: omniStatus, hasOmniConfig: !!(mj.providers || {}).omniroute, omniRunning: false }) })
  })
})

$fend('provider_save', (data) => {
  const name = data && data.name ? String(data.name).trim() : ''
  if (!name) return { ok: false, error: 'provider name required' }
  try {
    const mj = readModelsJson() || { providers: {} }
    if (!mj.providers) mj.providers = {}
    const st = readSettingsJson()
    if (name === 'omniroute') {
      const old = mj.providers.omniroute || {}
      mj.providers.omniroute = Object.assign({ baseUrl: OMNI_HOST + '/v1', api: 'openai-completions', apiKey: old.apiKey || 'omniroute', authHeader: true }, old, { compat: old.compat || { supportsDeveloperRole: false, supportsReasoningEffort: false, thinkingFormat: 'deepseek' } })
      st.defaultProvider = 'omniroute'
      delete st.defaultModel
      return new Promise((resolve) => {
        fetchOmniModels().then((models) => {
          if (models.length) {
            mj.providers.omniroute.models = models
            st.defaultModel = 'omniroute/' + models[0].id
          } else if (!(mj.providers.omniroute.models || []).length) {
            mj.providers.omniroute.models = []
          }
          writeFileJson(modelsFile(), mj)
          writeFileJson(SETTINGS_FILE(), st)
          try { $store.set('pi_models_cache', 'null') } catch(e) {}
          try { $store.set('pi_models_time', '0') } catch(e) {}
          resolve({ ok: true, model: String(st.defaultModel || '') })
        }).catch(() => {
          writeFileJson(modelsFile(), mj)
          writeFileJson(SETTINGS_FILE(), st)
          try { $store.set('pi_models_cache', 'null') } catch(e) {}
          try { $store.set('pi_models_time', '0') } catch(e) {}
          resolve({ ok: true, model: String(st.defaultModel || '') })
        })
      })
    } else {
      const preset = PROVIDER_PRESETS.find((p) => p.name === name)
      if (!preset) return { ok: false, error: 'unknown provider: ' + name }
      const apiKey = data && data.apiKey ? String(data.apiKey).trim() : ''
      if (!apiKey) {
        const old = (mj.providers[name] || {}).apiKey
        if (!old) return { ok: false, error: 'API key required for ' + name }
      }
      const prev = mj.providers[name] || {}
      mj.providers[name] = { baseUrl: preset.baseUrl, api: preset.api, apiKey: apiKey || prev.apiKey || null, authHeader: true, models: preset.models }
      if (!mj.providers[name].apiKey) delete mj.providers[name].apiKey
      st.defaultProvider = name
      st.defaultModel = preset.models[0] ? name + '/' + preset.models[0].id : undefined
      writeFileJson(modelsFile(), mj)
      writeFileJson(SETTINGS_FILE(), st)
      try { $store.set('pi_models_cache', 'null') } catch(e) {}
      try { $store.set('pi_models_time', '0') } catch(e) {}
      // Preset models are already saved and usable. Now try to refresh the list from the provider API.
      return new Promise((resolve) => {
        fetchModelsForApi(preset.api, preset.baseUrl, mj.providers[name].apiKey, name).then((res) => {
          try {
            const fresh = readModelsJson()
            if (fresh && fresh.providers && fresh.providers[name]) {
              const metaMap = {}
              for (const m of preset.models) metaMap[m.id] = m
              const merged = []
              for (const id of res.ids) {
                const src = metaMap[id]
                merged.push(src ? Object.assign({}, src, { id: id }) : { id: id, name: id, contextWindow: 128000, maxTokens: 16384 })
              }
              if (merged.length) {
                fresh.providers[name].models = merged
                // keep the default model usable if the preset default vanished from the live list
                const defId = String(st.defaultModel || '').split('/').slice(1).join('/')
                if (defId && !merged.some((m) => m.id === defId)) {
                  st.defaultModel = name + '/' + merged[0].id
                  writeFileJson(SETTINGS_FILE(), st)
                }
                writeFileJson(modelsFile(), fresh)
                try { $store.set('pi_models_cache', 'null') } catch(e2) {}
                try { $store.set('pi_models_time', '0') } catch(e2) {}
              }
            }
          } catch(e) {}
          resolve({ ok: true, model: String(st.defaultModel || '') })
        }).catch(() => {
          resolve({ ok: true, model: String(st.defaultModel || '') })
        })
      })
    }
  } catch(e) {
    return { ok: false, error: e.message }
  }
})

$fend('provider_custom_save', (data) => {
  const name = data && data.name ? String(data.name).trim().replace(/\s+/g, '-').toLowerCase() : ''
  const baseUrl = data && data.baseUrl ? String(data.baseUrl).trim() : ''
  const apiKey = data && data.apiKey ? String(data.apiKey).trim() : ''
  const api = data && data.api ? String(data.api).trim() : 'openai-completions'
  if (!name) return { ok: false, error: 'provider name required' }
  if (!/^[a-z0-9][a-z0-9-]*$/.test(name)) return { ok: false, error: 'name must be letters/numbers/hyphens only' }
  if (!baseUrl) return { ok: false, error: 'base URL required' }
  if (name === 'omniroute') return { ok: false, error: 'name "omniroute" is reserved' }
  try {
    const mj = readModelsJson() || { providers: {} }
    if (!mj.providers) mj.providers = {}
    const st = readSettingsJson()
    const prev = mj.providers[name] || {}
    const finalKey = apiKey || prev.apiKey || null
    if (!finalKey) return { ok: false, error: 'API key required for ' + name }
    const modelIds = Array.isArray(data.models) ? data.models.map((m) => String(m).trim()).filter(Boolean) : []
    const models = modelIds.map((id) => ({ id: id, name: id, contextWindow: 128000, maxTokens: 16384 }))
    if (!models.length && !(data.models || []).length) {
      // editing without touching the model field: keep previously saved models
      const pm = (prev.models || []).map((m) => (m && m.id) ? m.id : '')
      for (const mid of pm) { if (mid) models.push({ id: mid, name: mid, contextWindow: 128000, maxTokens: 16384 }) }
    }
    const finishSave = (list) => {
      if (!list.length) return { ok: false, error: 'no models available: type model ids or use fetch' }
      mj.providers[name] = { baseUrl: baseUrl, api: api, apiKey: finalKey, authHeader: true, models: list }
      if (!mj.providers[name].apiKey) delete mj.providers[name].apiKey
      st.defaultProvider = name
      st.defaultModel = name + '/' + list[0].id
      writeFileJson(modelsFile(), mj)
      writeFileJson(SETTINGS_FILE(), st)
      try { $store.set('pi_models_cache', 'null') } catch(e) {}
      try { $store.set('pi_models_time', '0') } catch(e) {}
      return { ok: true, model: String(st.defaultModel || '') }
    }
    if (models.length) return finishSave(models)
    // no models provided: try auto-discovery from the endpoint, same as pi login flow
    return new Promise((resolve) => {
      fetchModelsForApi(api, baseUrl, finalKey, name).then((res) => {
        resolve(finishSave(res.ids.map((id) => ({ id: id, name: id, contextWindow: 128000, maxTokens: 16384 }))))
      }).catch((e) => {
        resolve({ ok: false, error: 'no models provided and auto-fetch failed: ' + (e.message || e) })
      })
    })
  } catch(e) {
    return { ok: false, error: e.message }
  }
})

$fend('provider_delete', (data) => {
  const name = data && data.name ? String(data.name).trim() : ''
  if (!name) return { ok: false, error: 'provider name required' }
  if (name === 'omniroute') return { ok: false, error: 'omniroute cannot be deleted' }
  try {
    const mj = readModelsJson() || { providers: {} }
    if (!mj.providers) mj.providers = {}
    const isPreset = !!PROVIDER_PRESETS.find((p) => p.name === name)
    const st = readSettingsJson()
    if (!st.hiddenProviders) st.hiddenProviders = []
    if (isPreset) {
      // presets live in PROVIDER_PRESETS, not models.json; hide via settings so they don't reappear
      if (st.hiddenProviders.indexOf(name) < 0) st.hiddenProviders.push(name)
    } else {
      if (!mj.providers[name]) return { ok: false, error: 'provider not found: ' + name }
      delete mj.providers[name]
    }
    if (st.defaultProvider === name) {
      st.defaultProvider = ''
      delete st.defaultModel
    }
    writeFileJson(modelsFile(), mj)
    writeFileJson(SETTINGS_FILE(), st)
    try { $store.set('pi_models_cache', 'null') } catch(e) {}
    try { $store.set('pi_models_time', '0') } catch(e) {}
    return { ok: true }
  } catch(e) {
    return { ok: false, error: e.message }
  }
})

$fend('models', async () => {
  const now = Date.now()
  const goodModels = (arr) => { const bad = readBadModels(); return (arr || []).filter((m) => m && !bad[m]) }
  let cached, cachedTime
  try { cached = JSON.parse($store.get('pi_models_cache') || 'null') } catch(e) {}
  try { cachedTime = Number($store.get('pi_models_time') || 0) } catch(e) {}
  if (cached && now - cachedTime < 600000) return { models: goodModels(cached), cached: true }
  if (cached) {
    try {
      const list = collectConfiguredModels(readModelsJson())
      if (list.length) {
        $store.set('pi_models_cache', JSON.stringify(list))
        $store.set('pi_models_time', String(now))
        return { models: list }
      }
    } catch(e) {}
    return { models: goodModels(cached) }
  }
  const list = collectConfiguredModels(readModelsJson())
  if (list.length) {
    $store.set('pi_models_cache', JSON.stringify(list))
    $store.set('pi_models_time', String(now))
    return { models: list }
  }
  const mj = readModelsJson() || { providers: {} }
  if ((mj.providers || {}).omniroute) {
    const omniModels = await fetchOmniModels()
    if (omniModels.length) {
      mj.providers.omniroute.models = omniModels
      writeFileJson(modelsFile(), mj)
      const omniList = collectConfiguredModels(readModelsJson())
      if (omniList.length) {
        $store.set('pi_models_cache', JSON.stringify(omniList))
        $store.set('pi_models_time', String(now))
        return { models: omniList }
      }
    }
  }
  try {
    const r = await execAsync(redirCmd(PI_BIN + ' --list-models'), 15000)
    const lines = (r.stdout || '').split('\n').filter(Boolean)
    const models = []
    for (const ln of lines) {
      const m = ln.trim().split(/\s{2,}/)
      if (m.length >= 2 && m[0] && m[1] && m[0] !== 'provider') models.push(m[0] + '/' + m[1])
    }
    if (models.length) {
      $store.set('pi_models_cache', JSON.stringify(models))
      $store.set('pi_models_time', String(now))
      return { models: models }
    }
    return { models: goodModels(cached) }
  } catch(e) {
    return { models: cached || [] }
  }
})

const ctxLimitMem = {}
const getCtxLimit = (modelStr) => {
  return new Promise((resolve) => {
    const pm = parseModel(modelStr)
    if (!pm.model || !pm.provider) return resolve(0)
    const memKey = pm.provider + '/' + pm.model
    if (ctxLimitMem[memKey] > 0) return resolve(ctxLimitMem[memKey])
    const cacheKey = 'pi_ctxlimit_' + pm.provider + '_' + pm.model
    try {
      const cached = Number($store.get(cacheKey))
      if (cached > 0) { ctxLimitMem[memKey] = cached; return resolve(cached) }
    } catch(e) {}
    let limit = 0
    try {
      const mj = readModelsJson()
      const conf = mj && mj.providers && mj.providers[pm.provider]
      const mods = (conf && conf.models) || []
      for (const m of mods) {
        if (m && m.id === pm.model && m.contextWindow) { limit = m.contextWindow; break }
      }
    } catch(e) {}
    if (limit) {
      ctxLimitMem[memKey] = limit
      try { $store.set(cacheKey, String(limit)) } catch(e2) {}
    }
    resolve(limit)
  })
}

$fend('ctxinfo', (data) => {
  const modelStr = data && data.model ? data.model : ''
  return getCtxLimit(modelStr).then((limit) => {
    return { model: parseModel(modelStr).model || '', limit: limit }
  })
})

const findSessionFile = (id) => {
  if (!id) return ''
  const dir = sessionDirFor(getWorkDir())
  let files = []
  try { files = fs.readdirSync(dir) } catch(e) { return '' }
  for (const f of files) {
    if (!f.endsWith('.jsonl')) continue
    try {
      const first = fs.readFileSync(path.join(dir, f), 'utf8').split('\n')[0]
      if (!first) continue
      const h = JSON.parse(first)
      if (h.type === 'session' && h.id === id) return path.join(dir, f)
    } catch(e) {}
  }
  return ''
}

const getSessionUsage = (id) => {
  return new Promise((resolve) => {
    const full = findSessionFile(id)
    if (!full) return resolve({ used: 0, model: '' })
    try {
      const lines = fs.readFileSync(full, 'utf8').split('\n')
      let used = 0
      let sessionModel = ''
      let lastAsstUsage = null
      for (const ln of lines) {
        if (!ln.trim()) continue
        let e
        try { e = JSON.parse(ln) } catch(err) { continue }
        if (e.type === 'session' && e.model) {
          sessionModel = e.model
        }
        if (e.type !== 'message') continue
        const msg = e.message || {}
        if (msg.provider && msg.model) {
          sessionModel = (msg.provider || '') + '/' + msg.model
        }
        if (msg.role === 'assistant' && msg.usage && msg.usage.totalTokens) {
          lastAsstUsage = msg.usage.totalTokens
        }
      }
      // Use the most recent assistant message's usage (better proxy for current context)
      used = lastAsstUsage !== null ? lastAsstUsage : 0
      resolve({ used: used, model: sessionModel })
    } catch(e) { resolve({ used: 0, model: '' }) }
  })
}

$fend('session_ctx', (data) => {
  const id = data && data.id
  return getSessionUsage(id).then((res) => {
    // Use the session's actual model for limit lookup, not the frontend's current model
    const modelStr = res.model || (data && data.model || '').replace(/\r/g, '')
    return getCtxLimit(modelStr).then((limit) => {
      return { used: res.used, limit: limit, model: res.model }
    })
  })
})

const listPiSessions = () => {
  const wd = getWorkDir()
  const dir = sessionDirFor(wd)
  const out = []
  let files = []
  try { files = fs.readdirSync(dir).filter((f) => f.endsWith('.jsonl')) } catch(e) { return [] }
  for (const f of files) {
    try {
      const st = fs.statSync(path.join(dir, f))
      const raw = fs.readFileSync(path.join(dir, f), 'utf8')
      const lines = raw.split('\n')
      let header = null
      let name = ''
      for (const ln of lines) {
        if (!ln.trim()) continue
        let e
        try { e = JSON.parse(ln) } catch(err) { continue }
        if (!header && e.type === 'session') { header = e; continue }
        if (e.type === 'session_info' && typeof e.name === 'string' && e.name) name = e.name
      }
      if (!header) continue
      if (header.cwd && header.cwd !== wd) continue
      out.push({
        id: header.id,
        title: name || header.id,
        created: Date.parse(header.timestamp) || st.birthtimeMs || st.mtimeMs,
        updated: (st.mtimeMs || Date.now())
      })
    } catch(e) {}
  }
  out.sort((a, b) => (b.updated || 0) - (a.updated || 0))
  return out.slice(0, 50)
}

$fend('pi_sessions', () => { return { sessions: listPiSessions() } })

$fend('pi_delete_session', (data) => {
  if (!data || !data.id) return { ok: false }
  const full = findSessionFile(data.id)
  if (!full) return { ok: false, error: 'session not found' }
  try {
    fs.unlinkSync(full)
    return { ok: true }
  } catch(e) {
    return { ok: false, error: e.message }
  }
})

const convFromFile = (full) => {
  const lines = fs.readFileSync(full, 'utf8').split('\n')
  const entries = []
  let leaf = null
  for (const ln of lines) {
    if (!ln.trim()) continue
    let e
    try { e = JSON.parse(ln) } catch(err) { continue }
    if (e.type === 'session') continue
    if (e.type === 'message' && e.message) { entries.push(e); leaf = e }
    else if (e.type === 'compaction') entries.push(e)
  }
  if (!entries.length) return []
  const byId = {}
  for (const e of entries) byId[e.id] = e
  const chain = []
  let cur = leaf
  let guard = 0
  while (cur && guard++ < 10000) {
    chain.push(cur)
    if (!cur.parentId) break
    cur = byId[cur.parentId] || null
  }
  chain.reverse()
  const out = []
  let curAsst = null
  let curTokens = 0
  let curModel = ''
  let curErrored = false
  const finalize = () => {
    if (!curAsst) return
    let meta = curErrored ? '⚠ ' : '✓ '
    const bits = []
    if (curModel) bits.push(curModel)
    if (curTokens) bits.push('⚙ ' + curTokens + ' tokens')
    meta += bits.join(' | ')
    curAsst.meta = meta.trim() || '✓'
    curAsst.errored = curErrored
    curAsst.streaming = false
    curAsst = null
    curTokens = 0
    curModel = ''
    curErrored = false
  }
  for (const e of chain) {
    if (e.type === 'compaction') continue
    const msg = e.message || {}
    const role = msg.role || 'assistant'
    const parts = msg.content || []
    if (role === 'user') {
      finalize()
      let text = ''
      for (const p of parts) if (p && p.type === 'text') text += (p.text || '')
      if (text.trim()) out.push({ role: 'user', content: text })
      continue
    }
    if (role === 'toolResult') {
      if (curAsst) {
        let text = ''
        for (const p of parts) if (p && p.type === 'text') text += (p.text || '')
        if (text) curAsst.parts.push({ t: 'out', c: maskSecrets(text) })
      }
      continue
    }
    if (role === 'bashExecution') {
      if (curAsst) {
        curAsst.parts.push({ t: 'ref', c: '$ ' + maskSecrets(msg.command), cls: 'cmd' })
        if (msg.output) curAsst.parts.push({ t: 'out', c: maskSecrets(msg.output) })
      }
      continue
    }
    const plist = []
    for (const p of parts) {
      if (!p) continue
      if (p.type === 'text' && p.text) plist.push({ t: 'text', c: p.text })
      else if (p.type === 'thinking' && p.thinking) plist.push({ t: 'ref', c: '✱ reasoning', cls: 'reasoning', body: p.thinking })
      else if (p.type === 'toolCall') {
        const arg = toolArg(p.arguments || {})
        const ref = toolCallRef(p.name || 'tool', arg)
        plist.push({ t: 'ref', c: ref.c, cls: ref.cls })
      }
    }
    if (msg.errorMessage) plist.push({ t: 'text', c: 'Error: ' + msg.errorMessage, cls: 'err-text' })
    if (!plist.length) continue
    if (!curAsst) { curAsst = { role: 'assistant', parts: [] }; out.push(curAsst) }
    for (const k of plist) curAsst.parts.push(k)
    if (msg.errorMessage) curErrored = true
    if (msg.usage && msg.usage.totalTokens) curTokens = msg.usage.totalTokens
    if (msg.model) curModel = (msg.provider || '') + '/' + msg.model
  }
  finalize()
  return out
}

$fend('session_messages', (data) => {
  const id = data && data.id
  if (!id) return { messages: [] }
  const full = findSessionFile(id)
  if (!full) return { messages: [] }
  try {
    return { messages: convFromFile(full) }
  } catch(e) {
    return { messages: [] }
  }
})

$fend('workspace', () => { return { ok: true, cwd: getWorkDir() } })

$fend('workspace_set', (data) => {
  const d = data && data.cwd ? String(data.cwd).trim() : ''
  if (!d) return { ok: false, error: 'cwd required' }
  try {
    if (!fs.existsSync(d) || !fs.statSync(d).isDirectory()) return { ok: false, error: 'not a directory: ' + d }
  } catch(e) {
    return { ok: false, error: e.message }
  }
  setWorkDir(d)
  return { ok: true, cwd: d }
})

$fend('commands', () => {
  return { ok: true, commands: [
    { name: 'new', description: 'start a new session' },
    { name: 'clear', description: 'clear chat display (keep current session)' },
    { name: 'compact', description: 'compact context to reduce token usage' },
    { name: 'session', description: 'open session panel, or /session <id> to load one' },
    { name: 'model', description: 'switch model (use /model <model>)' },
    { name: 'theme', description: 'open theme selector' },
    { name: 'help', description: 'list commands' }
  ] }
})

const runProcs = {}

$fend('start', (data) => {
  if (!data || !data.prompt) return { error: 'prompt is required' }
  const runId = data.runId || Date.now() + '-' + Math.random().toString(36).slice(2, 8)
  const cwd = getWorkDir()
  const prompt = String(data.prompt).slice(0, 1200)
  const sessionId = data.session || ''
  const modelStr = (data.model || '').replace(/\r/g, '')

  let curSession = sessionId || ''
  const MAX_RETRY = 3
  let retryLeft = MAX_RETRY
  const MAX_SWITCH = 10
  const FREE_THRESHOLD = 6  // 超过此数量后，只切换带 "free" 字样的模型
  let switchLeft = MAX_SWITCH
  let switchBudgetNotified = false
  let retrying = false
  const triedModels = new Set()
  // per-tool hard timeout: a single tool call (e.g. `pm2 restart elecV2P`) can hang forever when
  // the spawned shell leaves a background daemon holding the stdio pipe, so pi never emits
  // tool_execution_end. Cap it (default 10min, configure via settings.json `piToolTimeout` seconds).
  const MAX_TOOL_MS = (() => {
    const v = Number(readSettingsJson().piToolTimeout)
    return isFinite(v) && v > 0 ? v * 1000 : 10 * 60 * 1000
  })()
  const wedgedTools = new Set()   // tool arg-signatures that already timed out this run (avoid re-run loops)
  let autoRetryCount = 0   // pi internal auto-retries seen
  let lastErrText = ''     // last errorMessage from events
  let lastErrAt = 0        // ms timestamp of last errorMessage, to flag error-recovery compaction
  const hardFails = {}     // per-model consecutive 5xx/network failure count
  let runHadOutput = false // did we stream any text/reasoning/tool output
  let stderrTail = ''      // tail of stderr for exit diagnosis

  const defModel = (() => {
    const st = readSettingsJson()
    let dm = String(st.defaultModel || '').trim()
    if (!dm && st.defaultProvider) {
      const mj = readModelsJson() || { providers: {} }
      const conf = mj.providers && mj.providers[st.defaultProvider]
      const mods = (conf && conf.models) || []
      if (mods.length) dm = st.defaultProvider + '/' + mods[0].id
    }
    return dm
  })()

  let proc = null

  let streamEnded = false
  let sessionSent = false
  let stepCount = 0
  let tokens = null
  let model = null
  let activeModel = modelStr || defModel || ''
  let initShown = false
  const runningTools = {}
  const seenTools = {}
  const lastToolOut = {}
  // reasoning 块开关：同一消息内可能有多次 thinking（contentIndex 可能复用），
  // 用单一「当前是否打开」标志保证：每块只发一次「✱ reasoning」，
  // 不会因 ci 复用而漏掉后面的块。收尾时只复位标志，不额外输出「done」行（后台 session 里也不存在该行）。
  let reasoningOpen = false
  const reasonBegin = () => {
    if (!reasoningOpen) {
      reasoningOpen = true
      sendRef('✱ reasoning', 'reasoning')
    }
  }
  const reasonEnd = () => {
    if (reasoningOpen) {
      reasoningOpen = false
      sendRef('✓ reasoning done', 'reasoning')
    }
  }
  const streamTc = {}
  let tcUidSeq = 0
  let compactingSince = 0
  let compactTick = null
  let compactTag = '' // 'error recovery' / 'overflow' — carried to the done line
  let watchdog = null
  let aliveTimer = null
  let toolHeartbeat = null

  const kickWatchdog = () => {
    if (watchdog) clearTimeout(watchdog)
    watchdog = setTimeout(() => { finish({ timeout: true }) }, 600000)
  }

  const send = (type, payload) => {
    if (type === 'text' || type === 'reasoning' || type === 'out') runHadOutput = true
    if (type !== 'done' && type !== 'error') kickWatchdog()
    $ws.sse(APP_CH, JSON.stringify(Object.assign({ runId: runId }, payload || {}, { type: type })))
  }
  const sendRef = (line, cls) => { send('ref', { content: line, cls: cls || '' }) }
  const extractToolText = (pr) => {
    if (typeof pr === 'string') return pr
    if (!pr || typeof pr !== 'object') return ''
    if (pr.output || pr.result) return String(pr.output || pr.result)
    if (pr.content && Array.isArray(pr.content)) {
      const text = pr.content.map((c) => (c && typeof c === 'object' && c.type === 'text') ? c.text : '').join('\n')
      return text
    }
    if (typeof pr.text === 'string') return pr.text
    return ''
  }
  const emitOut = (callId, out, fn) => {
    if (!out) return
    const last = lastToolOut[callId] || ''
    let delta
    if (String(out).indexOf(last) === 0) delta = String(out).slice(last.length)
    else delta = last ? '\n' + out : out
    if (delta) fn(delta)
    lastToolOut[callId] = String(out)
  }
  const pushCtx = (used, limit) => {
    send('ctx', {
      used: used || 0, limit: limit || 0,
      pct: limit ? Math.round((used || 0) / limit * 1000) / 10 : null,
      model: model
    })
  }
  const emitCtx = (used) => {
    if (!used) return
    getCtxLimit(model).then((limit) => { pushCtx(used, limit) }).catch(() => { pushCtx(used, 0) })
  }
  const normTokens = (usage) => {
    if (!usage) return null
    const total = usage.total || usage.totalTokens
    if (!total) return null
    return { total: total }
  }
  const finish = (payload) => {
    if (streamEnded) return
    if (switchLeft < MAX_SWITCH && !(payload && payload.timeout)) {
      // 整个 run 成功完成才重置自动切换次数；期间的真实失败会累积计数，避免中途闪断即清零
      switchLeft = MAX_SWITCH
      retryLeft = MAX_RETRY
      switchBudgetNotified = false
      sendRef('✓ ' + (model || 'model') + ' run completed · switch budget reset (0/' + MAX_SWITCH + ')', 'info')
    }
    streamEnded = true
    if (watchdog) clearTimeout(watchdog)
    if (aliveTimer) clearInterval(aliveTimer)
    if (toolHeartbeat) clearInterval(toolHeartbeat)
    try { delete runProcs[runId] } catch(e) {} try { $cache.delete('pi_run_' + runId) } catch(e) {}
    // watchdog 超时结束时 pi 可能仍在运行，需要杀掉，否则会继续写 session
    if (payload && payload.timeout) killTree(proc)
    send('done', Object.assign({ steps: stepCount }, payload || {}, payload.tokens ? { tokens: normTokens(payload.tokens) } : {}))
  }
  const fail = (msg) => {
    if (streamEnded) return
    streamEnded = true
    if (watchdog) clearTimeout(watchdog)
    if (aliveTimer) clearInterval(aliveTimer)
    if (toolHeartbeat) clearInterval(toolHeartbeat)
    try { delete runProcs[runId] } catch(e) {} try { $cache.delete('pi_run_' + runId) } catch(e) {}
    killTree(proc)
    send('error', { content: msg })
  }

  const onEvent = (ev) => {
    const t = ev.type
    if (t === 'session') {
      if (ev.id && !sessionSent) {
        sessionSent = true
        curSession = ev.id
        send('session', { id: ev.id })
      }
      return
    }
    if (t === 'agent_start') {
      if (!initShown) {
        initShown = true
        const req = (modelStr || defModel || '').replace(/\r/g, '')
        send('init', { content: '> build · ' + (req || '...') })
      }
      return
    }
    if (t === 'turn_start') { stepCount++; return }
    if (t === 'turn_end') { return }
    if (t === 'message_update') {
      if (ev.usage && ev.usage.totalTokens) {
        tokens = ev.usage
        emitCtx(ev.usage.totalTokens)
      }
      const ame = ev.assistantMessageEvent || {}
      const at = ame.type
      const ci = ame.contentIndex || 0
      if (at === 'text_delta') {
        reasonEnd()
        if (ame.delta) send('text', { content: ame.delta })
        return
      }
      if (at === 'thinking_start' || at === 'thinking_delta') {
        reasonBegin()
        if (at === 'thinking_delta' && ame.delta) send('reasoning', { content: ame.delta })
        return
      }
      if (at === 'thinking_end') {
        reasonEnd()
        return
      }
      if (at === 'toolcall_start') {
        // 工具调用正在流式生成（名称要到 toolcall_end 才知道）：先亮占位脉冲，消除静默等待感
        // deepseek 类后端可能在工具调用之后才补发 thinking_end：
        // 这里先把仍未结束的 reasoning 块标成 done，保证「✓ reasoning done」行排在工具 ref 之前
        reasonEnd()
        const uid = 'tc-' + (++tcUidSeq)
        streamTc[ci] = uid
        send('ref', { content: '◈ generating tool call…', cls: 'tool', uid: uid })
        send('running', { tool: 'tool-call', callId: uid })
        return
      }
      if (at === 'toolcall_delta') {
        return // 内容累积中，保持脉冲点亮；toolcall_end 一次性显示最终 ref
      }
      if (at === 'toolcall_end') {
        const tc = ame.toolCall || {}
        const arg = toolArg(tc.arguments || {})
        const callId = tc.toolCallId || tc.id || tc.name || 'tool'
        const uid = streamTc[ci] || undefined
        delete streamTc[ci]
        if (uid) {
          // 把占位行「就地升级」为最终 ref（← edit · -N/+N），避免多出/闪断一行
          seenTools[callId] = true
          const ref = toolCallRef(tc.name || 'tool', arg)
          send('ref', { content: ref.c, cls: ref.cls, uid: uid })
        } else if (!seenTools[callId]) {
          seenTools[callId] = true
          const ref = toolCallRef(tc.name || 'tool', arg)
          sendRef(ref.c, ref.cls)
        }
        return
      }
      return
    }
    if (t === 'message_end') {
      const msg = ev.message || {}
      for (const k in streamTc) delete streamTc[k]
      reasonEnd()
      if (msg.provider && msg.model) {
        model = msg.provider + '/' + msg.model
        send('init', { content: '> build · ' + model })
      }
      if (msg.usage && msg.usage.totalTokens) {
        tokens = msg.usage
        emitCtx(msg.usage.totalTokens)
      }
      if (!msg.errorMessage) {
        lastErrAt = 0   // fresh successful response — later compaction is context-driven, not error recovery
      } else {
        handleModelError(String(msg.errorMessage))
      }
      return
    }
    if (t === 'error' || t === 'session_error') {
      // terminal / session-level errors don't always carry a message_end — feed them through the same retry/switch/fail chain
      const errObj = ev.error || ev || {}
      const em = typeof errObj === 'string' ? errObj : (errObj.message || errObj.error || errObj.errorMessage || '')
      handleModelError(String(em || '').split('\n')[0].slice(0, 400))
      return
    }
    if (t === 'tool_execution_start') {
      const callId = ev.toolCallId || ev.toolName
      const arg = toolArg(ev.args || {})
      if (!seenTools[callId]) {
        seenTools[callId] = true
        const ref = toolCallRef(ev.toolName || 'tool', arg)
        sendRef(ref.c, ref.cls)
      }
      runningTools[callId] = { tool: ev.toolName || 'tool', arg: arg, started: Date.now(), lastUpdate: Date.now(), lastOutput: '' }
      send('running', { tool: ev.toolName || 'tool', callId: callId })
      return
    }
    if (t === 'tool_execution_update') {
      const callId = ev.toolCallId || ev.toolName
      const rt = runningTools[callId] || { lastUpdate: Date.now() }
      rt.lastUpdate = Date.now()
      const pr = extractToolText(ev.partialResult)
      if (pr) {
        rt.lastOutput = pr
        emitOut(callId, maskSecrets(pr), (d) => { send('out', { content: d }) })
      }
      return
    }
    if (t === 'tool_execution_end') {
      const callId = ev.toolCallId || ev.toolName
      delete runningTools[callId]
      const tname = ev.toolName || 'tool'
      let out = extractToolText(ev.result)
      // edit/write 后台结果里带有的 diff/patch，一并返回前端显示
      if (!ev.isError && isFileEditTool(tname) && ev.result && ev.result.details) {
        const patch = ev.result.details.patch || ev.result.details.diff || ''
        if (patch) out = (out ? out + '\n' : '') + String(patch).slice(0, 6000)
      }
      if (out) emitOut(callId, maskSecrets(out), (d) => { send('out', { content: d }) })
      sendRef((ev.isError ? '✗ ' : '✓ ') + tname + (ev.isError ? ' failed' : ' done'), 'tool')
      return
    }
    if (t === 'bash_execution_update') {
      if (ev.delta) send('out', { content: maskSecrets(ev.delta) })
      return
    }
    if (t === 'compaction_start') {
      compactingSince = Date.now()
      const afterErr = lastErrAt && Date.now() - lastErrAt < 30000
      const reason = String(ev.reason || '')
      compactTag = afterErr ? 'error recovery' : (reason === 'overflow' ? 'overflow' : '')
      const base = '↻ compacting…' + (compactTag ? ' (' + compactTag + ')' : '')
      send('ref', { content: base, cls: 'info', uid: 'compact' })
      send('running', { tool: 'context-compaction', callId: 'compact' })
      if (!compactTick) {
        compactTick = setInterval(() => {
          if (!compactingSince || streamEnded) {
            if (compactTick) { clearInterval(compactTick); compactTick = null }
            return
          }
          const s = Math.round((Date.now() - compactingSince) / 1000)
          send('ref', { content: base + ' (' + s + 's)', cls: 'info', uid: 'compact' })
        }, 2000)
      }
      return
    }
    if (t === 'compaction_end') {
      compactingSince = 0
      if (compactTick) { clearInterval(compactTick); compactTick = null }
      const r = ev.result || {}
      const sum = typeof r.summary === 'string' && r.summary ? String(r.summary).trim() : ''
      if (sum) send('out', { content: maskSecrets(sum) })
      let line = '✓ context compacted' + (compactTag ? ' (' + compactTag + ')' : '')
      compactTag = ''
      if (r.tokensBefore && r.estimatedTokensAfter) {
        line += ' · ' + Math.round(r.tokensBefore / 1000) + 'k → ' + Math.round(r.estimatedTokensAfter / 1000) + 'k tokens'
      }
      sendRef(line, 'info')
      return
    }
    if (t === 'auto_retry_start') { autoRetryCount++; sendRef('↻ retrying…', 'info retrying'); return }
    if (t === 'agent_end' || t === 'agent_settled') {
      endRun(0, 'event')
      return
    }
  }

  const loadCandidateModels = () => {
    let list = collectConfiguredModels(readModelsJson())  // excludes bad models already
    if (!list.length) {
      // favend runtime may not see models.json (e.g. empty), but the frontend models fend
      // populates pi_models_cache (incl. --list-models fallback) — reuse that
      try {
        const c = JSON.parse($store.get('pi_models_cache') || 'null')
        if (Array.isArray(c) && c.length) {
          const bad = readBadModels()
          list = c.filter((m) => m && !bad[m])
        }
      } catch(e) {}
    }
    return list
  }
  const loadOrderedModels = () => {
    let list = []
    const mj = readModelsJson()
    if (mj && mj.providers) {
      for (const p of Object.keys(mj.providers)) {
        const c = mj.providers[p] || {}
        for (const m of (c.models || [])) if (m && m.id) list.push(p + '/' + m.id)
      }
    }
    if (!list.length) {
      try {
        const c = JSON.parse($store.get('pi_models_cache') || 'null')
        if (Array.isArray(c) && c.length) list = c.slice()
      } catch(e) {}
    }
    return list
  }
  const switchToNextModel = (etxt, reason) => {
    if (retrying) return false
    if (switchLeft <= 0) {
      // switch budget exhausted — no further auto-switch attempt is possible, the run stops
      // (no model is actually switched here; the old message claiming "model switched" was misleading)
      if (switchBudgetNotified) return false
      switchBudgetNotified = true
      sendRef('⚠ auto-switch budget exhausted (' + (MAX_SWITCH - switchLeft) + '/' + MAX_SWITCH + ' used) — all fallbacks failed, run stopped, model not switched', 'info')
      return false
    }
    const gone = model || modelStr || defModel || ''
    triedModels.add(gone)
    const conf = loadCandidateModels()    // currently available (excludes bad)
    const order = loadOrderedModels()     // full list, preserves provider/model order
    const ord = order.length ? order : conf
    
    // 计算已使用的切换次数
    const switchesUsed = MAX_SWITCH - switchLeft
    // 超过阈值后，只使用带 "free" 字样的模型
    const freeOnly = switchesUsed >= FREE_THRESHOLD
    if (freeOnly) {
      sendRef('↻ switch count ' + switchesUsed + ' >= ' + FREE_THRESHOLD + ', free-only mode active', 'info')
    }
    
    const baseIdx = ord.indexOf(gone)
    const start = baseIdx >= 0 ? baseIdx + 1 : 0
    let next = null
    for (let k = 0; k < ord.length; k++) {
      const m = ord[(start + k) % ord.length]
      if (m && !triedModels.has(m) && conf.indexOf(m) >= 0) {
        // freeOnly 模式下，只选择带 "free" 字样的模型
        if (freeOnly && m.toLowerCase().indexOf('free') < 0) continue
        next = m
        break
      }
    }
    
    // 如果 freeOnly 模式开启但没有找到 free 模型，停止切换
    if (freeOnly && !next) {
      if (switchBudgetNotified) return false
      switchBudgetNotified = true
      sendRef('⚠ no free models available after ' + switchesUsed + ' switches — run stopped', 'info')
      return false
    }
    
    if (!next) return false
    switchLeft--  // consume one auto-switch attempt
    retryLeft = MAX_RETRY  // fresh budget for the new model
    activeModel = next
    send('model', { model: next, removed: reason === 'removed' })  // keep frontend model selector in sync
    const shortErr = (etxt || '').split('\n')[0].slice(0, 120) || reason
    const why = reason === 'removed' ? (gone + ' removed') : (gone + ' ' + shortErr)
    const freeTag = freeOnly ? ' [free]' : ''
    sendRef('↻ ' + why + ' · switching to ' + next + ' (' + (MAX_SWITCH - switchLeft) + '/' + MAX_SWITCH + ')' + freeTag, 'info')
    retrying = true
    kickWatchdog()
    setTimeout(() => { relaunch() }, 800)
    return true
  }
  const isRetryable = (etxt) => {
    if (!etxt) return false
    return /410|429|422|1302|503|limit_burst_rate|rate.?limit|速率限制|请求频率|并发|concurrency|5\d\d|admission_busy|chat_admission|server_error|service_temporarily_unavailable|ResourceExhausted|temporarily|繁忙|timed.?out|timeout|请求超时/i.test(etxt)
  }
  // connection-level / 5xx "hard" failures: retryable once, but a repeat for the same model means it's broken
  const isHardFail = (etxt) => {
    if (!etxt) return false
    return /(?:^|\D)(?:5\d\d)\b|fetch failed|socket hang|econn|getaddrinfo|network error|netserver|connection (?:refused|reset|closed)|http_50x|initiating request/i.test(etxt)
  }
  // transient (overload / connection blip / auth denied): skip same-model retry, switch directly — but don't mark bad
  const switchOnly = (etxt) => {
    if (!etxt) return false
    return /\b(401|402|403)\b|overload|capacity|connection|unauthorized|forbidden|invalid.api.key|permission.denied|权限|未授权|鉴权|过载|连接/i.test(etxt)
  }
  const retryDelayMs = (attemptLeft) => {
    const tried = MAX_RETRY - attemptLeft
    return [5000, 10000, 30000][tried - 1] || 30000
  }
  let lastErrKey = ''      // dedupe identical (model, error) fired by different event types
  let lastErrAt2 = 0
  // single decision point for every model error (message_end, error/session_error events, exit path).
  // Guarantees retry -> switch -> fail ordering and never bails out while a relaunch is pending.
  const handleModelError = (etxt) => {
    if (!etxt) return
    lastErrText = etxt
    lastErrAt = Date.now()
    const errLine = String(etxt).split('\n')[0].slice(0, 200)
    const mk = model || modelStr || defModel || ''
    const key = (mk + '|' + etxt).slice(0, 400)
    if (key === lastErrKey && Date.now() - lastErrAt2 < 4000) return
    lastErrKey = key
    lastErrAt2 = Date.now()
    let removed = false
    if (mk && /\b(400|404|410|502)\b/.test(etxt)) {
      const newly = markBadModels([mk])
      sendRef('⚠ ' + mk + ' unavailable · ' + (newly ? 'removed from list' : 'already removed') + ' · ' + errLine, 'info')
      send('model_removed', { model: mk })  // drop from frontend list even if no further switch happens
      removed = true
    } else if (mk && isHardFail(etxt)) {
      hardFails[mk] = (hardFails[mk] || 0) + 1
      if (hardFails[mk] >= 2) {
        const newly = markBadModels([mk])
        sendRef('⚠ ' + mk + ' repeatedly failing (' + hardFails[mk] + 'x 5xx/network) · ' + (newly ? 'removed from list' : 'already removed') + ' · ' + errLine, 'info')
        send('model_removed', { model: mk })
        removed = true
      }
    }
    if (removed) {
      // model is gone for good — switch to the next available model instead of retrying the same one
      if (!switchToNextModel(etxt, 'removed')) fail(errLine)
      return
    }
    if (switchOnly(etxt)) {
      // transient overload / connection blip — switch directly, no same-model retry, don't mark bad
      if (!switchToNextModel(etxt, 'switch')) {
        if (!retrying) fail(errLine)   // a relaunch is already pending — wait for it instead of dying
      }
      return
    }
    if (isRetryable(etxt)) {
      if (retryLeft > 0 && switchLeft > 0) {
        if (retrying) return           // retry relaunch already scheduled — don't stack another
        retryLeft--
        const attempt = MAX_RETRY - retryLeft
        const delay = retryDelayMs(retryLeft)
        sendRef('↻ transient error, retrying in ' + Math.round(delay / 1000) + 's… (attempt ' + attempt + '/' + MAX_RETRY + ')' + (etxt && etxt !== 'transient error' ? ' · ' + errLine : ''), 'info')
        retrying = true
        kickWatchdog()
        setTimeout(() => { relaunch() }, delay)
        return
      }
      // same-model retries exhausted — fall back to switching models
      if (!switchToNextModel(etxt, 'retry')) {
        if (!retrying) fail(errLine)
      }
      return
    }
    if (!retrying) fail(errLine)
  }
  // unified end-of-run: recover (switch model) when the run died with error signs but produced no output
  const endRun = (code, via) => {
    if (streamEnded || retrying || pronBreaking) return
    const errHint = autoRetryCount > 0 || !!lastErrText || /error|fail|unavailable|overload|refused|timeout|econn|exceed/i.test(stderrTail)
    if (!errHint) {
      if (code !== 0) fail('pi exited with code ' + code)
      else finish({ content: '', model: model, tokens: tokens })
      return
    }
    // pi recovered mid-run after a transient hiccup — treat as normal completion
    if (runHadOutput && code === 0 && via === 'event') {
      finish({ content: '', model: model, tokens: tokens })
      return
    }
    const line = ((lastErrText || stderrTail || '').trim().split('\n')[0] || '').slice(0, 200)
    const etxt = line || ('pi exited with code ' + code)
    handleModelError(etxt)
  }

  const qArg = (val) => {
    let s = String(val)
    if (!IS_WIN || /^[\w@%+=:,./\-]+$/.test(s)) return s
    return '"' + s.replace(/(\\*)"/g, '$1$1\\"').replace(/(\\+)$/, '$1$1') + '"'
  }

  const spawnProcess = () => {
    // prompt 不放命令行（shell 会按空格/换行拆参），改走 stdin
    const args = ['--mode', 'json', '--approve', '--print']
    if (curSession) args.push('--session-id', curSession)
    else args.push('--name', prompt.replace(/\s+/g, ' ').trim().slice(0, 40))
    if (activeModel) args.push('--model', activeModel)
    else {
      const fallback = collectConfiguredModels(readModelsJson())
      if (fallback.length) args.push('--model', fallback[0])
    }

    const env = Object.assign({}, process.env, {
      NODE_OPTIONS: '--no-warnings',
      PI_SKIP_VERSION_CHECK: '1',
      NO_COLOR: '1'
    })
    killTree(proc)
    proc = spawn(PI_BIN, args.map(qArg), { cwd: cwd, env: env, windowsHide: true, shell: IS_WIN, detached: !IS_WIN, stdio: ['pipe', 'pipe', 'pipe'] })
    try {
      proc.stdin.on('error', () => {})
      proc.stdin.write(prompt)
      proc.stdin.end()
    } catch(e) {}
    runProcs[runId] = proc
    // favend 每次请求都会重新执行整个脚本，runProcs 会变成空对象。
    // 把 proc 存进跨请求共享的 $cache，stop 时才能找到并杀掉进程。
    try { $cache.set('pi_run_' + runId, proc) } catch(e) {}
    retrying = false

    let buf = ''
    proc.stdout.setEncoding('utf8')
    proc.stdout.on('data', (chunk) => {
      buf += chunk
      let nl
      while ((nl = buf.indexOf('\n')) >= 0) {
        const line = buf.slice(0, nl)
        buf = buf.slice(nl + 1)
        if (!line.trim()) continue
        let ev
        try { ev = JSON.parse(line.trim()) } catch(e) { continue }
        try { onEvent(ev) } catch(e) {}
      }
    })
    proc.stderr.on('data', (chunk) => {
      const t2 = stripAnsi(chunk.toString()).replace(/\s+/g, ' ').trim()
      if (!t2 || t2.indexOf('Warning:') >= 0) return
      console.log('[pi run]', t2)
      stderrTail = (stderrTail ? stderrTail + ' ' : '') + t2
      if (stderrTail.length > 400) stderrTail = stderrTail.slice(-400)
    })

    proc.on('error', (e) => { fail(e.message || String(e)) })
    proc.on('close', (code) => {
      try { delete runProcs[runId] } catch(e) {} try { $cache.delete('pi_run_' + runId) } catch(e) {}
      endRun(code, 'close')
    })

    kickWatchdog()
    aliveTimer = setInterval(() => {
      try {
        if (typeof $ws.sseExists !== 'function' || $ws.sseExists(APP_CH)) return
        clearInterval(aliveTimer)
        aliveTimer = null
        killTree(proc)
        fail('client disconnected')
      } catch(e) {}
    }, 15000)
    toolHeartbeat = setInterval(() => {
      if (streamEnded) { clearInterval(toolHeartbeat); return }
      const now = Date.now()
      for (const id in runningTools) {
        const rt = runningTools[id]
        // hard per-tool timeout: if a single tool call exceeds MAX_TOOL_MS, it's wedged
        // (e.g. a daemon-spawning command that never closes its output pipe). Recover instead
        // of hanging forever: notify, drop the entry, and relaunch a fresh pi process.
        if (!rt.wedged && now - rt.started > MAX_TOOL_MS) {
          rt.wedged = true
          const sig = String(rt.arg || '').slice(0, 200)
          const secs = Math.floor((now - rt.started) / 1000)
          if (wedgedTools.has(sig)) {
            // same command already timed out once this run — likely poisoned (leaks a daemon).
            // stop instead of looping: fail the run.
            sendRef('✗ tool "' + rt.tool + '" timed out again (' + secs + 's) — appears unkillable (background process), stopping', 'tool')
            fail('Tool "' + rt.tool + '" timed out twice and may leave a background process running')
            return
          }
          wedgedTools.add(sig)
          sendRef('✗ tool "' + rt.tool + '" timed out (' + secs + 's) — killing pi and resuming so the chat isn\'t stuck', 'tool')
          delete runningTools[id]
          relaunch()
          return
        }
        if (now - rt.lastUpdate > 10000) {
          sendRef('◈ ' + rt.tool + ' running (' + Math.floor((now - rt.started) / 1000) + 's)', 'tool')
          send('running', { tool: rt.tool, callId: id })
          rt.lastUpdate = now
        }
        if (rt.lastOutput) emitOut(id, maskSecrets(rt.lastOutput), (d) => { send('out', { content: d }) })
      }
    }, 15000)
    return proc
  }

  let pronBreaking = false
  const relaunch = () => {
    if (streamEnded) return
    pronBreaking = true
    killTree(proc)
    try { delete runProcs[runId] } catch(e) {} try { $cache.delete('pi_run_' + runId) } catch(e) {}
    if (aliveTimer) { clearInterval(aliveTimer); aliveTimer = null }
    if (toolHeartbeat) { clearInterval(toolHeartbeat); toolHeartbeat = null }
    setTimeout(() => {
      pronBreaking = false
      if (streamEnded) return
      retrying = false
      lastErrKey = ''   // a new attempt is a fresh event, never deduped against the previous one
      spawnProcess()
    }, 500)
  }

  spawnProcess()

  return { ok: true, runId: runId, cwd: cwd }
})

$fend('stop', async (data) => {
  if (!data) return { ok: false }
  const rp = runProcs[data.runId] || $cache.get('pi_run_' + data.runId) || $cache.get('pi_compact_' + data.runId)
  if (rp) {
    killTree(rp)
    try { delete runProcs[data.runId] } catch(e) {}
    try { $cache.delete('pi_run_' + data.runId) } catch(e) {}
    try { $cache.delete('pi_compact_' + data.runId) } catch(e) {}
    return { ok: true, mode: 'run' }
  }
  return { ok: false, error: 'no active run' }
})

// Manually compact an existing session's context via pi's RPC mode.
// Spawns a short-lived pi process that loads the session and runs compact(),
// then returns immediately so the frontend polls session_ctx for token changes.
$fend('compact', (data) => {
  if (!data || !data.session) return { ok: false, error: 'session is required' }
  const runId = data.runId || 'compact-' + Date.now()
  const cwd = getWorkDir()
  const sessionId = String(data.session)
  const modelStr = (data.model || '').replace(/\r/g, '')

  const send = (type, payload) => {
    $ws.sse(APP_CH, JSON.stringify(Object.assign({ runId: runId }, payload || {}, { type: type })))
  }

  // RPC mode: read JSON commands from stdin, write events/responses as JSON lines to stdout
  const args = ['--mode', 'rpc', '--approve', '--session-id', sessionId]
  if (modelStr) args.push('--model', modelStr)
  else {
    const fallback = collectConfiguredModels(readModelsJson())
    if (fallback.length) args.push('--model', fallback[0])
  }

  const env = Object.assign({}, process.env, { NODE_OPTIONS: '--no-warnings', PI_SKIP_VERSION_CHECK: '1', NO_COLOR: '1' })

  return new Promise((resolve) => {
    let proc = null
    let buf = ''
    let resolved = false
    const REQ_ID = 'req_' + runId

    const finish = (result) => {
      if (resolved) return
      resolved = true
      if (proc) killTree(proc)
      try { delete runProcs[runId] } catch(e) {}
      try { $cache.delete('pi_compact_' + runId) } catch(e) {}
      resolve(result)
    }
    const kickWatchdog = () => {
      if (watchdog) clearTimeout(watchdog)
      watchdog = setTimeout(() => {
        send('error', { message: 'compact timeout (180s)' })
        finish({ ok: false, error: 'timeout' })
      }, 180000)
    }
    let watchdog = null
    let compactResult = null
    kickWatchdog()
    try {
      proc = spawn(PI_BIN, args, { cwd: cwd, env: env, windowsHide: true, shell: IS_WIN, detached: !IS_WIN, stdio: ['pipe', 'pipe', 'pipe'] })
    } catch(e) {
      send('error', { message: 'spawn failed: ' + e.message })
      return finish({ ok: false, error: 'spawn failed: ' + e.message })
    }
    runProcs[runId] = proc
    try { $cache.set('pi_compact_' + runId, proc) } catch(e) {}
    proc.stdin.on('error', () => {})
    proc.stdout.setEncoding('utf8')
    proc.stdout.on('data', (chunk) => {
      buf += chunk
      let nl
      while ((nl = buf.indexOf('\n')) >= 0) {
        const line = buf.slice(0, nl)
        buf = buf.slice(nl + 1)
        if (!line.trim()) continue
        let ev
        try { ev = JSON.parse(line.trim()) } catch(e) { continue }
        if (ev.type === 'response' && ev.id === REQ_ID) {
          if (ev.success) {
            send('compact_done', { ok: true, result: compactResult })
            finish({ ok: true, result: compactResult })
          } else {
            const msg = ev.error || 'compact failed'
            send('error', { message: msg })
            finish({ ok: false, error: msg })
          }
          return
        }
        if (ev.type === 'session' && ev.id) {
          send('session', { id: ev.id })
        } else if (ev.type === 'compaction_start') {
          send('compaction_start', {})
        } else if (ev.type === 'compaction_end') {
          const r = ev.result || {}
          compactResult = r
          send('compaction_end', { ok: true, result: r })
        }
        kickWatchdog()
      }
    })
    proc.stderr.setEncoding('utf8')
    proc.stderr.on('data', (chunk) => {
      const t = stripAnsi(chunk.toString()).trim()
      if (t && t.indexOf('Warning:') < 0) {
        console.log('[pi compact]', t)
        send('compact_log', { message: t.slice(0, 200) })
      }
    })
    proc.on('error', (e) => {
      send('error', { message: 'process error: ' + e.message })
      finish({ ok: false, error: 'process error: ' + e.message })
    })
    proc.on('close', (code) => {
      if (!resolved) {
        if (code === 0) {
          send('compact_done', { ok: true })
          finish({ ok: true })
        } else {
          send('error', { message: 'pi exited with code ' + code })
          finish({ ok: false, error: 'pi exited with code ' + code })
        }
      }
    })
    setTimeout(() => {
      try { proc.stdin.write(JSON.stringify({ type: 'compact', id: REQ_ID }) + '\n') } catch(e) {}
    }, 300)
  })
})

const resolveOmniVersion = (tries) => {
  return new Promise((resolve) => {
    const attempt = (n) => {
      execAsync(redirCmd('omniroute --version'), 5000).then((v) => {
        resolve({ ok: true, version: v.stdout.trim() || 'unknown' })
      }).catch((e) => {
        if (n > 1) setTimeout(() => { attempt(n - 1) }, 1000)
        else resolve({ ok: false })
      })
    }
    attempt(tries || 2)
  })
}

const waitForOmniReady = (timeout) => {
  return new Promise((resolve) => {
    const start = Date.now()
    const check = () => {
      httpGetUrl(OMNI_HOST + '/', 2000).then((r) => {
        if (r.status === 200) resolve(true)
        else if (Date.now() - start > timeout) resolve(false)
        else setTimeout(check, 2000)
      }).catch(() => {
        if (Date.now() - start > timeout) resolve(false)
        else setTimeout(check, 2000)
      })
    }
    check()
  })
}

const startOmniProcess = () => {
  const omniEnv = Object.assign({}, process.env)
  delete omniEnv.PORT
  const proc = spawn('omniroute', [], {
    detached: true,
    stdio: 'ignore',
    windowsHide: true,
    shell: IS_WIN,
    env: omniEnv
  })
  proc.on('error', (e) => { console.log('[ensure_omniroute] spawn error:', e.message) })
  proc.unref()
  return proc
}

const resolvePiVersion = (tries) => {
  return new Promise((resolve) => {
    const attempt = (n) => {
      execAsync(redirCmd(PI_BIN + ' --version'), 20000).then((v) => {
        resolve({ ok: true, version: v.stdout.trim() || 'unknown' })
      }).catch((e) => {
        if (n > 1) setTimeout(() => { attempt(n - 1) }, 1000)
        else resolve({ ok: false, error: e })
      })
    }
    attempt(tries || 2)
  })
}

$fend('ensure_pi', async (data) => {
  const runId = data && data.installId
  // pi CLI 冷启动 ~2.7s（4600+ 松散文件模块图加载），缓存版本号避免每次打开页面都跑
  let r = null
  try {
    const vcached = $store.get('pi_version_cache')
    const vtime = Number($store.get('pi_version_time') || 0)
    if (vcached && vtime && Date.now() - vtime < 6 * 3600 * 1000) r = { ok: true, version: vcached }
  } catch(e) {}
  if (!r) {
    r = await resolvePiVersion(1)
    if (r.ok) {
      try {
        $store.set('pi_version_cache', r.version)
        $store.set('pi_version_time', String(Date.now()))
      } catch(e) {}
    }
  }
  if (r.ok) {
    const version = r.version
    console.log('[ensure_pi] version:', version)
    const omni = await httpGetUrl(OMNI_HOST + '/', 4000)
    if (runId) $ws.sse(runId, JSON.stringify({ type: 'done', version: version, omni: omni.status === 200 }))
    return { ok: true, installing: false, version: version, omni: omni.status === 200 }
  }
  if (!runId) return { error: 'no installId' }
  try {
    const freeMem = require('os').freemem()
    const freeMB = Math.round(freeMem / 1024 / 1024)
    if (freeMem < 1024 * 1024 * 1024) {
      const msg = '当前可用内存 ' + freeMB + 'M，内存过小，pi 可能无法使用'
      console.log('[ensure_pi] memory too low:', freeMB + 'M')
      $ws.sse(runId, JSON.stringify({ type: 'error', content: msg }))
      return { ok: false, error: msg }
    }
    const INSTALL_CMD = 'npm install -g @earendil-works/pi-coding-agent@latest --loglevel=verbose'
    $ws.sse(runId, JSON.stringify({ type: 'cmd', content: INSTALL_CMD }))
    const proc = spawn(IS_WIN ? process.env.COMSPEC : 'sh',
      IS_WIN ? ['/d', '/s', '/c', INSTALL_CMD + ' 2>&1'] : ['-c', INSTALL_CMD + ' 2>&1'],
      { timeout: 180000, windowsHide: true, stdio: ['ignore', 'pipe', 'pipe'] })
    const fullLog = []
    const sendProgress = (text) => {
      const lines = stripAnsi(text.toString()).split('\n').filter(Boolean)
      for (const l of lines) {
        const line = l.trim()
        console.log('[npm install]', line)
        if (line) {
          fullLog.push(line)
          if (fullLog.length > 2000) fullLog.splice(0, fullLog.length - 2000)
          $ws.sse(runId, JSON.stringify({ type: 'progress', content: line }))
        }
      }
    }
    proc.stdout.on('data', sendProgress)
    proc.stderr.on('data', sendProgress)
    proc.on('close', async (code) => {
      try {
        if (code === 0) {
          const vr = await resolvePiVersion(3)
          const version = vr.ok ? vr.version : 'unknown'
          if (vr.ok) {
            try {
              $store.set('pi_version_cache', version)
              $store.set('pi_version_time', String(Date.now()))
            } catch(e) {}
          }
          const omni = await httpGetUrl(OMNI_HOST + '/', 4000)
          console.log('[npm install] done, version:', version, 'omni:', omni.status)
          if (!vr.ok) console.log('[npm install] version check failed:', vr.error && vr.error.message)
          $ws.sse(runId, JSON.stringify({ type: 'full_log', content: fullLog.join('\n') }))
          $ws.sse(runId, JSON.stringify({ type: 'done', version: version, omni: omni.status === 200 }))
        } else {
          $ws.sse(runId, JSON.stringify({ type: 'full_log', content: fullLog.join('\n') }))
          $ws.sse(runId, JSON.stringify({ type: 'error', content: 'npm install failed (code ' + code + ')' }))
        }
      } catch(e) {
        $ws.sse(runId, JSON.stringify({ type: 'full_log', content: fullLog.join('\n') }))
        $ws.sse(runId, JSON.stringify({ type: 'error', content: e.message }))
      }
    })
    proc.on('error', (e) => {
      $ws.sse(runId, JSON.stringify({ type: 'full_log', content: fullLog.join('\n') }))
      $ws.sse(runId, JSON.stringify({ type: 'error', content: e.message }))
    })
    return { ok: true, installing: true }
  } catch(e) {
    $ws.sse(runId, JSON.stringify({ type: 'error', content: e.message }))
    return { ok: true, installing: true }
  }
})

$fend('ensure_omniroute', async (data) => {
  const runId = data && data.installId
  const omniCheck = await httpGetUrl(OMNI_HOST + '/', 4000)
  if (omniCheck.status === 200) {
    console.log('[ensure_omniroute] already running')
    if (runId) $ws.sse(runId, JSON.stringify({ type: 'done', status: 'running' }))
    return { ok: true, running: true }
  }
  const installed = await resolveOmniVersion(2)
  if (!installed.ok) {
    if (!runId) return { ok: false, error: 'omniroute not installed and no installId' }
    try {
      const INSTALL_CMD = 'npm install -g omniroute --loglevel=verbose'
      $ws.sse(runId, JSON.stringify({ type: 'cmd', content: INSTALL_CMD }))
      const proc = spawn(IS_WIN ? process.env.COMSPEC : 'sh',
        IS_WIN ? ['/d', '/s', '/c', INSTALL_CMD + ' 2>&1'] : ['-c', INSTALL_CMD + ' 2>&1'],
        { timeout: 180000, windowsHide: true, stdio: ['ignore', 'pipe', 'pipe'] })
      const fullLog = []
      const sendProgress = (text) => {
        const lines = stripAnsi(text.toString()).split('\n').filter(Boolean)
        for (const l of lines) {
          const line = l.trim()
          console.log('[omniroute install]', line)
          if (line) {
            fullLog.push(line)
            if (fullLog.length > 2000) fullLog.splice(0, fullLog.length - 2000)
            $ws.sse(runId, JSON.stringify({ type: 'progress', content: line }))
          }
        }
      }
      proc.stdout.on('data', sendProgress)
      proc.stderr.on('data', sendProgress)
      proc.on('close', async (code) => {
        try {
          if (code === 0) {
            $ws.sse(runId, JSON.stringify({ type: 'progress', content: 'OmniRoute installed, starting...' }))
            startOmniProcess()
            const ready = await waitForOmniReady(30000)
            $ws.sse(runId, JSON.stringify({ type: 'full_log', content: fullLog.join('\n') }))
            if (ready) {
              console.log('[ensure_omniroute] installed and started')
              $ws.sse(runId, JSON.stringify({ type: 'done', status: 'started' }))
            } else {
              $ws.sse(runId, JSON.stringify({ type: 'error', content: 'OmniRoute started but not responding on ' + OMNI_HOST }))
            }
          } else {
            $ws.sse(runId, JSON.stringify({ type: 'full_log', content: fullLog.join('\n') }))
            $ws.sse(runId, JSON.stringify({ type: 'error', content: 'npm install failed (code ' + code + ')' }))
          }
        } catch(e) {
          $ws.sse(runId, JSON.stringify({ type: 'full_log', content: fullLog.join('\n') }))
          $ws.sse(runId, JSON.stringify({ type: 'error', content: e.message }))
        }
      })
      proc.on('error', (e) => {
        $ws.sse(runId, JSON.stringify({ type: 'full_log', content: fullLog.join('\n') }))
        $ws.sse(runId, JSON.stringify({ type: 'error', content: e.message }))
      })
      return { ok: true, installing: true }
    } catch(e) {
      $ws.sse(runId, JSON.stringify({ type: 'error', content: e.message }))
      return { ok: false, error: e.message }
    }
  }
  if (!runId) return { ok: false, error: 'omniroute not running and no installId' }
  $ws.sse(runId, JSON.stringify({ type: 'cmd', content: 'omniroute' }))
  $ws.sse(runId, JSON.stringify({ type: 'progress', content: 'Starting OmniRoute...' }))
  startOmniProcess()
  const ready = await waitForOmniReady(30000)
  if (ready) {
    console.log('[ensure_omniroute] started')
    $ws.sse(runId, JSON.stringify({ type: 'done', status: 'started' }))
    return { ok: true, running: true }
  } else {
    $ws.sse(runId, JSON.stringify({ type: 'error', content: 'OmniRoute started but not responding on ' + OMNI_HOST }))
    return { ok: false, error: 'OmniRoute not responding' }
  }
})

$fend('sessions', () => {
  try {
    const raw = $store.get('aichat_sessions') || '[]'
    const local = JSON.parse(raw)
    const raw2 = $store.get('aichat_pinned_sessions') || '[]'
    const pinned = JSON.parse(raw2)
    return { sessions: local, pinned: pinned }
  } catch(e) {
    return { sessions: [], pinned: [] }
  }
})

$fend('delete_session', (data) => {
  if (!data || !data.id) return { ok: false }
  try {
    const raw = $store.get('aichat_sessions') || '[]'
    let list = JSON.parse(raw)
    list = list.filter((s) => { return s.id !== data.id })
    $store.set('aichat_sessions', JSON.stringify(list))
    return { ok: true }
  } catch(e) {
    return { ok: false, error: e.message }
  }
})
</script>
</body>
</html>
